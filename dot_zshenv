# ~/.zshenv - read by every zsh (also non-interactive). Keep it small.
typeset -U path                      # no duplicate entries
path=("$HOME/.local/bin" $path)      # personal scripts (rofi menus, dots-check, ...)
export PATH
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"
# .NET (C# in Neovim): no telemetry, no first-run banner; dotnet tools
# (csharp-ls) live in ~/.dotnet/tools
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export DOTNET_NOLOGO=1
path+=("$HOME/.dotnet/tools")
