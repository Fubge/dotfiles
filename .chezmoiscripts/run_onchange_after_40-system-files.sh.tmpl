#!/usr/bin/env bash
# Install root-owned files into / (copied, not symlinked):
#   system/       every machine (SDDM theme, power profile switching, iwd Wi-Fi backend,
#                 sysctl + journald tuning)
#   system-boot/  only with machine.boot = true (GRUB, kernel cmdline, console)
# *.tmpl files are rendered with the chezmoi data first.
# Re-runs when any of them (or their rendered output) changes:
{{- $dirs := list "system" }}
{{- if .machine.boot }}{{ $dirs = append $dirs "system-boot" }}{{ end }}
{{ range $dirs }}
{{- range (glob (joinPath $.chezmoi.sourceDir . "**/*")) }}
{{- if not (stat .).isDir }}
# {{ . | trimPrefix $.chezmoi.sourceDir }}: {{ if hasSuffix ".tmpl" . }}{{ includeTemplate . $ | sha256sum }}{{ else }}{{ include . | sha256sum }}{{ end }}
{{- end }}
{{- end }}
{{- end }}
set -euo pipefail
cd "{{ .chezmoi.sourceDir }}"
dirs=({{ range $dirs }}{{ . }} {{ end }})

# Console font and kernel command line are baked into the UKI: rebuild it when they change
rebuild_uki=false
network_changed=false
reload_sysctl=false
restart_journald=false
installed=()

for d in "${dirs[@]}"; do
    while read -r f; do
        rel=${f#"$d"/}
        dest="/${rel%.tmpl}"
        tmp=$(mktemp)
        if [[ $f == *.tmpl ]]; then
            chezmoi execute-template <"$f" >"$tmp"
        else
            cp "$f" "$tmp"
        fi
        if [[ $dest == /etc/vconsole.conf || $dest == /etc/kernel/cmdline ]] && ! cmp -s "$tmp" "$dest"; then
            rebuild_uki=true
        fi
        if [[ $dest == /etc/NetworkManager/* || $dest == /etc/iwd/* ]] && ! cmp -s "$tmp" "$dest"; then
            network_changed=true
        fi
        if [[ $dest == /etc/sysctl.d/* ]] && ! cmp -s "$tmp" "$dest"; then
            reload_sysctl=true
        fi
        if [[ $dest == /etc/systemd/journald.conf.d/* ]] && ! cmp -s "$tmp" "$dest"; then
            restart_journald=true
        fi
        mode=0644
        [[ $dest == */bin/* || $dest == /etc/grub.d/* ]] && mode=0755
        sudo install -D -m "$mode" -o root -g root "$tmp" "$dest"
        rm -f "$tmp"
        installed+=("$dest")
    done < <(find "$d" -type f)
done
echo "system: installed ${#installed[@]} files: ${installed[*]}"

if $rebuild_uki; then
    echo "system: console font or kernel cmdline changed, rebuilding UKI"
    sudo mkinitcpio -P
fi

if $reload_sysctl; then
    sudo sysctl --system >/dev/null
fi
if $restart_journald; then
    sudo systemctl restart systemd-journald.service
fi

sudo udevadm control --reload
sudo systemctl daemon-reload
sudo systemctl enable --now power-profile-auto.service

# Wi-Fi backend: iwd instead of wpa_supplicant (system/etc/NetworkManager/conf.d/wifi-backend.conf)
sudo systemctl disable --now wpa_supplicant.service 2>/dev/null || true
sudo systemctl enable --now iwd.service
# Nothing here needs the network before login; waiting for it only delays boot
sudo systemctl disable NetworkManager-wait-online.service 2>/dev/null || true
# Never restart the network from here: it cuts every running session (SSH,
# Claude, downloads) and Wi-Fi does not always come back. Takes effect at reboot.
if $network_changed; then
    echo "system: Wi-Fi config changed, active after the next reboot"
fi
