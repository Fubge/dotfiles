#!/usr/bin/env bash
# Installs all packages listed in packages/*.txt (official repos only).
# Which lists are used depends on `chezmoi init` (see .chezmoi.toml.tmpl):
{{- $lists := list "base" "hardware" "desktop" "shell" "dev" }}
{{- if .machine.apps }}{{ $lists = append $lists "apps" }}{{ end }}
{{- if .machine.gaming }}{{ $lists = append $lists "gaming" }}{{ end }}
{{- $lists = append $lists (printf "machine/cpu-%s" .machine.cpu) }}
{{- $lists = append $lists (printf "machine/gpu-%s" .machine.gpu) }}
# chezmoi re-runs this script whenever one of them changes:
{{ range $lists -}}
# {{ . }}: {{ include (printf "packages/%s.txt" .) | sha256sum }}
{{ end -}}
set -euo pipefail

src="{{ .chezmoi.sourceDir }}/packages"
lists=({{ range $lists }}"$src/{{ . }}.txt" {{ end }})
mapfile -t pkgs < <(sed 's/#.*//; s/[[:space:]]//g; /^$/d' "${lists[@]}" | sort -u)

missing=()
for p in "${pkgs[@]}"; do
    pacman -Qq "$p" &>/dev/null || missing+=("$p")
done

if ((${#missing[@]} == 0)); then
    echo "packages: all ${#pkgs[@]} packages installed"
    exit 0
fi

echo "packages: installing ${#missing[@]} missing package(s): ${missing[*]}"
flags=(--needed)
[[ -t 0 ]] || flags+=(--noconfirm)   # non-interactive run (no terminal)
sudo pacman -S "${flags[@]}" "${missing[@]}"
