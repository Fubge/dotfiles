#!/usr/bin/env bash
# Push changes into the running session:
# - Resident popups (~/.local/lib/popup/resident.py) keep their old code until
#   restarted: stop them and start them hidden again.
# - The notification daemon (~/.local/bin/notifications) restarts the same way.
# - A change in a module that hyprland.lua requires (vars.lua, rules.lua...) did
#   not always reach the running Hyprland (new popup class stayed open): reload.
# {{ include "dot_local/lib/popup/resident.py" | sha256sum }}
# {{ include "dot_local/bin/executable_list-menu-popup" | sha256sum }}
# {{ include "dot_local/bin/executable_sound-popup" | sha256sum }}
# {{ include "dot_local/bin/executable_bluetooth-popup" | sha256sum }}
# {{ include "dot_local/bin/executable_wifi-popup" | sha256sum }}
# {{ include "dot_local/bin/executable_power-popup" | sha256sum }}
# {{ include "dot_local/bin/executable_session-popup.tmpl" | sha256sum }}
# {{ include "dot_local/bin/executable_brightness-popup" | sha256sum }}
# {{ include "dot_local/bin/executable_pet-picker" | sha256sum }}
# {{ include "dot_local/bin/executable_keybinds" | sha256sum }}
# {{ include "dot_local/bin/executable_clipboard-popup" | sha256sum }}
# {{ include "dot_config/popups/style.css.tmpl" | sha256sum }}
# {{ include "dot_local/bin/executable_notifications" | sha256sum }}
# {{ include "dot_local/bin/executable_notification-center" | sha256sum }}
# {{ include "dot_local/lib/popup/notif.py" | sha256sum }}
# {{ include "dot_local/bin/executable_osd-pill" | sha256sum }}
# {{ include "dot_local/bin/executable_task-popup" | sha256sum }}
# {{ include "dot_local/bin/executable_calendar-popup" | sha256sum }}
# {{ include "dot_local/bin/executable_event-popup" | sha256sum }}
# {{ include "dot_local/bin/executable_timer-popup" | sha256sum }}
# {{ include "dot_local/lib/popup/timers.py" | sha256sum }}
# {{ include "dot_local/bin/executable_calendar-remind" | sha256sum }}
# {{ include "dot_local/lib/popup/cal.py" | sha256sum }}
# {{ include "dot_local/bin/executable_system-menu" | sha256sum }}
# {{ include "dot_local/lib/popup/settings.py" | sha256sum }}
# {{ include "dot_local/lib/popup/nightlight.py" | sha256sum }}
# {{ include "dot_local/bin/executable_nightlight" | sha256sum }}
# {{ include "dot_local/bin/executable_idle-config" | sha256sum }}
# texts: {{ include ".chezmoidata/locale.toml" | sha256sum }} {{ dig "machine" "lang" "en" . }}
# {{ include "dot_local/lib/popup/i18n.py" | sha256sum }}
{{ range (glob (joinPath .chezmoi.sourceDir "dot_config/hypr/*.lua*")) -}}
# {{ include . | sha256sum }}
{{ end -}}
set -uo pipefail
[[ -n ${HYPRLAND_INSTANCE_SIGNATURE-} ]] || exit 0    # not in a session (bootstrap)

popups=(list-menu-popup sound-popup bluetooth-popup wifi-popup power-popup session-popup brightness-popup pet-picker keybinds clipboard-popup notification-center task-popup calendar-popup event-popup timer-popup system-menu)
for p in "${popups[@]}"; do
    "$HOME/.local/bin/$p" quit
done
sleep 0.3
for p in "${popups[@]}"; do
    setsid -f "$HOME/.local/bin/$p" --hidden >/dev/null 2>&1
done

# Notification daemon: a new one takes over the bus name from the old one.
# dunst (until it is uninstalled) does not let go of it: stop it first
systemctl --user stop dunst.service 2>/dev/null
setsid -f "$HOME/.local/bin/notifications" >/dev/null 2>&1

# Volume / brightness pill: a new one replaces the old
setsid -f "$HOME/.local/bin/osd-pill" >/dev/null 2>&1

# Calendar reminders: one instance, restarted with the new code
pkill -f "^python3 $HOME/.local/bin/calendar-remind" 2>/dev/null
setsid -f "$HOME/.local/bin/calendar-remind" >/dev/null 2>&1

# Night light and idle watcher: one instance each, restarted with the new code
for d in nightlight idle-config; do
    pkill -f "^python3 $HOME/.local/bin/$d watch" 2>/dev/null
    setsid -f "$HOME/.local/bin/$d" watch >/dev/null 2>&1
done

hyprctl reload >/dev/null
