#!/usr/bin/env bash
# Install files from system/ into / (root-owned, not symlinked).
# Re-runs when any of them changes:
{{ range (glob (joinPath .chezmoi.sourceDir "system/**/*")) -}}
{{ if not (stat .).isDir -}}
# {{ . | trimPrefix $.chezmoi.sourceDir }}: {{ include . | sha256sum }}
{{ end -}}
{{ end -}}
set -euo pipefail
src="{{ .chezmoi.sourceDir }}/system"

cd "$src"
# Console font and kernel command line are baked into the UKI: rebuild it when they change
rebuild_uki=false
for f in etc/vconsole.conf etc/kernel/cmdline; do
    cmp -s "$f" "/$f" || rebuild_uki=true
done

find . -type f | while read -r f; do
    dest="/${f#./}"
    mode=0644
    [[ $dest == */bin/* || $dest == /etc/grub.d/* ]] && mode=0755
    sudo install -D -m "$mode" -o root -g root "$f" "$dest"
    echo "system: installed $dest"
done

if $rebuild_uki; then
    echo "system: console font or kernel cmdline changed, rebuilding UKI"
    sudo mkinitcpio -P
fi

sudo udevadm control --reload
sudo systemctl daemon-reload
sudo systemctl enable --now power-profile-auto.service
