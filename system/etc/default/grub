# GRUB settings. The kernel command line is NOT set here: GRUB chainloads the
# UKI, which embeds /etc/kernel/cmdline.
GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_TIMEOUT_STYLE=menu
GRUB_DISTRIBUTOR="Arch"
GRUB_PRELOAD_MODULES="part_gpt part_msdos"
GRUB_TERMINAL_INPUT=console
GRUB_TERMINAL_OUTPUT=gfxterm

# Native panel resolution; the theme's fonts are sized for it
GRUB_GFXMODE=2880x1800,auto
GRUB_GFXPAYLOAD_LINUX=keep
GRUB_THEME=/boot/grub/themes/slate/theme.txt

# Only "Arch Linux" and "Windows 11" (from 40_custom): hide the firmware's
# ~30 BootNext entries (Lenovo tools, PXE, USB...) and other generators
GRUB_DISABLE_BOOTNEXT=true
GRUB_DISABLE_RECOVERY=true
GRUB_DISABLE_OS_PROBER=true
GRUB_DISABLE_SUBMENU=true
