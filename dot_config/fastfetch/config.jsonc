{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": { "source": "arch_small", "color": { "1": "38;5;208" }, "padding": { "right": 2 } },
    "display": { "separator": "  ", "color": { "keys": "38;5;208" } },
    "modules": [
        "title",
        { "type": "os",       "key": "os  " },
        { "type": "kernel",   "key": "krnl" },
        { "type": "wm",       "key": "wm  " },
        { "type": "shell",    "key": "sh  " },
        { "type": "terminal", "key": "term" },
        { "type": "uptime",   "key": "up  " },
        { "type": "memory",   "key": "mem " },
        { "type": "battery",  "key": "bat " },
        "break",
        "colors"
    ]
}
