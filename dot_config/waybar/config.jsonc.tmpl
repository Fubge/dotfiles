// Waybar: floating pill-shaped bar, layout inspired by the old dotfiles.
// Colors live in style.css. Icons are Nerd Font glyphs written as JSON escapes.
{
    "layer": "top",
    // Reload only the CSS when style.css or an import changes (menu-state.css
    // hides tooltips while a menu or popup is open, see ~/.local/bin/bar-tooltips)
    "reload_style_on_change": true,
    "position": "top",
    "height": 30,
    "margin-top": {{ .design.gaps_in }},
    "margin-left": {{ .design.gaps_out }},
    "margin-right": {{ .design.gaps_out }},
    "spacing": 0,

    "modules-left":   ["hyprland/workspaces", "custom/window"],
    "modules-center": ["custom/prompt", "clock#hours", "custom/colon", "clock#minutes", "clock#date", "custom/caret", "group/music"],
    "modules-right":  ["group/hardware", "group/system", "group/connect", "custom/power"],

    // ---------------------------------------------------------------- groups
    // Hardware is a drawer: only the CPU shows, hover reveals temp + RAM
    "group/hardware": {
        "orientation": "horizontal",
        "drawer": { "transition-duration": 400, "transition-left-to-right": false },
        "modules": ["cpu", "temperature", "memory"]
    },
    "group/system": {
        "orientation": "horizontal",
        "modules": ["idle_inhibitor", "custom/power-profile", "custom/brightness", "custom/battery"]
    },
    "group/connect": {
        "orientation": "horizontal",
        "modules": ["wireplumber", "network", "custom/wifi-name", "bluetooth", "tray"]
    },

    // ---------------------------------------------------------------- left
    "hyprland/workspaces": {
        "format": "{icon}",
        "persistent-workspaces": { "*": 6 },
        // Solid logo-style glyphs: 1 desktop (Arch), 2 browser (Firefox logo),
        // 3 Neovim, 4 games (ghost), 5 chat (Discord), 6 free (cat)
        "format-icons": {
            "1": "\uf303",
            "2": "\uf269",
            "3": "\uf36f",
            "4": "\udb80\udea0",
            "5": "\udb81\ude6f",
            "6": "\udb80\udd1b",
            "default": "\udb81\udf66"
        },
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace = \"e-1\"})'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace = \"e+1\"})'"
    },
    // Focused app, typewriter style: the old name is erased, the new one typed
    // in with the orange caret (~/.local/bin/bar-flair, friendly names there)
    "custom/window": {
        "exec": "~/.local/bin/bar-flair window",
        "return-type": "json",
        "tooltip": false
    },

    // ---------------------------------------------------------------- center
    // Terminal-style clock:  ❯ 17:48  // Mi 11. Nov▍
    // One font and size for every piece so they share a baseline.
    // The prompt takes the time-of-day color (script: ~/.local/bin/clockface);
    // colon and caret blink via CSS, which is why they are separate modules.
    "custom/prompt": { "exec": "~/.local/bin/clockface", "return-type": "json" },
    "clock#hours":   { "format": "{0:%H}", "tooltip": false },
    "custom/colon":  { "format": ":", "tooltip": false },
    "clock#minutes": { "format": "{0:%M}", "tooltip": false },
    "clock#date": {
        // The date as a code comment. Hover shows the calendar, click hides the date
        "locale": "{{ .locale.clock }}",
        "format": "// {0:L%a %d. %b}",
        "format-alt": "//",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "left",
            "format": {
                "months":   "<span color='{{ .palette.fg }}'><b>{}</b></span>",
                "weeks":    "<span color='{{ .palette.slate }}'>W{}</span>",
                "weekdays": "<span color='{{ .palette.yellow }}'><b>{}</b></span>",
                "today":    "<span color='{{ .palette.accent }}'><b><u>{}</u></b></span>"
            }
        }
    },
    "custom/caret": {
        "format": "\u258d",
        "tooltip": false
    },
    // Now playing (hidden when nothing plays): icon, six visualizer bars, title.
    // One script (~/.local/bin/music, exec of custom/music) drives all parts; the
    // bars are separate modules so CSS can draw them as rounded pills. The icon
    // stays while Spotify runs (tray stand-in). Click = play/pause, right click =
    // menu (show / quit Spotify), scroll = skip
    "group/music": {
        "orientation": "horizontal",
        "modules": ["custom/music-icon"{{ range $i := until 6 }}, "custom/music-bar{{ $i }}"{{ end }}, "custom/music"]
    },
    "custom/music-icon": {
        "exec": "~/.local/bin/music part icon",
        "return-type": "json",
        "on-click": "~/.local/bin/music show",
        "on-click-right-release": "~/.local/bin/music menu",
        "on-scroll-up": "playerctl -p spotify,%any next",
        "on-scroll-down": "playerctl -p spotify,%any previous"
    },
{{- range $i := until 6 }}
    "custom/music-bar{{ $i }}": {
        "exec": "~/.local/bin/music part bar{{ $i }}",
        "return-type": "json",
        "on-click": "playerctl -p spotify,%any play-pause",
        "on-click-right-release": "~/.local/bin/music menu",
        "on-scroll-up": "playerctl -p spotify,%any next",
        "on-scroll-down": "playerctl -p spotify,%any previous"
    },
{{- end }}
    "custom/music": {
        "exec": "~/.local/bin/music",
        "return-type": "json",
        "on-click": "playerctl -p spotify,%any play-pause",
        "on-click-right-release": "~/.local/bin/music menu",
        "on-scroll-up": "playerctl -p spotify,%any next",
        "on-scroll-down": "playerctl -p spotify,%any previous"
    },

    // ---------------------------------------------------------------- hardware
    // Snail, rabbit, rocket, fire: the busier the CPU, the faster the animal
    "cpu": {
        "format": "{icon} {usage}%",
        "format-icons": ["\udb85\ude77", "\udb82\udd07", "\udb81\udc63", "\udb80\ude38"],
        "interval": 2,
        "states": { "high": 80 }
    },
    "temperature": {
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 90,
        "format": "{icon} {temperatureC}°",
        "format-icons": ["\udb84\udcc3", "\udb81\udd0f", "\udb84\udcc2"]
    },
    "memory": {
        "format": "\udb80\udf5b {used:0.1f}/{total:0.0f} GB",
        "tooltip-format": "Swap: {swapUsed:0.1f}/{swapTotal:0.0f} GB",
        "interval": 5,
        "states": { "high": 85 }
    },

    // ---------------------------------------------------------------- system
    // Coffee = stays awake, zZ = idles and locks as usual. Click toggles (videos, downloads, ...)
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "\udb80\udd76", "deactivated": "\udb81\udcb2" },
        "tooltip-format-activated": "Staying awake",
        "tooltip-format-deactivated": "Idle as usual"
    },
    // Click opens a small menu with the three profiles (script: ~/.local/bin/power-profile)
    "custom/power-profile": {
        "exec": "~/.local/bin/power-profile status",
        "return-type": "json",
        "interval": 5,
        "signal": 8,
        "on-click": "~/.local/bin/power-profile menu --bar"
    },
    // Perceived brightness (same numbers as the slider and the brightness keys);
    // the built-in backlight module would show the raw value. Script: ~/.local/bin/brightness
    "custom/brightness": {
        "exec": "~/.local/bin/brightness watch",
        "return-type": "json",
        // Icon only (moon / cloud / sun by level), the script picks it
        "on-scroll-up": "brightnessctl -e2 -n1 set 2%+",
        "on-scroll-down": "brightnessctl -e2 -n1 set 2%-",
        "on-click": "~/.local/bin/popup popup.brightness ~/.local/bin/brightness-popup"
    },
    // Icon only like brightness and volume (percent in the tooltip). Script
    // ~/.local/bin/battery: plain levels when draining, a filling bolt battery
    // with a small plug while charging (faster with more watts), only a green
    // plug once done (full / held by the charge limit); the plug slides in
    // with a click when plugging in and drifts away when unplugging
    "custom/battery": {
        "exec": "~/.local/bin/battery",
        "return-type": "json"
    },

    // ---------------------------------------------------------------- connect
    "wireplumber": {
        // Material speakers; the glyphs are
        // drawn small, so they get a larger size
        "format": "<span size='larger'>{icon}</span>",   // icon only, percent in the tooltip
        "tooltip-format": "Volume {volume}%\n{node_name}\nClick: outputs, right click: mute",
        "format-muted": "<span size='larger'>\udb81\udf5f</span>",
        "format-icons": ["\udb81\udd7f", "\udb81\udd80", "\udb81\udd7e"],
        "scroll-step": 2,
        "on-click": "~/.local/bin/rofi-volume --bar",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    // Icon only (signal strength); name and speed in the tooltip
    "network": {
        "format-wifi": "{icon}",
        "format-icons": ["\udb82\udd2f", "\udb82\udd1f", "\udb82\udd22", "\udb82\udd25", "\udb82\udd28"],
        "format-ethernet": "\udb80\ude00",
        "format-disconnected": "\udb82\udd2e",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}\n\udb80\udc45 {bandwidthDownBytes}   \udb80\udc5d {bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "on-click": "~/.local/bin/rofi-wifi --bar",
        "on-click-right": "~/.local/bin/popup popup-term kitty --class popup-term nmtui",
        "interval": 5
    },
    "bluetooth": {
        "format": "\udb80\udcaf",
        "format-disabled": "\udb80\udcb2",
        "format-off": "\udb80\udcb2",
        "format-connected": "\udb80\udcb1 {num_connections}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias} {device_battery_percentage}%",
        "on-click": "~/.local/bin/rofi-bluetooth --bar",
        "on-click-right": "~/.local/bin/popup popup-term kitty --class popup-term bluetoothctl"
    },
    // Wi-Fi name types itself in next to the icon when a connection comes up
    // ("offline" when it drops) and is erased again after a few seconds
    "custom/wifi-name": {
        "exec": "~/.local/bin/bar-flair wifi",
        "return-type": "json",
        "tooltip": false
    },
    "tray": {
        "icon-size": 17,
        // Spotify's tray icon is hidden: the music icon in the bar replaces it
        // (click = show/hide, right click = menu). The item still exists, so
        // ~/.local/bin/music can click its menu over D-Bus.
        "ignore-list": ["spotify"],
        "spacing": 12
    },

    "custom/power": {
        "format": "\udb81\udc25",
        "tooltip": false,
        "on-click": "~/.local/bin/rofi-power --bar"
    }
}
