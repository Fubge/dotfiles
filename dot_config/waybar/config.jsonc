// Waybar: floating pill-shaped bar, layout inspired by the old dotfiles.
// Colors live in style.css. Icons are Nerd Font glyphs written as JSON escapes.
{
    "layer": "top",
    "position": "top",
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 0,

    "modules-left":   ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock", "mpris"],
    "modules-right":  ["group/hardware", "group/system", "group/connect", "custom/power"],

    // ---------------------------------------------------------------- groups
    // Hardware is a drawer: only the CPU shows, hover reveals temp + RAM
    "group/hardware": {
        "orientation": "horizontal",
        "drawer": { "transition-duration": 400, "transition-left-to-right": false },
        "modules": ["cpu", "temperature", "memory"]
    },
    "group/system": {
        "orientation": "horizontal",
        "modules": ["idle_inhibitor", "power-profiles-daemon", "backlight", "battery"]
    },
    "group/connect": {
        "orientation": "horizontal",
        "modules": ["wireplumber", "network", "bluetooth", "tray"]
    },

    // ---------------------------------------------------------------- left
    "hyprland/workspaces": {
        "format": "{icon}",
        "persistent-workspaces": { "*": 5 },
        "format-icons": {
            "1": "\uf303",
            "2": "\uf269",
            "3": "\udb80\udd8d",
            "4": "\udb80\udd69",
            "5": "\udb82\udfc9",
            "default": "\udb81\udf66"
        },
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace = \"e-1\"})'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace = \"e+1\"})'"
    },
    "hyprland/window": {
        "format": "{class}",
        "separate-outputs": true,
        "max-length": 24
    },

    // ---------------------------------------------------------------- center
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "\udb80\udced  {:%a, %d. %b}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "left",
            "format": {
                "months":   "<span color='#ffead3'><b>{}</b></span>",
                "weeks":    "<span color='#808aa2'>W{}</span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today":    "<span color='#ff7f00'><b><u>{}</u></b></span>"
            }
        }
    },
    // Current song (hidden when nothing plays). Click = play/pause, scroll = skip
    "mpris": {
        "format": "{player_icon}  {title}",
        "format-paused": "{status_icon}  <i>{title}</i>",
        "title-len": 24,
        "player-icons": { "default": "\udb81\udf5a", "spotify": "\udb81\udcc7", "firefox": "\udb81\uddc3", "vivaldi": "\udb81\uddc3" },
        "status-icons": { "paused": "\udb80\udfe4" },
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    // ---------------------------------------------------------------- hardware
    "cpu": {
        "format": "\udb83\udee0  {usage}%",
        "interval": 2,
        "states": { "high": 80 }
    },
    "temperature": {
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 90,
        "format": "\udb81\udd0f  {temperatureC}°"
    },
    "memory": {
        "format": "\udb80\udf5b  {used:0.1f}/{total:0.0f} GB",
        "tooltip-format": "Swap: {swapUsed:0.1f}/{swapTotal:0.0f} GB",
        "interval": 5,
        "states": { "high": 85 }
    },

    // ---------------------------------------------------------------- system
    // Coffee cup: click to keep the screen awake (videos, downloads, ...)
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "\udb80\udd76", "deactivated": "\udb81\udeca" },
        "tooltip-format-activated": "Staying awake",
        "tooltip-format-deactivated": "Idle as usual"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nClick to switch",
        "format-icons": {
            "performance": "\udb81\udcc5",
            "balanced": "\udb83\udf85",
            "power-saver": "\udb80\udf2a"
        }
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon}  {percent}%",
        "format-icons": ["\udb81\udd94", "\udb81\udd99", "\udb81\udda8"],
        "on-scroll-up": "brightnessctl -e4 -n2 set 2%+",
        "on-scroll-down": "brightnessctl -e4 -n2 set 2%-",
        "tooltip-format": "Brightness {percent}% (scroll to change)"
    },
    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "{icon}  {capacity}%",
        "format-charging": "\udb80\udc84  {capacity}%",
        "format-plugged": "\udb81\udea5  {capacity}%",
        "format-icons": ["\udb80\udc7a", "\udb80\udc7c", "\udb80\udc7e", "\udb80\udc80", "\udb80\udc79"],
        "tooltip-format": "{timeTo}\n{power:.1f} W"
    },

    // ---------------------------------------------------------------- connect
    "wireplumber": {
        "format": "{icon}  {volume}%",
        "format-muted": "\udb81\udf5f",
        "format-icons": ["\udb81\udd7f", "\udb81\udd80", "\udb81\udd7e"],
        "scroll-step": 2,
        "on-click": "~/.local/bin/popup org.pulseaudio.pavucontrol pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    // Icon only (signal strength); name and speed in the tooltip
    "network": {
        "format-wifi": "{icon}",
        "format-icons": ["\udb82\udd2f", "\udb82\udd1f", "\udb82\udd22", "\udb82\udd25", "\udb82\udd28"],
        "format-ethernet": "\udb80\ude00",
        "format-disconnected": "\udb82\udd2e",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}\n\udb80\udc45 {bandwidthDownBytes}   \udb80\udc5d {bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "on-click": "~/.local/bin/rofi-wifi",
        "on-click-right": "~/.local/bin/popup popup-term kitty --class popup-term nmtui",
        "interval": 5
    },
    "bluetooth": {
        "format": "\udb80\udcaf",
        "format-disabled": "\udb80\udcb2",
        "format-off": "\udb80\udcb2",
        "format-connected": "\udb80\udcb1 {num_connections}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias} {device_battery_percentage}%",
        "on-click": "~/.local/bin/popup popup-term kitty --class popup-term bluetoothctl"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 12
    },

    "custom/power": {
        "format": "\udb81\udc25",
        "tooltip": false,
        "on-click": "~/.local/bin/rofi-power"
    }
}
