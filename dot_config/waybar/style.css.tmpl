/* Written by ~/.local/bin/bar-tooltips: hides tooltips while a menu or popup is open */
@import "menu-state.css";
/* Bar pet frames, generated by ~/.local/lib/pet/pet.py (chezmoi run script) */
@import "pet/pet.css";

/* Colors come from .chezmoidata/palette.toml */
@define-color dark    {{ .palette.bg }};
@define-color slate   {{ .palette.slate }};
@define-color steel   {{ .palette.steel }};
@define-color fg      {{ .palette.fg }};
@define-color accent  {{ .palette.accent }};
@define-color warn    {{ .palette.yellow }};
@define-color crit    {{ .palette.red }};
@define-color good    {{ .palette.green }};

* {
    font-family: "{{ .design.font }}", "Symbols Nerd Font";
    font-size: 14px;
    min-height: 0;
    border: none;
}

window#waybar {
    background: transparent;
    color: @fg;
}

tooltip {
    background: alpha(@dark, 0.95);
    border: 1px solid @accent;
    border-radius: {{ .design.rounding }}px;
}

/* Every section is its own pill */
.modules-left, .modules-right {
    background: @slate;
    border-radius: 15px;
}
.modules-center {
    background: @dark;
    border-radius: 15px;
}

/* ---------------------------------------------------------------- left */
#workspaces {
    background: @steel;
    border-radius: 15px;
    padding: 2px 4px;
}
#workspaces button {
    color: @fg;
    padding: 0 8px;
    margin: 0 1px;
    background: none;
    box-shadow: none;
    transition: all 0.25s ease-out;
}
#workspaces button.empty  { color: alpha(@fg, 0.4); }
/* Hover: the icon lights up orange and the button stretches a little */
#workspaces button:hover {
    color: @accent;
    padding: 0 11px;
}
/* Active workspace becomes a wider orange pill */
#workspaces button.active {
    color: @dark;
    background: @accent;
    padding: 0 16px;
}
#workspaces button.urgent { color: @crit; }

#custom-window { padding: 0 16px 0 8px; }

/* Claude's bar pet (~/.local/bin/claude-pad watch): the frame is a background
   image per class (pet/pet.css, also sets the size), the text is only a
   no-break space */
#custom-claude {
    padding: 0;
    margin: 0 0 0 8px;
    background-repeat: no-repeat;
    background-position: left bottom;
    transition: min-width 300ms ease-in-out;   /* the window title glides along */
}

/* ---------------------------------------------------------------- center */
/* Terminal clock:  ❯ 17:48  // Mi 11. Nov▍
   Same font and size everywhere (no extra padding top or bottom), so the
   separate modules line up on one baseline. */
#custom-prompt { padding: 0 9px 0 16px; font-weight: bold; }
#custom-prompt.morning { color: {{ .palette.yellow_bright }}; }
#custom-prompt.day     { color: {{ .palette.yellow }}; }
#custom-prompt.evening { color: @accent; }
#custom-prompt.night   { color: {{ .palette.cyan_bright }}; }
#clock.hours, #clock.minutes, #custom-colon {
    padding: 0;
    font-weight: bold;
}
#custom-colon {
    color: @accent;
    animation: soft-blink 1s steps(6) infinite alternate;
}
#clock.date {
    padding: 0 1px 0 12px;
    color: {{ .palette.comment }};
}
#custom-caret {
    color: @accent;
    padding: 0 6px 0 3px;
    animation: soft-blink 0.9s steps(6) infinite alternate;
}

/* Kitchen timer (~/.local/bin/timer-bar): orange hourglass + time left, it
   blinks in the last minute, grey while paused, rings with a red bell */
#custom-timer {
    padding: 0 10px 0 8px;
    margin: 4px 2px;
    border-radius: 11px;
    color: @accent;
    font-weight: bold;
    background: alpha(@accent, 0.14);
}
#custom-timer.paused  { color: {{ .palette.comment }}; background: alpha({{ .palette.comment }}, 0.14); }
#custom-timer.soon    { animation: soft-blink 0.5s steps(4) infinite alternate; }
#custom-timer.ringing {
    color: @dark;
    background: @crit;
    animation: soft-blink 0.4s steps(2) infinite alternate;
}
#custom-timer:hover   { background: alpha(@accent, 0.3); }

/* steps(6), not ease: a smooth infinite animation makes GTK redraw (and
   Hyprland composite) every frame, ~20% CPU idle; steps redraw 12x a second */
@keyframes soft-blink {
    from { opacity: 1; }
    to   { opacity: 0.15; }
}
/* now playing: icon + visualizer bars + title (~/.local/bin/music).
   Each bar is its own module; the script only sets a height class l0..l16,
   CSS draws a rounded pill growing from the middle and eases between heights. */
#custom-music-icon { padding: 0 8px 0 8px; }
#custom-music {
    padding: 0 12px 0 10px;
    color: {{ .palette.fg_muted }};
}
/* Each bar is a 9 px wide label: a crisp 3 px core (gradient) over a soft
   radial glow. Two background layers instead of box-shadow: the blurred shadow
   tripled waybar's CPU use, gradients are cheap. The label always has the full
   20 px; a height class only resizes and moves the background layers, which
   just repaints (changing margins made GTK lay out the bar on every frame). */
#music label.bar {
    font-size: 1px;
    color: transparent;
    padding: 0;
    min-width: 9px;
    margin: 5px 0;
    border-radius: 2px;
    background-image: linear-gradient(to top, @accent 35%, {{ .palette.yellow }}),
                      radial-gradient(closest-side, alpha(@accent, 0.6), alpha(@accent, 0));
    background-size: 3px 4px, 100% 4px;
    background-position: 50% 8px, 50% 8px;
    background-repeat: no-repeat;
    /* no transition: it animates at display rate (120 Hz) on top of the 60 fps
       updates and costs waybar + Hyprland ~5% each; 60 fps alone looks smooth */
    transition: none;
}
#music label.bar.paused {
    background-image: radial-gradient(circle closest-side, {{ .palette.comment }} 80%, alpha({{ .palette.comment }}, 0));
    background-size: 4px 4px;
    background-position: 50% 8px;
}
{{- /* heights 4..20 px, 1 px steps; odd remainders go to the top so the bar
       stays centered within half a px (y = offset inside the 20 px label) */}}
{{- range $l := until 17 }}
{{- $h := add 4 $l }}
{{- $y := sub (sub (sub 26 $l) (div (sub 26 $l) 2)) 5 }}
#music label.bar.l{{ $l }} { background-size: 3px {{ $h }}px, 100% {{ $h }}px; background-position: 50% {{ $y }}px, 50% {{ $y }}px; }
{{- end }}

/* ---------------------------------------------------------------- right */
#hardware { padding: 0 4px; }
#system   { background: @steel; border-radius: 15px; padding: 0 2px; }
#connect  { padding: 0 2px; }
#session  { background: @dark; border-radius: 15px; padding: 0 2px; }

#cpu, #temperature, #memory { padding: 0 10px; }

/* Icon-only modules: one fixed slot each, glyph centered, so every icon sits
   the same distance from the next. Padding alone gave 27-57 px gaps, as the
   glyphs differ in width; the Propo font makes each glyph as wide as it looks
   (the mono one lets wide icons hang out to the right). The battery grows
   past its slot while the plug shows. */
#idle_inhibitor, #custom-power-profile, #custom-brightness, #custom-battery,
#wireplumber, #network, #bluetooth,
#custom-notifications, #custom-power {
    font-family: "JetBrainsMono Nerd Font Propo", "Symbols Nerd Font";
    padding: 0;
    min-width: 38px;
}
/* tray icons on the same 38 px grid: 17 px icon + 21 px spacing */
#tray { padding: 0 10px; }
#custom-wifi-name { padding: 0 6px 0 0; margin-left: -6px; }

#custom-power { color: @accent; }
/* Notification bell (~/.local/bin/notification-bell) left of the power button:
   a calm light grey bell; with new ones it turns white and an orange dot sits
   in its cut out top right corner (drawn by the daemon, Pango markup); a
   sleeping bell (z) while do not disturb is on. Click opens the center */
#custom-notifications { color: {{ .palette.fg_muted }}; }
#custom-notifications.unread { color: @fg; }
#custom-notifications.dnd    { color: {{ .palette.cyan_bright }}; }   /* sleeping: night color, as the clock prompt */

/* ---------------------------------------------------------------- states */
#idle_inhibitor.activated           { color: @accent; }
#custom-power-profile.performance  { color: @accent; }
#custom-power-profile.power-saver  { color: @good; }
#cpu.high, #memory.high             { color: @warn; }
#temperature.critical               { color: @crit; }
/* Battery (~/.local/bin/battery): fills up green while charging,
   just a green plug once done (full or held by the charge limit), one
   yellow spark when the plug clicks in */
#custom-battery.charging, #custom-battery.full { color: @good; }
#custom-battery.plug                { color: @warn; }
#custom-battery.warning             { color: @warn; }
#wireplumber.muted, #bluetooth.disabled, #bluetooth.off,
#network.disconnected               { color: alpha(@fg, 0.45); }
#bluetooth.connected                { color: {{ .palette.blue }}; }
/* Brightness tells the time of day: cool moon, plain cloud, warm sun */
#custom-brightness.night            { color: {{ .palette.cyan_bright }}; }
#custom-brightness.sun              { color: {{ .palette.yellow }}; }

/* Critical battery pulses red */
@keyframes pulse {
    to { background: @crit; color: @dark; }
}
#custom-battery.critical {
    color: @crit;
    animation: pulse 1s ease-in-out infinite alternate;
}

/* ---------------------------------------------------------------- hover
   Same effect everywhere: orange text on a slightly darker background.
   Kept last so it wins over the state colors above. */
#workspaces button, #custom-window, #clock.date, #custom-music,
#cpu, #temperature, #memory,
#idle_inhibitor, #custom-power-profile, #custom-brightness, #custom-battery,
#wireplumber, #network, #bluetooth, #custom-notifications, #custom-power {
    transition: all 250ms ease;
    border-radius: 12px;
}
#workspaces button:hover,
#clock.date:hover, #custom-music:hover,
#cpu:hover, #temperature:hover, #memory:hover,
#idle_inhibitor:hover, #custom-power-profile:hover, #custom-brightness:hover, #custom-battery:hover,
#wireplumber:hover, #network:hover, #bluetooth:hover, #custom-notifications:hover {
    color: @accent;
    background: alpha(@dark, 0.3);
}
#workspaces button.active:hover { color: @dark; background: @accent; }
#custom-power:hover { color: @dark; background: @accent; }
