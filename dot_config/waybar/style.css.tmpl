/* Colors come from .chezmoidata/palette.toml */
@define-color dark    {{ .palette.bg }};
@define-color slate   {{ .palette.slate }};
@define-color steel   {{ .palette.steel }};
@define-color fg      {{ .palette.fg }};
@define-color accent  {{ .palette.accent }};
@define-color warn    {{ .palette.yellow }};
@define-color crit    {{ .palette.red }};
@define-color good    {{ .palette.green }};

* {
    font-family: "{{ .design.font }}", "Symbols Nerd Font";
    font-size: 14px;
    min-height: 0;
    border: none;
}

window#waybar {
    background: transparent;
    color: @fg;
}

tooltip {
    background: alpha(@dark, 0.95);
    border: 1px solid @accent;
    border-radius: {{ .design.rounding }}px;
}

/* Every section is its own pill */
.modules-left, .modules-right {
    background: @slate;
    border-radius: 15px;
}
.modules-center {
    background: @dark;
    border-radius: 15px;
}

/* ---------------------------------------------------------------- left */
#workspaces {
    background: @steel;
    border-radius: 15px;
    padding: 2px 4px;
}
#workspaces button {
    color: @fg;
    padding: 0 8px;
    margin: 0 1px;
    background: none;
    box-shadow: none;
}
#workspaces button.empty  { color: alpha(@fg, 0.4); }
/* Active workspace becomes a wider orange pill */
#workspaces button.active {
    color: @dark;
    background: @accent;
    padding: 0 16px;
}
#workspaces button.urgent { color: @crit; }

#window { padding: 0 16px; }
window#waybar.empty #window { padding: 0; }

/* ---------------------------------------------------------------- center */
/* Terminal clock:  ❯ 17:48  // Mi 11. Nov▍
   Same font and size everywhere (no extra padding top or bottom), so the
   separate modules line up on one baseline. */
#custom-prompt { padding: 0 9px 0 16px; font-weight: bold; }
#custom-prompt.morning { color: {{ .palette.yellow_bright }}; }
#custom-prompt.day     { color: {{ .palette.yellow }}; }
#custom-prompt.evening { color: @accent; }
#custom-prompt.night   { color: {{ .palette.cyan_bright }}; }
#clock.hours, #clock.minutes, #custom-colon {
    padding: 0;
    font-weight: bold;
}
#custom-colon {
    color: @accent;
    animation: soft-blink 1s ease-in-out infinite alternate;
}
#clock.date {
    padding: 0 1px 0 12px;
    color: {{ .palette.comment }};
}
#custom-caret {
    color: @accent;
    padding: 0 16px 0 3px;
    animation: soft-blink 0.9s ease-in-out infinite alternate;
}
@keyframes soft-blink {
    from { opacity: 1; }
    to   { opacity: 0.15; }
}
#mpris {
    padding: 0 16px 0 10px;
    color: @slate;
}
#mpris.playing { color: @accent; }

/* ---------------------------------------------------------------- right */
#hardware { padding: 0 4px; }
#system   { background: @steel; border-radius: 15px; padding: 0 4px; }
#connect  { padding: 0 4px; }

#cpu, #temperature, #memory,
#idle_inhibitor, #custom-power-profile, #custom-brightness, #custom-battery,
#wireplumber, #network, #bluetooth, #tray {
    padding: 0 10px;
}

#custom-power {
    background: @dark;
    color: @accent;
    border-radius: 15px;
    padding: 0 14px 0 12px;
}

/* ---------------------------------------------------------------- states */
#idle_inhibitor.activated           { color: @accent; }
#custom-power-profile.performance  { color: @accent; }
#custom-power-profile.power-saver  { color: @good; }
#cpu.high, #memory.high             { color: @warn; }
#temperature.critical               { color: @crit; }
/* Battery (~/.local/bin/battery): fills up green while charging,
   just a green plug once done (full or held by the charge limit), one
   yellow spark when the plug clicks in */
#custom-battery.charging, #custom-battery.full { color: @good; }
#custom-battery.plug                { color: @warn; }
#custom-battery.warning             { color: @warn; }
#wireplumber.muted, #bluetooth.disabled, #bluetooth.off,
#network.disconnected               { color: alpha(@fg, 0.45); }
#bluetooth.connected                { color: {{ .palette.blue }}; }
/* Brightness tells the time of day: cool moon, plain cloud, warm sun */
#custom-brightness.night            { color: {{ .palette.cyan_bright }}; }
#custom-brightness.sun              { color: {{ .palette.yellow }}; }

/* Critical battery pulses red */
@keyframes pulse {
    to { background: @crit; color: @dark; }
}
#custom-battery.critical {
    color: @crit;
    animation: pulse 1s ease-in-out infinite alternate;
}

/* ---------------------------------------------------------------- hover
   Same effect everywhere: orange text on a slightly darker background.
   Kept last so it wins over the state colors above. */
#workspaces button, #window, #clock.date, #mpris,
#cpu, #temperature, #memory,
#idle_inhibitor, #custom-power-profile, #custom-brightness, #custom-battery,
#wireplumber, #network, #bluetooth, #custom-power {
    transition: all 250ms ease;
    border-radius: 12px;
}
#workspaces button:hover,
#clock.date:hover, #mpris:hover,
#cpu:hover, #temperature:hover, #memory:hover,
#idle_inhibitor:hover, #custom-power-profile:hover, #custom-brightness:hover, #custom-battery:hover,
#wireplumber:hover, #network:hover, #bluetooth:hover {
    color: @accent;
    background: alpha(@dark, 0.3);
}
#workspaces button.active:hover { color: @dark; background: @accent; }
#custom-power:hover { color: @dark; background: @accent; }
