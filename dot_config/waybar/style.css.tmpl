/* Colors come from .chezmoidata/palette.toml */
@define-color bg       {{ .palette.bg }};
@define-color bg_dark  {{ .palette.bg_dark }};
@define-color bg_alt   {{ .palette.bg_alt }};
@define-color slate    {{ .palette.slate }};
@define-color steel    {{ .palette.steel }};
@define-color fg       {{ .palette.fg }};
@define-color muted    {{ .palette.fg_muted }};
@define-color accent   {{ .palette.accent }};
@define-color warn     {{ .palette.yellow }};
@define-color crit     {{ .palette.red }};
@define-color good     {{ .palette.green }};

* {
    font-family: "{{ .design.font }}", "Symbols Nerd Font";
    font-size: 13px;
    min-height: 0;
    border: none;
}

window#waybar {
    background: transparent;
    color: @fg;
}

tooltip {
    background: alpha(@bg_dark, 0.95);
    border: 1px solid @accent;
    border-radius: {{ .design.rounding }}px;
}

/* Every section is a dark, slightly see-through pill with a fine rim
   (same look as rofi, dunst and the lock screen) */
.modules-left, .modules-center, .modules-right {
    background: alpha(@bg, 0.88);
    border: 1px solid alpha(@slate, 0.35);
    border-radius: 15px;
}

/* Inner groups are a step lighter */
#workspaces, #system {
    background: @bg_alt;
    border-radius: 15px;
}

/* ---------------------------------------------------------------- left */
#workspaces { padding: 2px 4px; }
#workspaces button {
    color: @muted;
    padding: 0 8px;
    margin: 0 1px;
    background: none;
    box-shadow: none;
}
#workspaces button.empty  { color: alpha(@muted, 0.4); }
/* Active workspace becomes a wider orange pill */
#workspaces button.active {
    color: @bg;
    background: @accent;
    padding: 0 16px;
}
#workspaces button.urgent { color: @crit; }

#window { padding: 0 16px; color: @muted; }
window#waybar.empty #window { padding: 0; }

/* ---------------------------------------------------------------- center */
#clock {
    padding: 0 18px;
    font-weight: bold;
}
#mpris {
    padding: 0 16px 0 10px;
    color: @slate;
}
#mpris.playing { color: @accent; }

/* ---------------------------------------------------------------- right */
#hardware, #connect { padding: 0 4px; }
#system { padding: 0 4px; }

#cpu, #temperature, #memory,
#idle_inhibitor, #power-profiles-daemon, #backlight, #battery,
#wireplumber, #network, #bluetooth, #tray {
    padding: 0 9px;
}

#custom-power {
    color: @accent;
    padding: 0 14px 0 12px;
}

/* ---------------------------------------------------------------- states */
#idle_inhibitor.activated           { color: @accent; }
#power-profiles-daemon.performance  { color: @accent; }
#power-profiles-daemon.power-saver  { color: @good; }
#cpu.high, #memory.high             { color: @warn; }
#temperature.critical               { color: @crit; }
#battery.charging, #battery.plugged { color: @good; }
#battery.warning:not(.charging)     { color: @warn; }
#wireplumber.muted, #bluetooth.disabled, #bluetooth.off,
#network.disconnected               { color: alpha(@fg, 0.45); }
#bluetooth.connected                { color: {{ .palette.blue }}; }

/* Critical battery pulses red */
@keyframes pulse {
    to { background: @crit; color: @bg; }
}
#battery.critical:not(.charging) {
    color: @crit;
    animation: pulse 1s ease-in-out infinite alternate;
}

/* ---------------------------------------------------------------- hover
   Same effect everywhere: orange text on a slightly lighter background.
   Kept last so it wins over the state colors above. */
#workspaces button, #window, #clock, #mpris,
#cpu, #temperature, #memory,
#idle_inhibitor, #power-profiles-daemon, #backlight, #battery,
#wireplumber, #network, #bluetooth, #custom-power {
    transition: all 250ms ease;
    border-radius: 12px;
}
#workspaces button:hover,
#clock:hover, #mpris:hover,
#cpu:hover, #temperature:hover, #memory:hover,
#idle_inhibitor:hover, #power-profiles-daemon:hover, #backlight:hover, #battery:hover,
#wireplumber:hover, #network:hover, #bluetooth:hover {
    color: @accent;
    background: alpha(@steel, 0.45);
}
#workspaces button.active:hover { color: @bg; background: @accent; }
#custom-power:hover { color: @bg; background: @accent; }
