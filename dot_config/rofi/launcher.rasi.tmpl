/* App launcher (SUPER+Space): icon grid inside the shared overlay frame
   (overlay.rasi: size, position, search pill, footer). Only the grid lives here. */
@import "overlay.rasi"

entry { placeholder: "Search apps or the web"; }

listview {
    columns:       6;
    lines:         3;
    flow:          horizontal;
    fixed-columns: true;   /* a single match keeps its tile size */
    spacing:       6px;
}

element {
    orientation:   vertical;
    padding:       18px 8px 14px 8px;
    spacing:       10px;
}

element-icon { size: 64px; horizontal-align: 0.5; }

element-text {
    font:             @font-ui;
    highlight:        bold;
    horizontal-align: 0.5;
    vertical-align:   0;
}

textbox-hint {
    str: "Enter  open      ·      no match? Enter searches the web      ·      Esc  close";
}
