/* App launcher (SUPER+Space): blurred panel, search pill, fixed icon grid.
   Builds on config.rasi (colors, base look); only the layout lives here. */
@import "config.rasi"

* {
    surface:  {{ .palette.steel }}59;  /* selected tile: steel, ~35% */
    hint:     {{ .palette.comment }};
    font-ui:  "{{ .design.font_ui }} 11";
}

window {
    location:         north;    /* top edge stays put while the grid grows/shrinks */
    y-offset:         22%;
    width:            720px;
    padding:          28px 24px 18px 24px;
    background-color: {{ .palette.bg }}cc;  /* translucent; Hyprland blurs behind it */
    border-radius:    {{ mul .design.rounding 2 }}px;
}

mainbox {
    children: [ inputbar, listview, textbox-hint ];
    spacing:  22px;
}

/* ---------------------------------------------------------------- search */
/* The pill is centered between two spacers; the lens icon on the left is
   mirrored by an invisible one on the right so the text stays truly centered */
inputbar {
    orientation: horizontal;
    children:    [ dummy, box-search, dummy ];
}

box-search {
    orientation:      horizontal;
    expand:           false;
    width:            420px;
    padding:          12px 18px;
    spacing:          10px;
    background-color: {{ .palette.bg_alt }};
    border:           1px;
    border-color:     {{ .palette.steel }}99;
    border-radius:    999px;
    children:         [ textbox-lens, entry, textbox-lens-mirror ];
}

textbox-lens, textbox-lens-mirror {
    expand:     false;
    str:        "󰍉";  /* nf-md-magnify */
    font:       "{{ .design.font }} 14";
    text-color: @hint;
    vertical-align: 0.5;
}
textbox-lens-mirror { text-color: transparent; }

entry {
    font:              "{{ .design.font_ui }} 13";
    padding:           0;
    background-color:  transparent;
    border-radius:     0;
    horizontal-align:  0.5;
    vertical-align:    0.5;
    placeholder:       "Search apps or the web";
    placeholder-color: @hint;
}

/* ---------------------------------------------------------------- grid */
listview {
    columns:       5;
    lines:         3;
    flow:          horizontal;
    fixed-columns: true;   /* a single match keeps its tile size */
    fixed-height:  false;  /* panel shrinks to the matches */
    spacing:       6px;
    margin:        0;
    scrollbar:     false;
}

element {
    orientation:   vertical;
    padding:       16px 8px 12px 8px;
    spacing:       10px;
    border-radius: {{ .design.rounding }}px;
}

element selected.normal, element selected.active, element selected.urgent {
    background-color: @surface;
    text-color:       @accent;
}

element-icon { size: 60px; horizontal-align: 0.5; }

element-text {
    font:             @font-ui;
    highlight:        bold;
    horizontal-align: 0.5;
    vertical-align:   0;
}

/* ---------------------------------------------------------------- footer */
textbox-hint {
    expand:           false;
    str:              "Enter  open      ·      no match? Enter searches the web      ·      Esc  close";
    font:             "{{ .design.font_ui }} 9";
    text-color:       @hint;
    horizontal-align: 0.5;
}
