/* App launcher (SUPER+Space): compact icon grid. Shares the look of the
   overlays (overlay.rasi: search pill, colors, footer) but is smaller and sits
   in the upper part of the screen (like Spotlight / Raycast). */
@import "overlay.rasi"

window {
    /* top edge fixed, so the search pill always sits in the same spot */
    location: north;
    anchor:   north;
    /* rofi counts y from below the bar (8 px margin + 22 px bar) */
    y-offset: {{ sub .design.launcher_top 30 }}px;
    width:    {{ .design.launcher_width }}px;
    height:   0;   /* fit the content: search pill + grid + footer */
    padding:  20px 18px 14px 18px;
}

mainbox    { spacing: 16px; }
box-search { width: 340px; padding: 9px 16px; }
entry {
    placeholder: "{{ index .strings.rofi.launcher (dig "machine" "lang" "en" .) }}";
    font:        "{{ .design.font_ui }} 12";
}

listview {
    columns:       6;
    lines:         2;   /* 12 tiles, more scroll */
    flow:          horizontal;
    fixed-columns: true;   /* a single match keeps its tile size */
    fixed-height:  true;   /* grid keeps its height while filtering */
    spacing:       4px;
}

element {
    orientation: vertical;
    padding:     12px 6px 10px 6px;
    spacing:     8px;
}

element-icon { size: 48px; horizontal-align: 0.5; }

element-text {
    font:             "{{ .design.font_ui }} 10";
    highlight:        bold;
    horizontal-align: 0.5;
    vertical-align:   0;
}

textbox-hint {
    str: "{{ index .strings.rofi.launcher_hint (dig "machine" "lang" "en" .) }}";
}
