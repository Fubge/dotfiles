configuration {
    modi:               "drun,run,window";
    show-icons:         true;
    drun-display-format: "{name}";
    combi-display-format: "{text}";
    drun-match-fields:   "name,generic";
    display-drun:       "Apps";
    display-run:        "Run";
    display-window:     "Windows";
    font:               "{{ .design.font }} 12";
    /* one click picks a row (default: click selects, double click accepts) */
    me-select-entry:    "";
    me-accept-entry:    "MousePrimary";
}

* {
    bg:         {{ .palette.bg }}e6;
    bg-alt:     {{ .palette.steel }};
    fg:         {{ .palette.fg }};
    accent:     {{ .palette.accent }};

    background-color: transparent;
    text-color:       @fg;
}

window {
    width:            600px;
    background-color: @bg;
    border:           {{ .design.border }}px;
    border-color:     @accent;
    border-radius:    {{ .design.rounding }}px;
    padding:          12px;
}

/* Search bar: small centered label (the prompt) above a centered input pill */
inputbar {
    orientation:      vertical;
    children:         [ prompt-row, entry ];
    spacing:          8px;
}

/* rofi ignores horizontal-align on the prompt, so center it between two spacers */
prompt-row {
    orientation: horizontal;
    children:    [ dummy, prompt, dummy ];
    expand:      false;
}

prompt {
    text-color:       @accent;
    expand:           false;
}

entry {
    padding:           10px 14px;
    background-color:  @bg-alt;
    border-radius:     8px;
    horizontal-align:  0.5;
    cursor:            text;
    placeholder:       "{{ index .strings.rofi.filter (dig "machine" "lang" "en" .) }}";
    placeholder-color: {{ .palette.fg_muted }};
}

listview {
    lines:     8;
    spacing:   4px;
    margin:    10px 0 0 0;
    scrollbar: false;
}

element {
    padding:       8px 12px;
    spacing:       10px;
    border-radius: 8px;
}

/* Unselected rows: no background (rofi's default theme would paint them light) */
element normal.normal, element alternate.normal,
element normal.active, element alternate.active,
element normal.urgent, element alternate.urgent {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal, element selected.active, element selected.urgent {
    background-color: @bg-alt;
    text-color:       @accent;
}

element-icon { size: 1.3em; background-color: transparent; }
element-text { text-color: inherit; background-color: transparent; vertical-align: 0.5; }
