configuration {
    modi:               "drun,run,window";
    show-icons:         true;
    drun-display-format: "{name}";
    display-drun:       "Apps";
    display-run:        "Run";
    display-window:     "Windows";
    font:               "{{ .design.font }} 12";
}

* {
    bg:         {{ .palette.bg }}e6;
    bg-alt:     {{ .palette.steel }};
    fg:         {{ .palette.fg }};
    accent:     {{ .palette.accent }};

    background-color: transparent;
    text-color:       @fg;
}

window {
    width:            600px;
    background-color: @bg;
    border:           {{ .design.border }}px;
    border-color:     @accent;
    border-radius:    {{ .design.rounding }}px;
    padding:          12px;
}

inputbar {
    children:         [ prompt, entry ];
    spacing:          10px;
    padding:          10px 14px;
    background-color: @bg-alt;
    border-radius:    8px;
}

prompt { text-color: @accent; }
entry  { placeholder: "App or web search..."; placeholder-color: {{ .palette.fg_muted }}; }

listview {
    lines:     8;
    spacing:   4px;
    margin:    10px 0 0 0;
    scrollbar: false;
}

element {
    padding:       8px 12px;
    spacing:       10px;
    border-radius: 8px;
}

element selected.normal {
    background-color: @bg-alt;
    text-color:       @accent;
}

element-icon { size: 1.3em; }
element-text { text-color: inherit; vertical-align: 0.5; }
