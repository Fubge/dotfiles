# Prompt: rounded pills in the desktop palette, command on the second line.
#    /  = left / right rounded caps (Nerd Font)
format = """
[](fg:{{ .palette.accent }})$os[](fg:{{ .palette.accent }}) \
[](fg:{{ .palette.steel }})$directory[](fg:{{ .palette.steel }})\
$git_branch$git_status\
$fill$cmd_duration$status
$character"""

add_newline = true
command_timeout = 1000

[os]
disabled = false
style = "fg:{{ .palette.bg }} bg:{{ .palette.accent }}"
format = "[$symbol]($style)"
symbols.Arch = ""

[directory]
style = "fg:{{ .palette.fg }} bg:{{ .palette.steel }}"
format = "[$path$read_only]($style)"
read_only = " \U000F033E"
truncation_length = 3
truncation_symbol = "…/"
home_symbol = "~"

[git_branch]
symbol = ""
style = "fg:{{ .palette.bg }} bg:{{ .palette.slate }}"
format = " [](fg:{{ .palette.slate }})[$symbol $branch]($style)"

[git_status]
style = "fg:{{ .palette.bg }} bg:{{ .palette.slate }}"
format = "[( $all_status$ahead_behind)]($style)[](fg:{{ .palette.slate }})"

[fill]
symbol = " "

[cmd_duration]
min_time = 2000
style = "fg:{{ .palette.yellow }}"
format = "[\U000F0954 $duration]($style) "

[status]
disabled = false
style = "fg:{{ .palette.red }}"
format = "[\U000F0159 $status]($style)"

[character]
success_symbol = "[❯](bold fg:{{ .palette.accent }})"
error_symbol = "[❯](bold fg:{{ .palette.red }})"
