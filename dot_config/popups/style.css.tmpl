/* Shared look of the small GTK popups (brightness slider, shortcut overview).
   Colors and fonts come from .chezmoidata/{palette,design}.toml. Hyprland draws
   the rounded corners, the orange border and the blur behind the window. */

window.popup {
    background-color: alpha({{ .palette.bg }}, 0.94);
    color: {{ .palette.fg }};
    font-family: "{{ .design.font_ui }}";
    font-size: 11pt;
}

.title {
    color: {{ .palette.accent }};
    font-weight: 700;
    font-size: 12pt;
}
.muted { color: {{ .palette.comment }}; }

/* ---------------------------------------------------------------- menu look */
/* Popups that sit next to the rofi menus (brightness) copy rofi/menu.rasi:
   same font, padding, centered accent title, row height */
window.popup.menu {
    background-color: alpha({{ .palette.bg }}, 0.9);
    font-family: "{{ .design.font }}";
    font-size: 12pt;
}
.menu-box { padding: 12px; }
.menu-title {
    color: {{ .palette.accent }};
    margin-top: 2px;
}

/* ---------------------------------------------------------------- slider */
.slider-row { padding: 9px 14px; }
.slider-icon {
    color: {{ .palette.accent }};
    min-width: 20px;
}
.slider-value { min-width: 40px; }
scale { padding: 0; }
scale trough {
    min-height: 4px;
    border-radius: 99px;
    background-color: alpha({{ .palette.steel }}, 0.45);
}
scale highlight {
    border-radius: 99px;
    background-color: {{ .palette.accent }};
}
scale slider {
    min-width: 14px;
    min-height: 14px;
    margin: -5px;
    border-radius: 99px;
    background-color: {{ .palette.fg }};
    box-shadow: none;
}

/* ---------------------------------------------------------------- shortcuts */
/* Frame of the big overlays, copied from rofi/overlay.rasi */
window.popup.overlay { background-color: alpha({{ .palette.bg }}, 0.9); }
.overview { padding: 28px 24px 18px 24px; }
.search-pill {
    min-width: 420px;
    padding: 12px 18px;
    border-radius: 999px;
    border: 1px solid alpha({{ .palette.steel }}, 0.6);
    background-color: {{ .palette.bg_alt }};
}
.lens {
    font-family: "{{ .design.font }}";
    font-size: 14pt;
    color: {{ .palette.comment }};
}
.lens.mirror { color: transparent; }
entry.search {
    min-height: 0;
    padding: 0;
    border: none;
    box-shadow: none;
    outline: none;
    background: none;
    color: {{ .palette.fg }};
    font-size: 13pt;
}
entry.search placeholder,
entry.search text placeholder { color: {{ .palette.comment }}; }
.hint {
    color: {{ .palette.comment }};
    font-size: 9pt;
}

.card {
    padding: 14px 16px;
    border-radius: 12px;
    background-color: alpha({{ .palette.bg_alt }}, 0.75);
}
.card-title {
    color: {{ .palette.accent }};
    font-weight: 700;
    font-size: 9pt;
    letter-spacing: 1px;
    margin-bottom: 6px;
}
.row { padding: 3px 0; }
.overview .card { font-size: 10pt; }
.desc { color: {{ .palette.fg_muted }}; }

/* Keycaps */
.key {
    font-family: "{{ .design.font }}";
    font-size: 9pt;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 6px;
    background-color: alpha({{ .palette.steel }}, 0.55);
    color: {{ .palette.fg }};
    box-shadow: inset 0 -2px alpha(black, 0.25);
}
.key.mod {
    background-color: alpha({{ .palette.accent }}, 0.18);
    color: {{ .palette.accent }};
}
.plus { color: {{ .palette.comment }}; font-size: 9pt; }

/* ---------------------------------------------------------------- pet picker */
/* One card per bar pet (~/.local/bin/pet-picker); the pet in use is framed
   in orange, the card under the mouse / keyboard gets the menu's steel tint */
.pet-card {
    padding: 8px 10px 6px 10px;
    border-radius: 12px;
    border: 1px solid transparent;
    background-color: alpha({{ .palette.steel }}, 0.18);
}
.pet-card.selected { background-color: alpha({{ .palette.steel }}, 0.35); }
.pet-card.current  { border-color: alpha({{ .palette.accent }}, 0.8); }
.pet-name {
    font-size: 10pt;
    color: {{ .palette.fg_muted }};
}
.pet-card.selected .pet-name,
.pet-card.current .pet-name { color: {{ .palette.accent }}; }

/* ---------------------------------------------------------------- list menus */
/* Claude and music right click menus (~/.local/bin/list-menu): rows like the
   item rows below (accent icon column, steel highlight), accent for the
   current row; typing filters */
.menu-search {
    min-height: 0;
    padding: 9px 14px;
    border: none;
    border-radius: 8px;
    box-shadow: none;
    outline: none;
    background-color: alpha({{ .palette.steel }}, 0.45);
    color: {{ .palette.fg }};
}
.menu-search placeholder,
.menu-search text placeholder { color: {{ .palette.comment }}; }
.menu-list { background: none; }
.menu-list row {
    padding: 9px 14px;
    margin-top: 2px;
    border-radius: 8px;
    outline: none;
    background: none;
    color: {{ .palette.fg }};
}
.menu-list row:first-child { margin-top: 0; }
.menu-list row.active { color: {{ .palette.accent }}; }
.menu-list row:selected { background-color: {{ .palette.steel }}; }
.menu-info {
    color: {{ .palette.comment }};
    font-size: 10pt;
    margin: -4px 14px 0 14px;
}
.list-menu scrollbar { opacity: 0; }

/* ---------------------------------------------------------------- sound */
/* ~/.local/bin/sound-popup: sliders like the brightness popup, outputs as rows */
.menu-box .section {
    color: {{ .palette.comment }};
    font-size: 10pt;
    margin: 8px 14px 2px 14px;
}
button.slider-icon {
    min-width: 20px;
    min-height: 0;
    padding: 0;
    border: none;
    box-shadow: none;
    background: none;
    color: {{ .palette.accent }};
}
button.slider-icon:hover { color: {{ .palette.fg }}; }
.slider-icon.muted, .slider-value.muted { color: {{ .palette.comment }}; }
button.slider-icon.muted image { opacity: 0.4; }
.sound .slider-row { padding: 7px 14px; }
.app-name {
    font-size: 10pt;
    color: {{ .palette.fg_muted }};
    margin: 4px 14px -6px 14px;
}
button.sound-row {
    min-height: 0;
    padding: 7px 14px;
    border: none;
    border-radius: 8px;
    box-shadow: none;
    background: none;
    color: {{ .palette.fg }};
    font-weight: normal;
}
button.sound-row:hover, button.sound-row:focus-visible { background-color: {{ .palette.steel }}; }
button.sound-row.active { color: {{ .palette.accent }}; }
.sound-sep {
    margin: 6px 14px 2px 14px;
    background-color: alpha({{ .palette.steel }}, 0.6);
}

/* ---------------------------------------------------------------- item rows */
/* Bluetooth, Wi-Fi and power popups: rows like the sound outputs, an accent
   icon and a status line under the name; the arrow next to a row opens its
   card (info + action buttons); on/off switch next to the title */
.head { margin: 0 4px 4px 4px; }
.row-icon {
    color: {{ .palette.accent }};
    min-width: 20px;
}
.row-status {
    font-size: 9pt;
    color: {{ .palette.comment }};
}
button.device.active .row-status { color: {{ .palette.fg_muted }}; }
button.device.busy .row-status { color: {{ .palette.accent }}; }
.note {
    color: {{ .palette.comment }};
    font-size: 10pt;
    margin: 6px 14px;
}
button.more {
    min-height: 0;
    min-width: 0;
    padding: 4px 10px;
    border: none;
    border-radius: 8px;
    box-shadow: none;
    background: none;
    color: {{ .palette.comment }};
}
button.more:hover, button.more:focus-visible {
    background-color: {{ .palette.steel }};
    color: {{ .palette.fg }};
}
/* an opened device: framed, its address and the action buttons below */
.item-card {
    padding-bottom: 8px;
    border-radius: 10px;
    background-color: alpha({{ .palette.steel }}, 0.25);
}
.item-info {
    font-size: 9pt;
    color: {{ .palette.comment }};
    margin: -4px 14px 0 46px;
}
.item-actions { margin: 0 10px; }
button.item-action {
    min-height: 0;
    padding: 5px 8px;
    border: none;
    border-radius: 8px;
    box-shadow: none;
    background-color: alpha({{ .palette.steel }}, 0.5);
    color: {{ .palette.fg }};
    font-size: 10pt;
    font-weight: normal;
}
button.item-action:hover, button.item-action:focus-visible {
    background-color: {{ .palette.steel }};
    color: {{ .palette.accent }};
}
button.item-action.danger { background-color: {{ .palette.red }}; color: {{ .palette.bg }}; }
.found scrollbar { opacity: 0; }
window.popup switch {
    min-height: 18px;
    border: none;
    border-radius: 99px;
    background-color: alpha({{ .palette.steel }}, 0.6);
    box-shadow: none;
}
window.popup switch:checked { background-color: {{ .palette.accent }}; }
window.popup switch slider {
    min-width: 18px;
    min-height: 18px;
    margin: 2px;
    border: none;
    border-radius: 99px;
    background-color: {{ .palette.fg }};
    box-shadow: none;
}

/* a row that only informs (wired connection in the Wi-Fi popup) */
.sound-row.info { padding: 7px 14px; color: {{ .palette.accent }}; }
.note.error, .item-info.error { color: {{ .palette.red }}; }
button.item-action.on { color: {{ .palette.accent }}; }
button.item-action.off { color: {{ .palette.comment }}; }
/* Wi-Fi password field inside a network's card */
.item-actions entry.password { padding: 5px 10px; font-size: 10pt; }
.item-actions entry.password image { color: {{ .palette.comment }}; }

/* ---------------------------------------------------------------- segments */
/* A few choices side by side: power profiles, keyboard backlight levels */
.segments { margin: 2px 4px 4px 4px; }
button.segment {
    min-height: 0;
    padding: 6px 4px;
    border: 1px solid transparent;
    border-radius: 10px;
    box-shadow: none;
    background-color: alpha({{ .palette.steel }}, 0.25);
    color: {{ .palette.fg_muted }};
    font-weight: normal;
}
button.segment.small { padding: 3px 4px; font-size: 10pt; }
button.segment:hover, button.segment:focus-visible {
    background-color: alpha({{ .palette.steel }}, 0.6);
    color: {{ .palette.fg }};
}
button.segment.active {
    border-color: alpha({{ .palette.accent }}, 0.8);
    background-color: alpha({{ .palette.accent }}, 0.15);
    color: {{ .palette.accent }};
}
.segment-icon { font-size: 15pt; }
.segment-label { font-size: 9pt; }
.brightness .slider-row { padding: 7px 14px; }

/* ---------------------------------------------------------------- power */
/* ~/.local/bin/power-popup: battery on top, profiles, session rows */
.battery { margin: 4px 14px 6px 14px; }
.battery .item-info { margin: 0; }
.battery-icon { color: {{ .palette.accent }}; font-size: 16pt; min-width: 20px; }
.battery-level { font-size: 16pt; font-weight: 700; }
.battery-bar trough {
    min-height: 4px;
    border: none;
    border-radius: 99px;
    background-color: alpha({{ .palette.steel }}, 0.45);
}
.battery-bar block.filled { border: none; border-radius: 99px; background-color: {{ .palette.accent }}; }
.battery-bar block.empty { border: none; background: none; }
.battery.charging .battery-icon { color: {{ .palette.green }}; }
.battery.charging .battery-bar block.filled { background-color: {{ .palette.green }}; }
.battery.warning .battery-icon { color: {{ .palette.yellow }}; }
.battery.warning .battery-bar block.filled { background-color: {{ .palette.yellow }}; }
.battery.critical .battery-icon, .battery.critical .battery-level { color: {{ .palette.red }}; }
.battery.critical .battery-bar block.filled { background-color: {{ .palette.red }}; }
button.sound-row.danger, button.sound-row.danger .row-icon { color: {{ .palette.red }}; }

/* ---------------------------------------------------------------- session */
/* ~/.local/bin/session-popup: centered, greeting types itself, round buttons
   pop in one after the other, wiggle under the mouse, pulse red when they ask */
.session-box { padding: 26px 28px 20px 28px; }
.session-hello {
    font-size: 16pt;
    color: {{ .palette.fg }};
}
.session-up {
    font-size: 9pt;
    color: {{ .palette.comment }};
    margin-bottom: 16px;
}
button.session-button {
    min-height: 0;
    min-width: 0;
    padding: 0;
    border: none;
    box-shadow: none;
    background: none;
    outline: none;
}
.session-circle {
    min-width: 72px;
    min-height: 72px;
    border-radius: 99px;
    font-size: 22pt;
    background-color: alpha({{ .palette.steel }}, 0.3);
    color: {{ .palette.accent }};
    transition: background-color 160ms ease, color 160ms ease, transform 200ms ease,
                box-shadow 200ms ease;
}
.session-label {
    font-size: 10pt;
    color: {{ .palette.fg_muted }};
    transition: color 160ms ease;
}
.session-key { font-size: 8pt; padding: 0 6px; opacity: 0.7; }

/* pop in, one after the other */
@keyframes session-pop {
    0%   { opacity: 0; transform: translateY(14px) scale(0.6); }
    70%  { opacity: 1; transform: translateY(-3px) scale(1.06); }
    100% { opacity: 1; transform: none; }
}
button.session-button.enter { animation: session-pop 380ms ease-out both; }
.session-row button.session-button.enter:nth-child(2) { animation-delay: 50ms; }
.session-row button.session-button.enter:nth-child(3) { animation-delay: 100ms; }
.session-row button.session-button.enter:nth-child(4) { animation-delay: 150ms; }
.session-row button.session-button.enter:nth-child(5) { animation-delay: 200ms; }

/* in focus / under the mouse: orange, a bit bigger, a little wiggle */
@keyframes session-wiggle {
    0%   { transform: scale(1.1) rotate(0deg); }
    30%  { transform: scale(1.1) rotate(-9deg); }
    60%  { transform: scale(1.1) rotate(6deg); }
    100% { transform: scale(1.1) rotate(0deg); }
}
button.session-button:focus .session-circle {
    background-color: {{ .palette.accent }};
    color: {{ .palette.bg }};
    transform: scale(1.1);
    box-shadow: 0 0 18px alpha({{ .palette.accent }}, 0.45);
    animation: session-wiggle 420ms ease-in-out 1;
}
button.session-button:focus .session-label { color: {{ .palette.fg }}; }

/* asks first: red, pulsing */
@keyframes session-pulse {
    0%   { box-shadow: 0 0 0 0 alpha({{ .palette.red }}, 0.6); }
    100% { box-shadow: 0 0 0 14px alpha({{ .palette.red }}, 0); }
}
button.session-button.confirm .session-circle {
    background-color: {{ .palette.red }};
    color: {{ .palette.bg }};
    transform: scale(1.1);
    animation: session-pulse 900ms ease-out infinite;
}
button.session-button.confirm .session-label { color: {{ .palette.red }}; }
.session-caption {
    margin-top: 14px;
    font-size: 10pt;
    color: {{ .palette.comment }};
}

/* ---------------------------------------------------------------- motion */
/* The same small motions in every popup. Entrance (~/.local/lib/popup/resident.py
   animate_in): the window gets class "enter" for a moment and its rows are
   numbered in-0..in-11, so they slide in one after the other. */
@keyframes row-in {
    0%   { opacity: 0; transform: translateY(8px); }
    100% { opacity: 1; transform: none; }
}
{{- range $i := until 12 }}
window.enter .in-{{ $i }} { animation: row-in 260ms cubic-bezier(0.2, 0.9, 0.3, 1.15) {{ mul $i 28 }}ms both; }
{{- end }}

/* row icons wiggle under the mouse / keyboard */
@keyframes icon-wiggle {
    0%   { transform: none; }
    30%  { transform: rotate(-12deg) scale(1.15); }
    65%  { transform: rotate(8deg) scale(1.15); }
    100% { transform: none; }
}
button.sound-row:hover .row-icon, button.sound-row:focus-visible .row-icon,
button.sound-row:hover .text-icon, button.sound-row:focus-visible .text-icon,
.menu-list row:selected .row-icon,
button.segment:hover .segment-icon {
    animation: icon-wiggle 380ms ease-in-out 1;
}
.text-icon { min-width: 20px; }

/* something is running: the status breathes, search icons turn */
@keyframes breathe {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.35; }
}
@keyframes spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
}
button.device.busy .row-status, button.device.busy .row-icon, .busy-text {
    animation: breathe 1.4s ease-in-out infinite;
}
.spin { animation: spin 1s linear infinite; }

/* a card unfolds; a wrong password shakes its head */
@keyframes card-in {
    0%   { opacity: 0; transform: scale(0.96) translateY(-4px); }
    100% { opacity: 1; transform: none; }
}
@keyframes shake {
    0%, 100% { transform: none; }
    20% { transform: translateX(-7px); }
    40% { transform: translateX(6px); }
    60% { transform: translateX(-4px); }
    80% { transform: translateX(2px); }
}
.item-card.opening { animation: card-in 220ms ease-out both; }
.item-card.shake { animation: shake 380ms ease-in-out 1; }

/* "Sure?" pulses red like the session popup */
button.item-action.danger { animation: session-pulse 900ms ease-out infinite; }

/* buttons ease between states */
button.sound-row, button.item-action, button.segment, button.more, .menu-list row {
    transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
}
button.item-action:active, button.segment:active, button.sound-row:active {
    transform: scale(0.97);
}
@keyframes seg-pop {
    0%   { transform: scale(0.92); }
    60%  { transform: scale(1.05); }
    100% { transform: none; }
}
button.segment.active { animation: seg-pop 260ms ease-out 1; }

/* switches slide, slider knobs grow under the finger */
window.popup switch, window.popup switch slider {
    transition: background-color 200ms ease, margin 200ms ease;
}
scale slider { transition: transform 150ms ease; }
scale:hover slider, scale:active slider { transform: scale(1.3); }

/* muting shakes the icon */
@keyframes mute-shake {
    0%, 100% { transform: none; }
    25% { transform: rotate(-14deg); }
    50% { transform: rotate(10deg); }
    75% { transform: rotate(-5deg); }
}
button.slider-icon.muted { animation: mute-shake 320ms ease-in-out 1; }

/* battery: the fill shimmers while charging, the icon pulses when low */
@keyframes charge-shimmer {
    0%, 100% { background-color: {{ .palette.green }}; }
    50%      { background-color: {{ .palette.green_bright }}; }
}
.battery.charging .battery-bar block.filled { animation: charge-shimmer 1.6s ease-in-out infinite; }
.battery.critical .battery-icon { animation: breathe 1.2s ease-in-out infinite; }

/* pet picker: the chosen pet hops */
@keyframes hop {
    0%, 100% { transform: none; }
    40% { transform: translateY(-5px); }
}
.pet-card.selected { animation: hop 300ms ease-out 1; }

/* ---------------------------------------------------------------- notifications */
/* ~/.local/bin/notifications: cards in the top right corner below the bar.
   Every app gets a round bubble with its glyph in a palette color (tint-*);
   pictures (avatars, covers) get the glyph as a badge. A card swings in from
   the screen edge, the bubble pops, the summary types itself with the orange
   caret, a thin line counts down (pauses under the mouse), it slides out. */
window.notifications { background: none; }
.notif-stack { padding: {{ add .design.gaps_in 6 }}px {{ .design.gaps_out }}px 12px 14px; }
.notif {
    margin-bottom: 8px;
    border-radius: {{ add .design.rounding 2 }}px;
    border: 1px solid alpha({{ .palette.steel }}, 0.55);
    background-color: alpha({{ .palette.bg }}, 0.94);
    color: {{ .palette.fg }};
    font-family: "{{ .design.font_ui }}";
    font-size: 10.5pt;
    transition: background-color 180ms ease, border-color 180ms ease;
}
.notif.hover {
    border-color: alpha({{ .palette.accent }}, 0.7);
    background-color: alpha({{ .palette.bg_alt }}, 0.96);
}
.notif.low { background-color: alpha({{ .palette.bg_dark }}, 0.92); }
.notif.low .notif-summary { color: {{ .palette.fg_muted }}; }
.notif-main { padding: 12px 12px 12px 14px; }
.notif-caret { color: {{ .palette.accent }}; }

/* the bubble */
.notif-glyph {
    min-width: 44px;
    min-height: 44px;
    border-radius: 99px;
    font-family: "{{ .design.font }}";
    font-size: 18pt;
}
.notif-thumb { border-radius: 12px; margin: 0 4px 4px 0; }
.notif-badge {
    min-width: 22px;
    min-height: 22px;
    border-radius: 99px;
    font-family: "{{ .design.font }}";
    font-size: 9pt;
    color: {{ .palette.bg }};
    box-shadow: 0 0 0 2px {{ .palette.bg }};
}
{{- $p := .palette }}
{{- range $name := list "accent" "blue" "cyan" "green" "yellow" "magenta" "red" "slate" }}
.notif-glyph.tint-{{ $name }} { color: {{ index $p $name }}; background-color: alpha({{ index $p $name }}, 0.16); }
.notif-badge.tint-{{ $name }} { background-color: {{ index $p $name }}; }
{{- end }}

/* text */
.notif-app {
    font-size: 8.5pt;
    color: {{ .palette.comment }};
}
.notif-age { font-size: 8.5pt; color: {{ .palette.comment }}; }
.notif-summary { font-weight: 700; font-size: 11pt; }
.notif-body { color: {{ .palette.fg_muted }}; }
button.notif-close {
    min-width: 0;
    min-height: 0;
    padding: 0 4px;
    border: none;
    border-radius: 6px;
    box-shadow: none;
    background: none;
    font-family: "{{ .design.font }}";
    font-size: 10pt;
    color: {{ .palette.comment }};
    opacity: 0;
    transition: opacity 160ms ease, color 160ms ease;
}
.notif.hover button.notif-close { opacity: 1; }
button.notif-close:hover { color: {{ .palette.red }}; }
.notif-actions { margin-top: 8px; }

/* value bar (volume, brightness, downloads) */
.notif-progress-row { margin-top: 6px; }
.notif-progress trough {
    min-height: 4px;
    border: none;
    border-radius: 99px;
    background-color: alpha({{ .palette.steel }}, 0.45);
}
.notif-progress progress {
    min-height: 4px;
    border: none;
    border-radius: 99px;
    background-color: {{ .palette.accent }};
    transition: min-width 150ms ease;
}
.notif-progress-value { font-size: 9pt; color: {{ .palette.fg_muted }}; min-width: 34px; }

/* countdown along the bottom edge */
.notif-timer trough { min-height: 2px; border: none; border-radius: 0; background: none; }
.notif-timer progress {
    min-height: 2px;
    border: none;
    border-radius: 0 99px 99px 0;
    background-color: alpha({{ .palette.accent }}, 0.75);
}
.notif.hover .notif-timer progress { background-color: alpha({{ .palette.comment }}, 0.6); }
.notif.low .notif-timer progress { background-color: alpha({{ .palette.slate }}, 0.6); }

/* critical: red frame and bubble, the frame pulses, no countdown */
.notif.critical { border: 2px solid {{ .palette.red }}; }
.notif.critical .notif-app { color: {{ .palette.red }}; }
.notif.critical .notif-progress progress { background-color: {{ .palette.red }}; }
@keyframes notif-alarm {
    0%   { box-shadow: 0 0 0 0 alpha({{ .palette.red }}, 0.55); }
    100% { box-shadow: 0 0 0 10px alpha({{ .palette.red }}, 0); }
}
.notif.critical:not(.entering) { animation: notif-alarm 1.4s ease-out infinite; }

/* motion: swing in from the screen edge, the bubble pops and wiggles */
@keyframes notif-in {
    0%   { opacity: 0; transform: translateX(440px); }
    60%  { opacity: 1; transform: translateX(-12px); }
    80%  { transform: translateX(4px); }
    100% { opacity: 1; transform: none; }
}
@keyframes notif-out {
    0%   { opacity: 1; transform: none; }
    30%  { opacity: 1; transform: translateX(-10px); }
    100% { opacity: 0; transform: translateX(440px); }
}
@keyframes bubble-pop {
    0%   { transform: scale(0.3); }
    60%  { transform: scale(1.18); }
    100% { transform: none; }
}
@keyframes notif-bump {
    0%   { transform: none; }
    40%  { transform: scale(1.015); }
    100% { transform: none; }
}
.notif.entering { animation: notif-in 520ms cubic-bezier(0.2, 0.9, 0.3, 1) both; }
.notif.entering .notif-glyph, .notif.entering .notif-thumb, .notif.entering .notif-badge {
    animation: bubble-pop 420ms cubic-bezier(0.3, 1.4, 0.5, 1) 180ms both;
}
.notif.entering .notif-body, .notif.entering .notif-progress-row, .notif.entering .notif-actions {
    animation: row-in 300ms ease-out 320ms both;
}
.notif.leaving { animation: notif-out 260ms ease-in both; }
.notif.bump { animation: notif-bump 220ms ease-out 1; }
.notif.bump .notif-glyph, .notif.bump .notif-badge { animation: icon-wiggle 380ms ease-in-out 1; }
.notif.hover .notif-glyph, .notif.hover .notif-badge { animation: icon-wiggle 380ms ease-in-out 1; }
