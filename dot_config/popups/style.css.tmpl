/* Shared look of the small GTK popups (brightness slider, shortcut overview).
   Colors and fonts come from .chezmoidata/{palette,design}.toml. Hyprland draws
   the rounded corners, the orange border and the blur behind the window. */

window.popup {
    background-color: alpha({{ .palette.bg }}, 0.94);
    color: {{ .palette.fg }};
    font-family: "{{ .design.font_ui }}";
    font-size: 11pt;
}

.title {
    color: {{ .palette.accent }};
    font-weight: 700;
    font-size: 12pt;
}
.muted { color: {{ .palette.comment }}; }

/* ---------------------------------------------------------------- menu look */
/* Popups that sit next to the rofi menus (brightness) copy rofi/menu.rasi:
   same font, padding, centered accent title, row height */
window.popup.menu {
    background-color: alpha({{ .palette.bg }}, 0.9);
    font-family: "{{ .design.font }}";
    font-size: 12pt;
}
.menu-box { padding: 12px; }
.menu-title {
    color: {{ .palette.accent }};
    margin-top: 2px;
}

/* ---------------------------------------------------------------- slider */
.slider-row { padding: 9px 14px; }
.slider-icon {
    color: {{ .palette.accent }};
    min-width: 20px;
}
.slider-value { min-width: 40px; }
scale { padding: 0; }
scale trough {
    min-height: 4px;
    border-radius: 99px;
    background-color: alpha({{ .palette.steel }}, 0.45);
}
scale highlight {
    border-radius: 99px;
    background-color: {{ .palette.accent }};
}
scale slider {
    min-width: 14px;
    min-height: 14px;
    margin: -5px;
    border-radius: 99px;
    background-color: {{ .palette.fg }};
    box-shadow: none;
}

/* ---------------------------------------------------------------- shortcuts */
/* Frame of the big overlays, copied from rofi/overlay.rasi */
window.popup.overlay { background-color: alpha({{ .palette.bg }}, 0.9); }
.overview { padding: 28px 24px 18px 24px; }
.search-pill {
    min-width: 420px;
    padding: 12px 18px;
    border-radius: 999px;
    border: 1px solid alpha({{ .palette.steel }}, 0.6);
    background-color: {{ .palette.bg_alt }};
}
.lens {
    font-family: "{{ .design.font }}";
    font-size: 14pt;
    color: {{ .palette.comment }};
}
.lens.mirror { color: transparent; }
entry.search {
    min-height: 0;
    padding: 0;
    border: none;
    box-shadow: none;
    outline: none;
    background: none;
    color: {{ .palette.fg }};
    font-size: 13pt;
}
entry.search placeholder,
entry.search text placeholder { color: {{ .palette.comment }}; }
.hint {
    color: {{ .palette.comment }};
    font-size: 9pt;
}

.card {
    padding: 14px 16px;
    border-radius: 12px;
    background-color: alpha({{ .palette.bg_alt }}, 0.75);
}
.card-title {
    color: {{ .palette.accent }};
    font-weight: 700;
    font-size: 9pt;
    letter-spacing: 1px;
    margin-bottom: 6px;
}
.row { padding: 3px 0; }
.overview .card { font-size: 10pt; }
.desc { color: {{ .palette.fg_muted }}; }

/* Keycaps */
.key {
    font-family: "{{ .design.font }}";
    font-size: 9pt;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 6px;
    background-color: alpha({{ .palette.steel }}, 0.55);
    color: {{ .palette.fg }};
    box-shadow: inset 0 -2px alpha(black, 0.25);
}
.key.mod {
    background-color: alpha({{ .palette.accent }}, 0.18);
    color: {{ .palette.accent }};
}
.plus { color: {{ .palette.comment }}; font-size: 9pt; }

/* ---------------------------------------------------------------- pet picker */
/* One card per bar pet (~/.local/bin/pet-picker); the pet in use is framed
   in orange, the card under the mouse / keyboard gets the menu's steel tint */
.pet-card {
    padding: 8px 10px 6px 10px;
    border-radius: 12px;
    border: 1px solid transparent;
    background-color: alpha({{ .palette.steel }}, 0.18);
}
.pet-card.selected { background-color: alpha({{ .palette.steel }}, 0.35); }
.pet-card.current  { border-color: alpha({{ .palette.accent }}, 0.8); }
.pet-name {
    font-size: 10pt;
    color: {{ .palette.fg_muted }};
}
.pet-card.selected .pet-name,
.pet-card.current .pet-name { color: {{ .palette.accent }}; }

/* ---------------------------------------------------------------- list menus */
/* Wi-Fi, Bluetooth, power... (~/.local/bin/list-menu): the look of the old
   rofi menus (rofi/menu.rasi): centered rows, steel highlight, accent for
   the connected / current row */
.menu-search {
    min-height: 0;
    padding: 9px 14px;
    border: none;
    border-radius: 8px;
    box-shadow: none;
    outline: none;
    background-color: alpha({{ .palette.steel }}, 0.45);
    color: {{ .palette.fg }};
}
.menu-search placeholder,
.menu-search text placeholder { color: {{ .palette.comment }}; }
.menu-list { background: none; }
.menu-list row {
    padding: 9px 14px;
    margin-top: 2px;
    border-radius: 8px;
    outline: none;
    background: none;
    color: {{ .palette.fg }};
}
.menu-list row:first-child { margin-top: 0; }
.menu-list row.active { color: {{ .palette.accent }}; }
.menu-list row:selected {
    background-color: {{ .palette.steel }};
    color: {{ .palette.accent }};
}
.list-menu scrollbar { opacity: 0; }

/* ---------------------------------------------------------------- sound */
/* ~/.local/bin/sound-popup: sliders like the brightness popup, outputs as rows */
.sound .section, .bluetooth .section {
    color: {{ .palette.comment }};
    font-size: 10pt;
    margin: 8px 14px 2px 14px;
}
button.slider-icon {
    min-width: 20px;
    min-height: 0;
    padding: 0;
    border: none;
    box-shadow: none;
    background: none;
    color: {{ .palette.accent }};
}
button.slider-icon:hover { color: {{ .palette.fg }}; }
.slider-icon.muted, .slider-value.muted { color: {{ .palette.comment }}; }
button.slider-icon.muted image { opacity: 0.4; }
.sound .slider-row { padding: 7px 14px; }
.app-name {
    font-size: 10pt;
    color: {{ .palette.fg_muted }};
    margin: 4px 14px -6px 14px;
}
button.sound-row {
    min-height: 0;
    padding: 7px 14px;
    border: none;
    border-radius: 8px;
    box-shadow: none;
    background: none;
    color: {{ .palette.fg }};
    font-weight: normal;
}
button.sound-row:hover, button.sound-row:focus-visible { background-color: {{ .palette.steel }}; }
button.sound-row.active { color: {{ .palette.accent }}; }
.sound-sep {
    margin: 6px 14px 2px 14px;
    background-color: alpha({{ .palette.steel }}, 0.6);
}

/* ---------------------------------------------------------------- bluetooth */
/* ~/.local/bin/bluetooth-popup: rows like the sound outputs, a status line
   under each device name, on/off switch next to the title */
.bt-head { margin: 0 4px 4px 4px; }
.bt-icon {
    color: {{ .palette.accent }};
    min-width: 20px;
}
.bt-status {
    font-size: 9pt;
    color: {{ .palette.comment }};
}
button.bt-device.active .bt-status { color: {{ .palette.fg_muted }}; }
button.bt-device.busy .bt-status { color: {{ .palette.accent }}; }
.bt-note {
    color: {{ .palette.comment }};
    font-size: 10pt;
    margin: 6px 14px;
}
button.bt-more {
    min-height: 0;
    min-width: 0;
    padding: 4px 10px;
    border: none;
    border-radius: 8px;
    box-shadow: none;
    background: none;
    color: {{ .palette.comment }};
}
button.bt-more:hover, button.bt-more:focus-visible {
    background-color: {{ .palette.steel }};
    color: {{ .palette.fg }};
}
/* an opened device: framed, its address and the action buttons below */
.bt-card {
    padding-bottom: 8px;
    border-radius: 10px;
    background-color: alpha({{ .palette.steel }}, 0.25);
}
.bt-info {
    font-size: 9pt;
    color: {{ .palette.comment }};
    margin: -4px 14px 0 46px;
}
.bt-actions { margin: 0 10px; }
button.bt-action {
    min-height: 0;
    padding: 5px 8px;
    border: none;
    border-radius: 8px;
    box-shadow: none;
    background-color: alpha({{ .palette.steel }}, 0.5);
    color: {{ .palette.fg }};
    font-size: 10pt;
    font-weight: normal;
}
button.bt-action:hover, button.bt-action:focus-visible {
    background-color: {{ .palette.steel }};
    color: {{ .palette.accent }};
}
button.bt-action.danger { background-color: {{ .palette.red }}; color: {{ .palette.bg }}; }
.bt-found scrollbar { opacity: 0; }
.bluetooth switch {
    min-height: 18px;
    border: none;
    border-radius: 99px;
    background-color: alpha({{ .palette.steel }}, 0.6);
    box-shadow: none;
}
.bluetooth switch:checked { background-color: {{ .palette.accent }}; }
.bluetooth switch slider {
    min-width: 18px;
    min-height: 18px;
    margin: 2px;
    border: none;
    border-radius: 99px;
    background-color: {{ .palette.fg }};
    box-shadow: none;
}
