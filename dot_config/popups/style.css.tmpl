/* Shared look of the small GTK popups (brightness slider, shortcut overview).
   Colors and fonts come from .chezmoidata/{palette,design}.toml. Hyprland draws
   the rounded corners, the orange border and the blur behind the window. */

window.popup {
    background-color: alpha({{ .palette.bg }}, 0.94);
    color: {{ .palette.fg }};
    font-family: "{{ .design.font_ui }}";
    font-size: 11pt;
}

.title {
    color: {{ .palette.accent }};
    font-weight: 700;
    font-size: 12pt;
}
.muted { color: {{ .palette.comment }}; }

/* ---------------------------------------------------------------- menu look */
/* Popups that sit next to the rofi menus (brightness) copy rofi/menu.rasi:
   same font, padding, centered accent title, row height */
window.popup.menu {
    background-color: alpha({{ .palette.bg }}, 0.9);
    font-family: "{{ .design.font }}";
    font-size: 12pt;
}
.menu-box { padding: 12px; }
.menu-title {
    color: {{ .palette.accent }};
    margin-top: 2px;
}

/* ---------------------------------------------------------------- slider */
.slider-row { padding: 9px 14px; }
.slider-icon {
    color: {{ .palette.accent }};
    min-width: 20px;
}
.slider-value { min-width: 40px; }
scale { padding: 0; }
scale trough {
    min-height: 4px;
    border-radius: 99px;
    background-color: alpha({{ .palette.steel }}, 0.45);
}
scale highlight {
    border-radius: 99px;
    background-color: {{ .palette.accent }};
}
scale slider {
    min-width: 14px;
    min-height: 14px;
    margin: -5px;
    border-radius: 99px;
    background-color: {{ .palette.fg }};
    box-shadow: none;
}

/* ---------------------------------------------------------------- shortcuts */
/* Frame of the big overlays, copied from rofi/overlay.rasi */
window.popup.overlay { background-color: alpha({{ .palette.bg }}, 0.9); }
.overview { padding: 28px 24px 18px 24px; }
.search-pill {
    min-width: 420px;
    padding: 12px 18px;
    border-radius: 999px;
    border: 1px solid alpha({{ .palette.steel }}, 0.6);
    background-color: {{ .palette.bg_alt }};
}
.lens {
    font-family: "{{ .design.font }}";
    font-size: 14pt;
    color: {{ .palette.comment }};
}
.lens.mirror { color: transparent; }
entry.search {
    min-height: 0;
    padding: 0;
    border: none;
    box-shadow: none;
    outline: none;
    background: none;
    color: {{ .palette.fg }};
    font-size: 13pt;
}
entry.search placeholder,
entry.search text placeholder { color: {{ .palette.comment }}; }
.hint {
    color: {{ .palette.comment }};
    font-size: 9pt;
}

.card {
    padding: 14px 16px;
    border-radius: 12px;
    background-color: alpha({{ .palette.bg_alt }}, 0.75);
}
.card-title {
    color: {{ .palette.accent }};
    font-weight: 700;
    font-size: 9pt;
    letter-spacing: 1px;
    margin-bottom: 6px;
}
.row { padding: 3px 0; }
.overview .card { font-size: 10pt; }
.desc { color: {{ .palette.fg_muted }}; }

/* Keycaps */
.key {
    font-family: "{{ .design.font }}";
    font-size: 9pt;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 6px;
    background-color: alpha({{ .palette.steel }}, 0.55);
    color: {{ .palette.fg }};
    box-shadow: inset 0 -2px alpha(black, 0.25);
}
.key.mod {
    background-color: alpha({{ .palette.accent }}, 0.18);
    color: {{ .palette.accent }};
}
.plus { color: {{ .palette.comment }}; font-size: 9pt; }

/* ---------------------------------------------------------------- pet picker */
/* One card per bar pet (~/.local/bin/pet-picker); the pet in use is framed
   in orange, the card under the mouse / keyboard gets the menu's steel tint */
.pet-card {
    padding: 8px 10px 6px 10px;
    border-radius: 12px;
    border: 1px solid transparent;
    background-color: alpha({{ .palette.steel }}, 0.18);
}
.pet-card.selected { background-color: alpha({{ .palette.steel }}, 0.35); }
.pet-card.current  { border-color: alpha({{ .palette.accent }}, 0.8); }
.pet-name {
    font-size: 10pt;
    color: {{ .palette.fg_muted }};
}
.pet-card.selected .pet-name,
.pet-card.current .pet-name { color: {{ .palette.accent }}; }

/* ---------------------------------------------------------------- list menus */
/* Claude and music right click menus (~/.local/bin/list-menu): rows like the
   item rows below (accent icon column, steel highlight), accent for the
   current row; typing filters */
.menu-search {
    min-height: 0;
    padding: 9px 14px;
    border: none;
    border-radius: 8px;
    box-shadow: none;
    outline: none;
    background-color: alpha({{ .palette.steel }}, 0.45);
    color: {{ .palette.fg }};
}
.menu-search placeholder,
.menu-search text placeholder { color: {{ .palette.comment }}; }
.menu-list { background: none; }
.menu-list row {
    padding: 9px 14px;
    margin-top: 2px;
    border-radius: 8px;
    outline: none;
    background: none;
    color: {{ .palette.fg }};
}
.menu-list row:first-child { margin-top: 0; }
.menu-list row.active { color: {{ .palette.accent }}; }
.menu-list row:selected { background-color: {{ .palette.steel }}; }
.menu-info {
    color: {{ .palette.comment }};
    font-size: 10pt;
    margin: -4px 14px 0 14px;
}
.list-menu scrollbar { opacity: 0; }

/* ---------------------------------------------------------------- sound */
/* ~/.local/bin/sound-popup: sliders like the brightness popup, outputs as rows */
.menu-box .section {
    color: {{ .palette.comment }};
    font-size: 10pt;
    margin: 8px 14px 2px 14px;
}
button.slider-icon {
    min-width: 20px;
    min-height: 0;
    padding: 0;
    border: none;
    box-shadow: none;
    background: none;
    color: {{ .palette.accent }};
}
button.slider-icon:hover { color: {{ .palette.fg }}; }
.slider-icon.muted, .slider-value.muted { color: {{ .palette.comment }}; }
button.slider-icon.muted image { opacity: 0.4; }
.sound .slider-row { padding: 7px 14px; }
.app-name {
    font-size: 10pt;
    color: {{ .palette.fg_muted }};
    margin: 4px 14px -6px 14px;
}
button.sound-row {
    min-height: 0;
    padding: 7px 14px;
    border: none;
    border-radius: 8px;
    box-shadow: none;
    background: none;
    color: {{ .palette.fg }};
    font-weight: normal;
}
button.sound-row:hover, button.sound-row:focus-visible { background-color: {{ .palette.steel }}; }
button.sound-row.active { color: {{ .palette.accent }}; }
.sound-sep {
    margin: 6px 14px 2px 14px;
    background-color: alpha({{ .palette.steel }}, 0.6);
}

/* ---------------------------------------------------------------- item rows */
/* Bluetooth, Wi-Fi and power popups: rows like the sound outputs, an accent
   icon and a status line under the name; the arrow next to a row opens its
   card (info + action buttons); on/off switch next to the title */
.head { margin: 0 4px 4px 4px; }
.row-icon {
    color: {{ .palette.accent }};
    min-width: 20px;
}
.row-status {
    font-size: 9pt;
    color: {{ .palette.comment }};
}
button.device.active .row-status { color: {{ .palette.fg_muted }}; }
button.device.busy .row-status { color: {{ .palette.accent }}; }
.note {
    color: {{ .palette.comment }};
    font-size: 10pt;
    margin: 6px 14px;
}
button.more {
    min-height: 0;
    min-width: 0;
    padding: 4px 10px;
    border: none;
    border-radius: 8px;
    box-shadow: none;
    background: none;
    color: {{ .palette.comment }};
}
button.more:hover, button.more:focus-visible {
    background-color: {{ .palette.steel }};
    color: {{ .palette.fg }};
}
/* an opened device: framed, its address and the action buttons below */
.item-card {
    padding-bottom: 8px;
    border-radius: 10px;
    background-color: alpha({{ .palette.steel }}, 0.25);
}
.item-info {
    font-size: 9pt;
    color: {{ .palette.comment }};
    margin: -4px 14px 0 46px;
}
.item-actions { margin: 0 10px; }
button.item-action {
    min-height: 0;
    padding: 5px 8px;
    border: none;
    border-radius: 8px;
    box-shadow: none;
    background-color: alpha({{ .palette.steel }}, 0.5);
    color: {{ .palette.fg }};
    font-size: 10pt;
    font-weight: normal;
}
button.item-action:hover, button.item-action:focus-visible {
    background-color: {{ .palette.steel }};
    color: {{ .palette.accent }};
}
button.item-action.danger { background-color: {{ .palette.red }}; color: {{ .palette.bg }}; }
.found scrollbar { opacity: 0; }
window.popup switch {
    min-height: 18px;
    border: none;
    border-radius: 99px;
    background-color: alpha({{ .palette.steel }}, 0.6);
    box-shadow: none;
}
window.popup switch:checked { background-color: {{ .palette.accent }}; }
window.popup switch slider {
    min-width: 18px;
    min-height: 18px;
    margin: 2px;
    border: none;
    border-radius: 99px;
    background-color: {{ .palette.fg }};
    box-shadow: none;
}

/* a row that only informs (wired connection in the Wi-Fi popup) */
.sound-row.info { padding: 7px 14px; color: {{ .palette.accent }}; }
.note.error, .item-info.error { color: {{ .palette.red }}; }
button.item-action.on { color: {{ .palette.accent }}; }
button.item-action.off { color: {{ .palette.comment }}; }
/* Wi-Fi password field inside a network's card */
.item-actions entry.password { padding: 5px 10px; font-size: 10pt; }
.item-actions entry.password image { color: {{ .palette.comment }}; }

/* ---------------------------------------------------------------- segments */
/* A few choices side by side: power profiles, keyboard backlight levels */
.segments { margin: 2px 4px 4px 4px; }
button.segment {
    min-height: 0;
    padding: 6px 4px;
    border: 1px solid transparent;
    border-radius: 10px;
    box-shadow: none;
    background-color: alpha({{ .palette.steel }}, 0.25);
    color: {{ .palette.fg_muted }};
    font-weight: normal;
}
button.segment.small { padding: 3px 4px; font-size: 10pt; }
button.segment:hover, button.segment:focus-visible {
    background-color: alpha({{ .palette.steel }}, 0.6);
    color: {{ .palette.fg }};
}
button.segment.active {
    border-color: alpha({{ .palette.accent }}, 0.8);
    background-color: alpha({{ .palette.accent }}, 0.15);
    color: {{ .palette.accent }};
}
.segment-icon { font-size: 15pt; }
.segment-label { font-size: 9pt; }
.brightness .slider-row { padding: 7px 14px; }

/* ---------------------------------------------------------------- power */
/* ~/.local/bin/power-popup: battery on top, profiles, session rows */
.battery { margin: 4px 14px 6px 14px; }
.battery .item-info { margin: 0; }
.battery-icon { color: {{ .palette.accent }}; font-size: 16pt; min-width: 20px; }
.battery-level { font-size: 16pt; font-weight: 700; }
.battery-bar trough {
    min-height: 4px;
    border: none;
    border-radius: 99px;
    background-color: alpha({{ .palette.steel }}, 0.45);
}
.battery-bar block.filled { border: none; border-radius: 99px; background-color: {{ .palette.accent }}; }
.battery-bar block.empty { border: none; background: none; }
.battery.charging .battery-icon { color: {{ .palette.green }}; }
.battery.charging .battery-bar block.filled { background-color: {{ .palette.green }}; }
.battery.warning .battery-icon { color: {{ .palette.yellow }}; }
.battery.warning .battery-bar block.filled { background-color: {{ .palette.yellow }}; }
.battery.critical .battery-icon, .battery.critical .battery-level { color: {{ .palette.red }}; }
.battery.critical .battery-bar block.filled { background-color: {{ .palette.red }}; }
button.sound-row.danger, button.sound-row.danger .row-icon { color: {{ .palette.red }}; }

/* ---------------------------------------------------------------- session */
/* ~/.local/bin/session-popup: centered, greeting types itself, round buttons
   pop in one after the other, wiggle under the mouse, pulse red when they ask */
.session-box { padding: 26px 28px 20px 28px; }
.session-hello {
    font-size: 16pt;
    color: {{ .palette.fg }};
}
.session-up {
    font-size: 9pt;
    color: {{ .palette.comment }};
    margin-bottom: 16px;
}
button.session-button {
    min-height: 0;
    min-width: 0;
    padding: 0;
    border: none;
    box-shadow: none;
    background: none;
    outline: none;
}
.session-circle {
    min-width: 72px;
    min-height: 72px;
    border-radius: 99px;
    font-size: 22pt;
    background-color: alpha({{ .palette.steel }}, 0.3);
    color: {{ .palette.accent }};
    transition: background-color 160ms ease, color 160ms ease, transform 200ms ease,
                box-shadow 200ms ease;
}
.session-label {
    font-size: 10pt;
    color: {{ .palette.fg_muted }};
    transition: color 160ms ease;
}
.session-key { font-size: 8pt; padding: 0 6px; opacity: 0.7; }

/* pop in, one after the other */
@keyframes session-pop {
    0%   { opacity: 0; transform: translateY(14px) scale(0.6); }
    70%  { opacity: 1; transform: translateY(-3px) scale(1.06); }
    100% { opacity: 1; transform: none; }
}
button.session-button.enter { animation: session-pop 380ms ease-out both; }
.session-row button.session-button.enter:nth-child(2) { animation-delay: 50ms; }
.session-row button.session-button.enter:nth-child(3) { animation-delay: 100ms; }
.session-row button.session-button.enter:nth-child(4) { animation-delay: 150ms; }
.session-row button.session-button.enter:nth-child(5) { animation-delay: 200ms; }

/* in focus / under the mouse: orange, a bit bigger, a little wiggle */
@keyframes session-wiggle {
    0%   { transform: scale(1.1) rotate(0deg); }
    30%  { transform: scale(1.1) rotate(-9deg); }
    60%  { transform: scale(1.1) rotate(6deg); }
    100% { transform: scale(1.1) rotate(0deg); }
}
button.session-button:focus .session-circle {
    background-color: {{ .palette.accent }};
    color: {{ .palette.bg }};
    transform: scale(1.1);
    box-shadow: 0 0 18px alpha({{ .palette.accent }}, 0.45);
    animation: session-wiggle 420ms ease-in-out 1;
}
button.session-button:focus .session-label { color: {{ .palette.fg }}; }

/* asks first: red, pulsing */
@keyframes session-pulse {
    0%   { box-shadow: 0 0 0 0 alpha({{ .palette.red }}, 0.6); }
    100% { box-shadow: 0 0 0 14px alpha({{ .palette.red }}, 0); }
}
button.session-button.confirm .session-circle {
    background-color: {{ .palette.red }};
    color: {{ .palette.bg }};
    transform: scale(1.1);
    animation: session-pulse 900ms ease-out infinite;
}
button.session-button.confirm .session-label { color: {{ .palette.red }}; }
.session-caption {
    margin-top: 14px;
    font-size: 10pt;
    color: {{ .palette.comment }};
}

/* ---------------------------------------------------------------- task */
/* ~/.local/bin/task-popup (SUPER+T): a task for Claude, centered like the
   session popup; round tag buttons in their own color, the chosen one wiggles */
.task-box { padding: 24px 28px 18px 28px; }
.task-hello { font-size: 16pt; }
.task-sub {
    font-size: 9pt;
    color: {{ .palette.comment }};
    margin-bottom: 12px;
}
.task-entry { font-size: 12pt; padding: 11px 16px; margin-bottom: 4px; }
.task-details { font-size: 10pt; padding: 7px 16px; }
.task-entry, .task-details {
    transition: box-shadow 160ms ease, background-color 160ms ease;
}
.task-entry:focus-within, .task-details:focus-within {
    box-shadow: inset 0 0 0 1px alpha({{ .palette.accent }}, 0.6);
}
.task-entry.shake {
    animation: shake 380ms ease-in-out 1;
    box-shadow: inset 0 0 0 1px alpha({{ .palette.red }}, 0.8);
}
.task-row { margin-top: 16px; }
button.task-tag {
    min-height: 0;
    min-width: 0;
    padding: 0;
    border: none;
    box-shadow: none;
    background: none;
    outline: none;
}
.task-circle {
    min-width: 58px;
    min-height: 58px;
    border-radius: 99px;
    font-size: 19pt;
    background-color: alpha({{ .palette.steel }}, 0.3);
    transition: background-color 160ms ease, color 160ms ease, transform 200ms ease,
                box-shadow 200ms ease;
}
.task-label {
    font-size: 10pt;
    color: {{ .palette.fg_muted }};
    transition: color 160ms ease;
}
.task-key { font-size: 7pt; padding: 0 5px; opacity: 0.7; }
{{- range $tag, $color := dict "bug" .palette.red "verbesserung" .palette.blue "idee" .palette.yellow }}
button.task-tag.{{ $tag }} .task-circle { color: {{ $color }}; }
button.task-tag.{{ $tag }}:hover .task-circle { background-color: alpha({{ $color }}, 0.2); }
button.task-tag.{{ $tag }}.chosen .task-circle {
    background-color: {{ $color }};
    color: {{ $.palette.bg }};
    transform: scale(1.1);
    box-shadow: 0 0 18px alpha({{ $color }}, 0.45);
    animation: session-wiggle 420ms ease-in-out 1;
}
button.task-tag.{{ $tag }}.chosen .task-label { color: {{ $color }}; }
{{- end }}
button.task-tag.enter { animation: session-pop 380ms ease-out both; }
.task-row button.task-tag.enter:nth-child(2) { animation-delay: 60ms; }
.task-row button.task-tag.enter:nth-child(3) { animation-delay: 120ms; }
/* the chosen one keeps its wiggle when it pops in */
button.task-tag.enter.chosen .task-circle { animation-delay: 380ms; }
.task-caption {
    margin-top: 12px;
    font-size: 10pt;
    color: {{ .palette.comment }};
}
.task-caption.error { color: {{ .palette.red }}; }
/* saved: the title turns green and hops, the chosen tag hops along */
window.task.saved .task-hello { color: {{ .palette.green }}; animation: hop 420ms ease-out 1; }
window.task.saved button.task-tag.chosen .task-circle { animation: hop 420ms ease-out 1; }

/* ---------------------------------------------------------------- timer */
/* ~/.local/bin/timer-popup (SUPER+SHIFT+T, bar countdown): a kitchen timer
   dial (drawn in code, orange arc + knob), round preset buttons that pop in,
   running timers as cards with a slim progress bar */
.timer-box { padding: 24px 28px 16px 28px; }
.timer-hello { font-size: 16pt; }
.timer-sub { font-size: 9pt; color: {{ .palette.comment }}; margin-bottom: 4px; }
.timer-face { margin: 4px 0 10px 0; }
.timer-icon { font-family: "JetBrainsMono Nerd Font Propo"; font-size: 17pt; color: {{ .palette.accent }}; }
.timer-digits {
    font-family: "{{ .design.font }}";
    font-size: 30pt;
    font-weight: 800;
    color: {{ .palette.fg }};
}
.timer-what { font-size: 10pt; color: {{ .palette.fg_muted }}; }
.timer-face.live .timer-icon { animation: icon-wiggle 1.2s ease-in-out infinite; }
.timer-dial.nudge { animation: hop 220ms ease-out 1; }
.timer-entry { font-size: 12pt; padding: 11px 16px; transition: box-shadow 160ms ease; }
.timer-entry:focus-within { box-shadow: inset 0 0 0 1px alpha({{ .palette.accent }}, 0.6); }
.timer-entry.shake {
    animation: shake 380ms ease-in-out 1;
    box-shadow: inset 0 0 0 1px alpha({{ .palette.red }}, 0.8);
}
.timer-row { margin-top: 14px; }
button.timer-preset {
    min-height: 0;
    min-width: 0;
    padding: 0;
    border: none;
    box-shadow: none;
    background: none;
    outline: none;
}
.timer-circle {
    min-width: 51px;
    min-height: 48px;
    padding: 2px 0 0 1px;
    border-radius: 99px;
    font-family: "JetBrainsMono Nerd Font Propo";
    font-size: 17pt;
    background-color: alpha({{ .palette.steel }}, 0.3);
    transition: background-color 160ms ease, color 160ms ease, transform 200ms ease,
                box-shadow 200ms ease;
}
.timer-label { font-size: 9pt; color: {{ .palette.fg_muted }}; transition: color 160ms ease; }
.timer-mins { font-size: 7pt; color: {{ .palette.comment }}; }
{{- range $name, $color := dict "yellow" .palette.yellow "green" .palette.green "accent" .palette.accent "red" .palette.red "cyan" .palette.cyan "magenta" .palette.magenta }}
button.timer-preset.tp-{{ $name }} .timer-circle { color: {{ $color }}; }
button.timer-preset.tp-{{ $name }}:hover .timer-circle,
button.timer-preset.tp-{{ $name }}.picked .timer-circle {
    background-color: {{ $color }};
    color: {{ $.palette.bg }};
    transform: scale(1.1);
    box-shadow: 0 0 16px alpha({{ $color }}, 0.45);
    animation: session-wiggle 420ms ease-in-out 1;
}
button.timer-preset.tp-{{ $name }}:hover .timer-label { color: {{ $color }}; }
{{- end }}
button.timer-preset.enter { animation: session-pop 380ms ease-out both; }
{{- range $i := until 6 }}
.timer-row button.timer-preset.enter:nth-child({{ add $i 1 }}) { animation-delay: {{ mul $i 45 }}ms; }
{{- end }}
button.timer-preset.picked .timer-circle { animation: hop 420ms ease-out 1; }
.timer-list { margin-top: 14px; }
.timer-card {
    padding: 8px 8px 8px 14px;
    border-radius: 4px 12px 12px 4px;
    border-left: 3px solid {{ .palette.accent }};
    background-color: alpha({{ .palette.bg_alt }}, 0.9);
    animation: card-in 220ms ease-out both;
}
.timer-card.paused { border-left-color: {{ .palette.comment }}; }
.timer-card-icon { font-family: "JetBrainsMono Nerd Font Propo"; font-size: 14pt; color: {{ .palette.accent }}; }
.timer-card.paused .timer-card-icon, .timer-card.paused .timer-card-time { color: {{ .palette.comment }}; }
.timer-card-name { font-size: 10pt; font-weight: 700; }
.timer-card-time { font-family: "{{ .design.font }}"; font-size: 10pt; font-weight: 700; color: {{ .palette.accent }}; }
progressbar.timer-card-bar trough {
    min-height: 4px;
    border-radius: 99px;
    background-color: alpha({{ .palette.steel }}, 0.4);
}
progressbar.timer-card-bar progress {
    min-height: 4px;
    border-radius: 99px;
    background-color: {{ .palette.accent }};
}
.timer-card.paused progressbar.timer-card-bar progress { background-color: {{ .palette.comment }}; }
button.timer-card-btn {
    min-width: 30px;
    min-height: 30px;
    padding: 0;
    border-radius: 99px;
    font-family: "JetBrainsMono Nerd Font Propo";
    font-size: 12pt;
    color: {{ .palette.fg_muted }};
    background: none;
    box-shadow: none;
}
button.timer-card-btn:hover { color: {{ .palette.accent }}; background-color: alpha({{ .palette.steel }}, 0.35); }
button.timer-card-btn:last-child:hover { color: {{ .palette.red }}; }
button.timer-ringing {
    padding: 9px 14px;
    border-radius: 12px;
    background-color: alpha({{ .palette.accent }}, 0.18);
    box-shadow: inset 0 0 0 1px alpha({{ .palette.accent }}, 0.6);
    animation: session-wiggle 600ms ease-in-out 2;
}
.timer-ringing-text { color: {{ .palette.accent }}; font-weight: 700; }
window.timer.saved .timer-hello { color: {{ .palette.green }}; animation: hop 420ms ease-out 1; }
window.timer.saved .timer-dial { animation: hop 420ms ease-out 1; }

/* ---------------------------------------------------------------- calendar */
/* ~/.local/bin/calendar-popup (bar date, SUPER+K): month left, the
   chosen day right. Colors per calendar (Nextcloud's own) come from the popup
   at runtime as classes cal-c<i> (text), cal-bg-c<i> (dots); the rest is here. */
/* opaque: a busy window behind (browser text) must not shine through */
window.popup.calendar, window.popup.event { background-color: {{ .palette.bg }}; }
.cal-box { padding: 18px 22px 14px 22px; }
.cal-head { margin-bottom: 14px; }
.cal-title { font-size: 16pt; font-weight: 700; margin: 0 4px; }
button.cal-nav {
    min-width: 34px;
    min-height: 34px;
    padding: 0;
    border-radius: 99px;
    font-size: 14pt;
    color: {{ .palette.fg_muted }};
    background: none;
    transition: background-color 150ms ease, color 150ms ease, transform 150ms ease;
}
button.cal-nav:hover {
    background-color: alpha({{ .palette.steel }}, 0.5);
    color: {{ .palette.accent }};
    animation: session-wiggle 380ms ease-in-out 1;
}
button.cal-nav:active { transform: scale(0.85); }
.cal-legend { margin-left: 8px; }
/* calendar avatars (top right): round like the task popup's tags, filled =
   shown, hollow = hidden; they wiggle under the mouse */
button.cal-avatar {
    min-height: 0;
    min-width: 0;
    padding: 0;
    border: none;
    box-shadow: none;
    background: none;
    outline: none;
}
.cal-avatar-circle {
    /* 38 x 38 in all: the padding counts on top of min-width / min-height */
    min-width: 37px;
    min-height: 36px;
    border-radius: 99px;
    /* the Propo variant: its icons are as wide as they look, so they sit in the
       middle; the mono fallback lets them stick out to the right */
    font-family: "JetBrainsMono Nerd Font Propo";
    font-size: 15pt;
    /* optical centering: the icons sit a touch high and left in their box */
    padding: 2px 0 0 1px;
    background-color: alpha({{ .palette.steel }}, 0.3);
    transition: background-color 180ms ease, color 180ms ease, box-shadow 180ms ease,
                transform 200ms ease;
}
.cal-avatar-circle.heart { padding-top: 4px; min-height: 34px; }
.cal-avatar-name { font-size: 8pt; color: {{ .palette.comment }}; transition: color 180ms ease; }
button.cal-avatar:hover .cal-avatar-circle { animation: session-wiggle 420ms ease-in-out 1; }
button.cal-avatar:not(.on) .cal-avatar-circle { opacity: 0.55; }
button.cal-avatar:active .cal-avatar-circle { transform: scale(0.85); }
.cal-season {
    font-size: 15pt;
    color: {{ .palette.accent }};
    animation: cal-sway 3s steps(12) infinite alternate;
}
@keyframes cal-sway {
    from { transform: rotate(-10deg); }
    to   { transform: rotate(10deg); }
}
.cal-greet { font-size: 9pt; color: {{ .palette.comment }}; margin-top: -2px; }
button.cal-today-btn {
    min-height: 0;
    padding: 6px 14px;
    border-radius: 99px;
    border: 1px solid alpha({{ .palette.accent }}, 0.6);
    background: none;
    color: {{ .palette.accent }};
    font-size: 10pt;
    transition: background-color 150ms ease, color 150ms ease;
}
button.cal-today-btn:hover { background-color: {{ .palette.accent }}; color: {{ .palette.bg }}; }

/* the month, like Google's month view: a quiet grid of cells, each day with
   its events as lines (filled bars: all-day / several days, tinted pills:
   with a time); today = the number in an orange circle */
.cal-month { min-width: 700px; }
.cal-head { margin-bottom: 10px; }
.cal-weekdays { margin-bottom: 2px; }
.cal-wd {
    font-size: 8pt;
    font-weight: 800;
    letter-spacing: 2px;
    color: {{ .palette.comment }};
    padding: 4px 0;
}
.cal-wd.weekend { color: {{ .palette.fg_muted }}; }
.cal-grid {
    border-radius: 14px;
    background-color: alpha({{ .palette.steel }}, 0.28);   /* shows as the grid lines */
    padding: 1px;
}
button.cal-day {
    min-width: 96px;
    min-height: 88px;
    margin: 1px;
    padding: 4px 4px 3px 4px;
    border-radius: 3px;
    border: none;
    background-color: {{ .palette.bg }};
    box-shadow: none;
    transition: background-color 140ms ease;
}
button.cal-day.weekend { background-color: mix({{ .palette.bg }}, {{ .palette.bg_alt }}, 0.45); }
.cal-grid > button.cal-day:nth-child(1) { border-top-left-radius: 13px; }
button.cal-day:hover { background-color: mix({{ .palette.bg }}, {{ .palette.steel }}, 0.18); }
button.cal-day.selected {
    background-color: mix({{ .palette.bg }}, {{ .palette.steel }}, 0.3);
    box-shadow: inset 0 0 0 1px alpha({{ .palette.accent }}, 0.55);
}
.cal-num {
    min-width: 24px;
    min-height: 24px;
    border-radius: 99px;
    font-size: 10pt;
    font-weight: 700;
    color: {{ .palette.fg }};
    margin-bottom: 1px;
}
button.cal-day.past .cal-num { color: {{ .palette.fg_muted }}; font-weight: normal; }
button.cal-day.today .cal-num {
    background-color: {{ .palette.accent }};
    color: {{ .palette.bg }};
    font-weight: 800;
    animation: cal-glow 1.8s steps(8) infinite alternate;
}
@keyframes cal-glow {
    from { box-shadow: 0 0 4px alpha({{ .palette.accent }}, 0.3); }
    to   { box-shadow: 0 0 14px alpha({{ .palette.accent }}, 0.75); }
}
button.cal-day:hover:not(.today) .cal-num { animation: hop 280ms ease-out 1; }
button.cal-day.other .cal-num { color: alpha({{ .palette.comment }}, 0.5); font-weight: normal; }
button.cal-day.other .cal-chip { opacity: 0.4; }

.cal-chip {
    font-size: 8pt;
    padding: 1px 6px;
    border-radius: 6px;
    min-height: 15px;
}
.cal-chip.bar { color: {{ .palette.bg }}; font-weight: 700; }
/* a bar that goes on: square ends that reach into the neighbour cell */
.cal-chip.bar.cont-left  { border-top-left-radius: 0; border-bottom-left-radius: 0; margin-left: -6px; }
.cal-chip.bar.cont-right { border-top-right-radius: 0; border-bottom-right-radius: 0; margin-right: -6px; }
.cal-chip.timed { font-weight: 600; transition: background-color 140ms ease; }
.cal-chip.bar:hover { box-shadow: inset 0 0 0 99px alpha(white, 0.12); }
/* drag and drop: the dragged event fades, target days open a dashed frame,
   a dropped event lands with a hop */
.cal-chip.dragging, .cal-card.dragging { opacity: 0.35; }
window.calendar.dragging button.cal-day:hover { background-color: {{ .palette.bg }}; }
button.cal-day.drop {
    background-color: alpha({{ .palette.accent }}, 0.12);
    box-shadow: inset 0 0 0 2px alpha({{ .palette.accent }}, 0.8);
}
button.cal-day.drop .cal-num { animation: hop 300ms ease-out infinite; }
button.cal-day.landed .cal-chip { animation: hop 380ms ease-out 1; }
.cal-chip.timed.done { opacity: 0.55; }
.cal-more { font-size: 8pt; color: {{ .palette.comment }}; padding-left: 6px; }
/* the small color dot in the "Danach" rows */
.cal-dot { min-width: 8px; min-height: 8px; border-radius: 99px; }

/* entrance: quick, the whole month at once (a staggered wave felt slow) */
@keyframes cal-in {
    0%   { opacity: 0; transform: translateY(6px) scale(0.985); }
    100% { opacity: 1; transform: none; }
}
.cal-grid.enter { animation: cal-in 170ms ease-out both; }
@keyframes cal-bounce {
    0%   { transform: scale(1); }
    40%  { transform: scale(0.96); }
    100% { transform: scale(1); }
}
button.cal-day.bounce .cal-num { animation: hop 260ms ease-out 1; }

/* the chosen day */
.cal-day-pane {
    min-width: 300px;
    padding-left: 22px;
    border-left: 1px solid alpha({{ .palette.steel }}, 0.35);
}
.cal-day-head { margin-bottom: 14px; }
.cal-tile {
    min-width: 58px;
    padding: 0 0 6px 0;
    border-radius: 14px;
    background-color: {{ .palette.bg_alt }};
    border: 1px solid alpha({{ .palette.steel }}, 0.6);
}
.cal-tile-month {
    padding: 3px 0;
    border-radius: 13px 13px 0 0;
    background-color: alpha({{ .palette.steel }}, 0.7);
    font-size: 8pt;
    font-weight: 800;
    letter-spacing: 2px;
    color: {{ .palette.fg }};
}
.cal-tile-day { font-size: 22pt; font-weight: 800; margin-top: 2px; }
.cal-tile.is-today { border-color: {{ .palette.accent }}; }
.cal-tile.is-today .cal-tile-month { background-color: {{ .palette.accent }}; color: {{ .palette.bg }}; }
.cal-tile.is-today .cal-tile-day { color: {{ .palette.accent }}; }
@keyframes cal-flip {
    0%   { transform: rotate(-8deg) scale(0.8); opacity: 0.2; }
    60%  { transform: rotate(4deg) scale(1.08); opacity: 1; }
    100% { transform: none; }
}
.cal-tile.flip { animation: cal-flip 360ms ease-out 1; }
.cal-day-title { font-size: 15pt; font-weight: 700; }
.cal-day-sub { font-size: 9pt; color: {{ .palette.comment }}; }
.cal-more-events { font-size: 9pt; color: {{ .palette.comment }}; margin: 2px 0 0 4px; }

.cal-card {
    padding: 9px 12px 9px 12px;
    border-radius: 4px 12px 12px 4px;
    border-left: 4px solid {{ .palette.steel }};
    background-color: alpha({{ .palette.bg_alt }}, 0.85);
    transition: background-color 160ms ease, opacity 200ms ease, transform 200ms ease;
}
.cal-card-icon { font-size: 9pt; color: {{ .palette.comment }}; }
.cal-card-time { font-size: 9pt; color: {{ .palette.fg_muted }}; }
.cal-card-flag { font-size: 8pt; color: {{ .palette.comment }}; }
.cal-card-title { font-size: 11pt; font-weight: 700; }
.cal-card-owner {
    font-size: 12pt;
    min-width: 28px;
    min-height: 28px;
    border-radius: 99px;
}
.cal-card:hover .cal-card-owner { animation: session-wiggle 420ms ease-in-out 1; }
.cal-card:hover .cal-card-title { color: {{ .palette.accent }}; }
.cal-card-title { transition: color 140ms ease; }
.cal-card-loc { font-size: 9pt; color: {{ .palette.comment }}; }
.cal-badge {
    font-size: 8pt;
    font-weight: 700;
    padding: 1px 8px;
    border-radius: 99px;
    color: {{ .palette.bg }};
    background-color: alpha({{ .palette.fg_muted }}, 0.85);
}
.cal-card.running .cal-badge { background-color: {{ .palette.accent }}; }
.cal-card.running { background-color: alpha({{ .palette.accent }}, 0.1); }
.cal-card.done { opacity: 0.5; }
.cal-card.done .cal-card-title { text-decoration: line-through; }
progressbar.cal-progress { margin-top: 4px; }
progressbar.cal-progress trough {
    min-height: 4px;
    border-radius: 99px;
    background-color: alpha({{ .palette.steel }}, 0.45);
}
progressbar.cal-progress progress { min-height: 4px; border-radius: 99px; }
button.cal-trash {
    min-height: 0;
    min-width: 0;
    padding: 1px 6px;
    border-radius: 8px;
    font-size: 10pt;
    color: transparent;
    background: none;
    transition: color 150ms ease, background-color 150ms ease;
}
.cal-card:hover button.cal-trash { color: {{ .palette.comment }}; }
.cal-card:hover button.cal-trash:hover { color: {{ .palette.red }}; background-color: alpha({{ .palette.red }}, 0.15); }
button.cal-trash.danger, .cal-card:hover button.cal-trash.danger {
    color: {{ .palette.bg }};
    background-color: {{ .palette.red }};
    font-size: 9pt;
    font-weight: 700;
    animation: session-pulse 900ms ease-out infinite;
}
.cal-card.arming { box-shadow: inset 0 0 0 1px alpha({{ .palette.red }}, 0.5); }
@keyframes cal-leave {
    to { opacity: 0; transform: translateX(40px) scale(0.9); }
}
.cal-card.leaving { animation: cal-leave 250ms ease-in both; }
@keyframes cal-card-in {
    0%   { opacity: 0; transform: translateX(18px); }
    100% { opacity: 1; transform: none; }
}
{{- range $i := until 8 }}
.cal-card.pop.cp-{{ $i }} { animation: cal-card-in 220ms cubic-bezier(0.2, 0.9, 0.3, 1.2) {{ mul $i 35 }}ms both; }
{{- end }}

.cal-empty { padding: 18px 0 14px 0; }
.cal-empty-icon { font-size: 30pt; color: {{ .palette.accent }}; }
.cal-empty-title { font-size: 12pt; font-weight: 700; }
.cal-empty-sub { font-size: 9pt; color: {{ .palette.comment }}; }
@keyframes cal-float {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-5px); }
}
.cal-empty.pop { animation: cal-card-in 300ms ease-out both; }
.cal-empty .cal-empty-icon { animation: cal-float 2.4s steps(12) infinite; }

.cal-section {
    margin: 14px 0 4px 2px;
    font-size: 8pt;
    font-weight: 800;
    letter-spacing: 2px;
    color: {{ .palette.comment }};
}
button.cal-after {
    min-height: 0;
    padding: 4px 8px;
    border-radius: 8px;
    background: none;
    font-weight: normal;
    transition: background-color 150ms ease;
}
button.cal-after:hover { background-color: alpha({{ .palette.steel }}, 0.35); }
.cal-after-date { font-size: 9pt; color: {{ .palette.fg_muted }}; }
.cal-after-time { font-size: 9pt; color: {{ .palette.comment }}; }
.cal-after-title { font-size: 10pt; }
button.cal-add {
    margin-top: 12px;
    min-height: 0;
    padding: 9px 12px;
    border-radius: 12px;
    border: 1px dashed alpha({{ .palette.accent }}, 0.55);
    background: none;
    color: {{ .palette.accent }};
    font-size: 10pt;
    font-weight: normal;
    transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
}
button.cal-add:hover {
    background-color: {{ .palette.accent }};
    border-color: {{ .palette.accent }};
    color: {{ .palette.bg }};
}
.cal-add-icon { font-size: 12pt; }
button.cal-add:hover .cal-add-icon { animation: spin 500ms ease-out 1; }
.cal-add-key { font-size: 7pt; padding: 0 5px; opacity: 0.7; }
.cal-hints { margin-top: 14px; }
.cal-key { font-size: 7pt; padding: 0 5px; opacity: 0.75; }
.cal-hint { font-size: 8pt; color: {{ .palette.comment }}; margin-left: 2px; }

/* ---------------------------------------------------------------- event */
/* ~/.local/bin/event-popup (SUPER+SHIFT+K): a new event, "Was?" + "Wann?". Same
   build as the task popup; recognized words light up as chips, a ticket
   shows what will be saved, round buttons pick whose calendar */
.event-box { padding: 24px 28px 16px 28px; }
.event-hello { font-size: 16pt; }
.event-sub { font-size: 9pt; color: {{ .palette.comment }}; margin-bottom: 12px; }
.event-entry { font-size: 13pt; padding: 12px 16px; }
.event-when { font-size: 11pt; padding: 9px 16px; margin-top: 4px; }
.event-place { font-size: 10pt; padding: 7px 16px; margin-top: 4px; }
.event-entry, .event-when, .event-place { transition: box-shadow 160ms ease; }
.event-entry:focus-within, .event-when:focus-within, .event-place:focus-within {
    box-shadow: inset 0 0 0 1px alpha({{ .palette.accent }}, 0.6);
}
.event-entry.shake {
    animation: shake 380ms ease-in-out 1;
    box-shadow: inset 0 0 0 1px alpha({{ .palette.red }}, 0.8);
}
.event-chips { margin: 6px 4px 2px 4px; }
@keyframes chip-in {
    0%   { opacity: 0; transform: scale(0.5); }
    70%  { transform: scale(1.12); }
    100% { opacity: 1; transform: none; }
}
.event-chip {
    font-size: 9pt;
    padding: 2px 10px;
    border-radius: 99px;
    color: {{ .palette.accent }};
    background-color: alpha({{ .palette.accent }}, 0.15);
    border: 1px solid alpha({{ .palette.accent }}, 0.45);
    animation: chip-in 260ms ease-out both;
}
/* words under "Wann?" the parser could not place */
.event-chip.unknown {
    color: {{ .palette.comment }};
    background-color: transparent;
    border-color: alpha({{ .palette.comment }}, 0.45);
    text-decoration: line-through;
}
.event-ticket {
    margin-top: 14px;
    padding: 12px 16px;
    border-radius: 4px 14px 14px 4px;
    border-left: 4px solid {{ .palette.steel }};
    background-color: alpha({{ .palette.bg_alt }}, 0.9);
    transition: border-color 200ms ease;
}
.event-tile { min-width: 54px; }
.event-t-title { font-size: 13pt; font-weight: 700; }
.event-t-title.placeholder { color: {{ .palette.comment }}; }
.event-t-when { font-size: 10pt; color: {{ .palette.fg_muted }}; }
.event-t-until { font-size: 9pt; color: {{ .palette.accent }}; }
/* the week preview: a strip of the month view, the new event glows in it */
.event-week { margin-top: 10px; }
.event-day {
    min-height: 74px;
    margin: 1px;
    padding: 4px 3px 3px 3px;
    border-radius: 3px;
    background-color: {{ .palette.bg }};
}
.event-day.weekend { background-color: mix({{ .palette.bg }}, {{ .palette.bg_alt }}, 0.45); }
.event-week > .event-day:first-child { border-top-left-radius: 13px; border-bottom-left-radius: 13px; }
.event-week > .event-day:last-child { border-top-right-radius: 13px; border-bottom-right-radius: 13px; }
.event-day.selected { background-color: mix({{ .palette.bg }}, {{ .palette.steel }}, 0.3); }
.event-wd { font-size: 7pt; font-weight: 800; color: {{ .palette.comment }}; }
.event-day .cal-num { min-width: 20px; min-height: 20px; font-size: 9pt; }
.event-day.past .cal-num { color: {{ .palette.fg_muted }}; font-weight: normal; }
.event-day.today .cal-num { background-color: {{ .palette.accent }}; color: {{ .palette.bg }}; }
.event-day .cal-chip { font-size: 7pt; padding: 1px 4px; min-height: 13px; }
.event-day .cal-chip.bar.cont-left  { margin-left: -5px; }
.event-day .cal-chip.bar.cont-right { margin-right: -5px; }
.event-day .cal-chip:not(.new) { opacity: 0.75; }
.event-day .cal-chip.timed.done { opacity: 0.45; }
.event-week.enter { animation: cal-in 170ms ease-out both; }
.event-row { margin-top: 16px; }
button.event-cal {
    min-height: 0;
    min-width: 0;
    padding: 0;
    border: none;
    box-shadow: none;
    background: none;
    outline: none;
}
.event-circle {
    /* centered like .cal-avatar-circle (Propo font, optical nudge), 58 x 58 in all */
    min-width: 57px;
    min-height: 55px;
    padding: 3px 0 0 1px;
    border-radius: 99px;
    font-family: "JetBrainsMono Nerd Font Propo";
    font-size: 21pt;
    background-color: alpha({{ .palette.steel }}, 0.3);
    transition: background-color 160ms ease, color 160ms ease, transform 200ms ease,
                box-shadow 200ms ease;
}
.event-circle.heart { padding-top: 6px; min-height: 52px; }
.event-label { font-size: 10pt; color: {{ .palette.fg_muted }}; transition: color 160ms ease; }
button.event-cal.chosen .event-circle {
    transform: scale(1.1);
    animation: session-wiggle 420ms ease-in-out 1;
}
button.event-cal.enter { animation: session-pop 380ms ease-out both; }
.event-row button.event-cal.enter:nth-child(2) { animation-delay: 70ms; }
button.event-cal.enter.chosen .event-circle { animation-delay: 380ms; }
.event-alarms { margin-top: 14px; }
.event-alarm-icon { color: {{ .palette.comment }}; margin-right: 4px; }
button.event-alarm { padding: 3px 12px; }
window.event.saved .event-hello { color: {{ .palette.green }}; animation: hop 420ms ease-out 1; }
window.event.saved .event-ticket { animation: hop 420ms ease-out 1; border-left-color: {{ .palette.green }}; }

/* ---------------------------------------------------------------- motion */
/* The same small motions in every popup. Entrance (~/.local/lib/popup/resident.py
   animate_in): the window gets class "enter" for a moment and its rows are
   numbered in-0..in-11, so they slide in one after the other. */
@keyframes row-in {
    0%   { opacity: 0; transform: translateY(8px); }
    100% { opacity: 1; transform: none; }
}
{{- range $i := until 12 }}
window.enter .in-{{ $i }} { animation: row-in 260ms cubic-bezier(0.2, 0.9, 0.3, 1.15) {{ mul $i 28 }}ms both; }
{{- end }}

/* row icons wiggle under the mouse / keyboard */
@keyframes icon-wiggle {
    0%   { transform: none; }
    30%  { transform: rotate(-12deg) scale(1.15); }
    65%  { transform: rotate(8deg) scale(1.15); }
    100% { transform: none; }
}
button.sound-row:hover .row-icon, button.sound-row:focus-visible .row-icon,
button.sound-row:hover .text-icon, button.sound-row:focus-visible .text-icon,
.menu-list row:selected .row-icon,
button.segment:hover .segment-icon {
    animation: icon-wiggle 380ms ease-in-out 1;
}
.text-icon { min-width: 20px; }

/* something is running: the status breathes, search icons turn */
@keyframes breathe {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.35; }
}
@keyframes spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
}
button.device.busy .row-status, button.device.busy .row-icon, .busy-text {
    animation: breathe 1.4s ease-in-out infinite;
}
.spin { animation: spin 1s linear infinite; }

/* a card unfolds; a wrong password shakes its head */
@keyframes card-in {
    0%   { opacity: 0; transform: scale(0.96) translateY(-4px); }
    100% { opacity: 1; transform: none; }
}
@keyframes shake {
    0%, 100% { transform: none; }
    20% { transform: translateX(-7px); }
    40% { transform: translateX(6px); }
    60% { transform: translateX(-4px); }
    80% { transform: translateX(2px); }
}
.item-card.opening { animation: card-in 220ms ease-out both; }
.item-card.shake { animation: shake 380ms ease-in-out 1; }

/* "Sure?" pulses red like the session popup */
button.item-action.danger { animation: session-pulse 900ms ease-out infinite; }

/* buttons ease between states */
button.sound-row, button.item-action, button.segment, button.more, .menu-list row {
    transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
}
button.item-action:active, button.segment:active, button.sound-row:active {
    transform: scale(0.97);
}
@keyframes seg-pop {
    0%   { transform: scale(0.92); }
    60%  { transform: scale(1.05); }
    100% { transform: none; }
}
button.segment.active { animation: seg-pop 260ms ease-out 1; }

/* switches slide, slider knobs grow under the finger */
window.popup switch, window.popup switch slider {
    transition: background-color 200ms ease, margin 200ms ease;
}
scale slider { transition: transform 150ms ease; }
scale:hover slider, scale:active slider { transform: scale(1.3); }

/* muting shakes the icon */
@keyframes mute-shake {
    0%, 100% { transform: none; }
    25% { transform: rotate(-14deg); }
    50% { transform: rotate(10deg); }
    75% { transform: rotate(-5deg); }
}
button.slider-icon.muted { animation: mute-shake 320ms ease-in-out 1; }

/* battery: the fill shimmers while charging, the icon pulses when low */
@keyframes charge-shimmer {
    0%, 100% { background-color: {{ .palette.green }}; }
    50%      { background-color: {{ .palette.green_bright }}; }
}
.battery.charging .battery-bar block.filled { animation: charge-shimmer 1.6s ease-in-out infinite; }
.battery.critical .battery-icon { animation: breathe 1.2s ease-in-out infinite; }

/* pet picker: the chosen pet hops */
@keyframes hop {
    0%, 100% { transform: none; }
    40% { transform: translateY(-5px); }
}
.pet-card.selected { animation: hop 300ms ease-out 1; }

/* ---------------------------------------------------------------- notifications */
/* ~/.local/bin/notifications: compact cards in the top right corner below the
   bar. A small header (app glyph on a rounded square in its palette color,
   app name, age, x on hover), then the summary and body; pictures sit on the
   right. A card swings in from the screen edge, the icon pops, the summary
   types itself with the orange caret, a hairline counts down along the bottom
   (pauses under the mouse), it slides out. */
window.notifications { background: none; }
.notif-stack { padding: {{ add .design.gaps_in 4 }}px {{ .design.gaps_out }}px 12px 14px; }
.notif {
    margin-bottom: 8px;
    border-radius: {{ add .design.rounding 4 }}px;
    border: 1px solid alpha({{ .palette.fg }}, 0.07);
    background-color: {{ .palette.bg }};
    box-shadow: inset 0 1px alpha({{ .palette.fg }}, 0.05);
    color: {{ .palette.fg }};
    font-family: "{{ .design.font_ui }}";
    font-size: 10pt;
    transition: background-color 180ms ease, border-color 180ms ease;
}
.notif.hover {
    border-color: alpha({{ .palette.accent }}, 0.55);
    background-color: {{ .palette.bg_alt }};
}
.notif-inner { padding: 11px 12px 12px 12px; }
.notif-caret { color: {{ .palette.accent }}; }

/* header */
.notif-head { min-height: 24px; }
.notif-icon {
    min-width: 24px;
    min-height: 24px;
    border-radius: 8px;
    font-family: "{{ .design.font }}";
    font-size: 10.5pt;
    color: {{ .palette.bg_dark }};
}
{{- $p := .palette }}
{{- range $name := list "accent" "blue" "cyan" "green" "yellow" "magenta" "red" "slate" }}
.notif-icon.tint-{{ $name }} {
    background-image: linear-gradient(160deg, shade({{ index $p $name }}, 1.12), shade({{ index $p $name }}, 0.82));
    box-shadow: 0 2px 8px alpha({{ index $p $name }}, 0.25);
}
{{- end }}
.notif-app { font-size: 9pt; font-weight: 600; color: {{ .palette.fg_muted }}; }
.notif-age { font-size: 9pt; color: {{ .palette.comment }}; }
button.notif-close {
    min-width: 22px;
    min-height: 22px;
    padding: 0;
    border: none;
    border-radius: 99px;
    box-shadow: none;
    background: none;
    font-family: "{{ .design.font }}";
    font-size: 9pt;
    color: {{ .palette.comment }};
    opacity: 0;
    transition: opacity 160ms ease, color 160ms ease, background-color 160ms ease;
}
.notif.hover button.notif-close { opacity: 1; }
button.notif-close:hover { color: {{ .palette.fg }}; background-color: alpha({{ .palette.steel }}, 0.5); }

/* text and picture */
.notif-content { margin: 8px 0 0 0; }
.notif-summary { font-weight: 700; font-size: 10.5pt; }
.notif-body { color: {{ .palette.fg_muted }}; }
.notif-thumb { border-radius: 10px; }
.notif.low .notif-summary { font-weight: 600; color: {{ .palette.fg_muted }}; }
.notif.low .notif-icon { opacity: 0.75; }

/* actions: soft pills */
.notif-actions { margin-top: 10px; }
.notif-actions button.item-action { border-radius: 99px; padding: 5px 10px; font-size: 9.5pt; }

/* value bar (volume, brightness, downloads) */
.notif-progress-row { margin-top: 10px; }
.notif-progress trough {
    min-height: 6px;
    border: none;
    border-radius: 99px;
    background-color: alpha({{ .palette.steel }}, 0.35);
}
.notif-progress progress {
    min-height: 6px;
    border: none;
    border-radius: 99px;
    background-image: linear-gradient(to right, shade({{ .palette.accent }}, 0.9), {{ .palette.accent }});
    transition: min-width 150ms ease;
}
.notif-progress-value {
    font-size: 9pt;
    font-weight: 600;
    font-feature-settings: "tnum";
    color: {{ .palette.fg_muted }};
    min-width: 38px;
}

/* countdown: a hairline along the bottom edge */
.notif-timer trough { min-height: 2px; border: none; border-radius: 0; background: none; }
.notif-timer progress {
    min-height: 2px;
    border: none;
    border-radius: 0;
    background-color: alpha({{ .palette.accent }}, 0.45);
}
.notif.hover .notif-timer progress { background-color: alpha({{ .palette.comment }}, 0.35); }
.notif.low .notif-timer progress { background-color: alpha({{ .palette.slate }}, 0.35); }

/* critical: red tinted card, red frame that breathes, no countdown */
.notif.critical {
    border-color: alpha({{ .palette.red }}, 0.8);
    background-image: linear-gradient(to bottom, alpha({{ .palette.red }}, 0.10), alpha({{ .palette.red }}, 0.03));
}
.notif.critical .notif-app { color: {{ .palette.red }}; }
.notif.critical .notif-progress progress { background-image: none; background-color: {{ .palette.red }}; }
@keyframes notif-alarm {
    0%   { box-shadow: 0 0 0 0 alpha({{ .palette.red }}, 0.45); }
    100% { box-shadow: 0 0 0 8px alpha({{ .palette.red }}, 0); }
}
.notif.critical:not(.entering) { animation: notif-alarm 1.6s ease-out infinite; }

/* motion: swing in from the screen edge, the icon pops and wiggles */
@keyframes notif-in {
    0%   { opacity: 0; transform: translateX(420px); }
    60%  { opacity: 1; transform: translateX(-10px); }
    80%  { transform: translateX(3px); }
    100% { opacity: 1; transform: none; }
}
@keyframes notif-out {
    0%   { opacity: 1; transform: none; }
    30%  { opacity: 1; transform: translateX(-8px); }
    100% { opacity: 0; transform: translateX(420px); }
}
@keyframes bubble-pop {
    0%   { transform: scale(0.3); }
    60%  { transform: scale(1.2); }
    100% { transform: none; }
}
@keyframes notif-bump {
    0%   { transform: none; }
    40%  { transform: scale(1.015); }
    100% { transform: none; }
}
.notif.entering { animation: notif-in 500ms cubic-bezier(0.2, 0.9, 0.3, 1) both; }
.notif.entering .notif-icon, .notif.entering .notif-thumb {
    animation: bubble-pop 420ms cubic-bezier(0.3, 1.4, 0.5, 1) 160ms both;
}
.notif.entering .notif-body, .notif.entering .notif-progress-row, .notif.entering .notif-actions {
    animation: row-in 300ms ease-out 300ms both;
}
.notif.leaving { animation: notif-out 260ms ease-in both; }
.notif.bump { animation: notif-bump 220ms ease-out 1; }
.notif.bump .notif-icon, .notif.hover .notif-icon { animation: icon-wiggle 380ms ease-in-out 1; }

/* real app icons (icon theme) need no square behind them */
.notif-icon.app { min-width: 0; min-height: 0; border-radius: 0; background: none; box-shadow: none; }

/* ---------------------------------------------------------------- notification center */
/* ~/.local/bin/notification-center (bar bell, SUPER+I): the history as small
   cards like the notifications, grouped by day; new ones get an orange dot */
window.popup.center { background-color: alpha({{ .palette.bg }}, 0.97); }
button.more.dnd {
    font-family: "{{ .design.font }}";
    font-size: 13pt;
    padding: 2px 8px;
}
button.more.dnd.on { color: {{ .palette.accent }}; background-color: alpha({{ .palette.accent }}, 0.14); }
.note.dnd-note { margin: 0 14px 4px 14px; font-size: 9pt; color: {{ .palette.accent }}; }
.center-entry {
    margin: 0 4px;
    padding: 10px 12px 11px 12px;
    border-radius: {{ add .design.rounding 2 }}px;
    border: 1px solid transparent;
    background-color: alpha({{ .palette.steel }}, 0.16);
    font-family: "{{ .design.font_ui }}";
    font-size: 10pt;
    transition: background-color 150ms ease, border-color 150ms ease;
}
.center-entry.hover {
    background-color: alpha({{ .palette.steel }}, 0.32);
    border-color: alpha({{ .palette.accent }}, 0.45);
}
.center-entry.critical {
    border-color: alpha({{ .palette.red }}, 0.6);
    background-image: linear-gradient(to bottom, alpha({{ .palette.red }}, 0.10), alpha({{ .palette.red }}, 0.03));
}
.center-entry.critical .notif-app { color: {{ .palette.red }}; }
.center-entry .notif-content { margin-top: 6px; }
.center-entry .notif-summary { font-size: 10pt; }
.center-entry button.notif-close { opacity: 0; }
.center-entry.hover button.notif-close { opacity: 1; }
.center-dot { font-size: 6pt; color: {{ .palette.accent }}; opacity: 0; }
.center-entry.new .center-dot { opacity: 1; }
.center-entry.leaving { animation: notif-out 220ms ease-in both; }
.center-empty { margin: 26px 0 22px 0; }
.center-empty-icon {
    font-family: "{{ .design.font }}";
    font-size: 30pt;
    color: {{ .palette.slate }};
}
.center-empty-icon { animation: hop 1.8s ease-in-out infinite; }
button.item-action.clear-all { margin: 8px 4px 0 4px; padding: 6px 8px; }
button.item-action.clear-all:hover { color: {{ .palette.red }}; }

/* ---------------------------------------------------------------- clipboard */
/* ~/.local/bin/clipboard-popup (SUPER+V): list menu rows with a status line,
   image thumbnails, color swatches; the x shows on the selected row */
.clip-row { padding: 7px 10px 7px 4px; }
.clip-text { color: {{ .palette.fg }}; }
.clip-thumb {
    border-radius: 6px;
    background-color: alpha({{ .palette.steel }}, 0.35);
}
.clip-swatch { font-size: 16pt; }
window.popup.clipboard { background-color: alpha({{ .palette.bg }}, 0.96); }
button.clip-remove {
    min-height: 0;
    min-width: 0;
    padding: 2px 6px;
    border: none;
    border-radius: 6px;
    box-shadow: none;
    background: none;
    color: transparent;
    transition: color 150ms ease, background-color 150ms ease;
}
.clip-row:selected button.clip-remove { color: {{ .palette.fg_muted }}; }
.clip-row:selected button.clip-remove:hover { color: {{ .palette.red }}; background-color: alpha({{ .palette.bg }}, 0.35); }
.clip-row:selected .row-status { color: {{ .palette.fg_muted }}; }
.clip-foot { margin: 2px 0 0 0; font-size: 9pt; }
.clip-hint { margin: 0 14px; font-size: 9pt; }
button.clip-clear { padding: 3px 10px; font-size: 9pt; }
.clip-empty { margin: 18px 14px; }
button.more.danger { color: {{ .palette.red }}; animation: session-pulse 900ms ease-out infinite; }
