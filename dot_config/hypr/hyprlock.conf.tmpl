# Lock screen, colors come from .chezmoidata/palette.toml
$font   = {{ .design.font }}
$accent = rgba({{ .palette.accent | trimPrefix "#" }}ff)
$fg     = rgba({{ .palette.fg | trimPrefix "#" }}ff)

general {
    hide_cursor = true
}

animations {
    enabled = true
    bezier = linear, 1, 1, 0, 0
    animation = fadeIn, 1, 5, linear
    animation = fadeOut, 1, 5, linear
    animation = inputFieldDots, 1, 2, linear
}

background {
    monitor =
    path = screenshot
    blur_passes = 3
    brightness = 0.6
}

# Greeting types itself in (the flair of the bar: orange caret), ~/.local/bin/lock-greeting
label {
    monitor =
    text = cmd[update:40] ~/.local/bin/lock-greeting
    font_size = 20
    font_family = $font
    color = rgba({{ .palette.fg_muted | trimPrefix "#" }}ff)
    position = 0, 270
    halign = center
    valign = center
}

label {
    monitor =
    text = $TIME
    font_size = 96
    font_family = $font
    color = $fg
    position = 0, 160
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:60000] date +"{{ index .strings.lock.date (dig "machine" "lang" "en" .) }}"
    font_size = 22
    font_family = $font
    color = $fg
    position = 0, 70
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 300, 50
    outline_thickness = {{ .design.border }}
    inner_color = rgba({{ .palette.bg | trimPrefix "#" }}cc)
    outer_color = $accent
    check_color = rgba({{ .palette.slate | trimPrefix "#" }}ff)
    fail_color  = rgba({{ .palette.red | trimPrefix "#" }}ff)
    font_color  = $fg
    fade_on_empty = false
    rounding = {{ .design.rounding }}
    font_family = $font
    placeholder_text = {{ index .strings.lock.password (dig "machine" "lang" "en" .) }}
    fail_text = $PAMFAIL
    dots_spacing = 0.3
    position = 0, -40
    halign = center
    valign = center
}
