-- Central place for all values that would otherwise be hardcoded.
-- Colors and shapes are filled in by chezmoi from .chezmoidata/{palette,design}.toml
local M = {}

-- Applications ---------------------------------------------------------------
-- Every app is launched through uwsm so it runs in its own systemd scope.
M.launch      = "uwsm app -- "
M.terminal    = "kitty"
M.browser     = "vivaldi"
M.fileManager = "dolphin"
-- App launcher; text without a matching app is searched on the web.
-- rofi itself starts without uwsm (faster), the apps it starts get their scope
M.menu        = "rofi -show combi -modes combi,web:" .. os.getenv("HOME") .. "/.local/bin/rofi-web-mode -combi-modes web,drun -display-combi Apps -theme launcher"
    .. " -run-command 'uwsm app -- {cmd}'"
M.bin         = os.getenv("HOME") .. "/.local/bin/"
-- Apps whose window SUPER+X keeps (lowercase window classes) and what it does
-- instead; SUPER+SHIFT+X really closes them. Spotify: hide its workspace (keeps
-- playing). Discord: back to the previous workspace, the window stays ready on
-- workspace 5 (a closed Discord window takes long to come back).
M.keepAlive   = {
    spotify = hl.dsp.exec_cmd(M.bin .. "music hide"),
    discord = hl.dsp.focus({ workspace = "previous" }),
    claude_pad = hl.dsp.exec_cmd(M.bin .. "claude-pad hide"),
}

-- Workspaces: 1 desktop (stays empty), 2 browser, 3 Neovim, 4 YouTube (SUPER+Y),
-- 5 chat (Discord, rules.lua), 6 games + Steam (rules.lua), 7 free,
-- 8 notes (Obsidian, SUPER+O, rules.lua). Icons: waybar config
-- Vivaldi asks the settings portal for dark/light mode once at start; if the
-- portal is not up yet it stays light. Asking the portal first starts it and
-- waits until it answers.
local portalReady = "busctl --user call org.freedesktop.portal.Desktop /org/freedesktop/portal/desktop "
    .. "org.freedesktop.portal.Settings ReadOne ss org.freedesktop.appearance color-scheme >/dev/null 2>&1"
M.startup = {
    { workspace = 2, cmd = "sh -c '" .. portalReady .. "; exec " .. M.browser .. "'", class = "vivaldi" },
    { workspace = 3, cmd = M.terminal .. " nvim", class = "kitty" },
}
-- Started out of sight: Spotify's window rule puts it on special:music, which
-- would pop up over the desktop; `music hide` closes it again (SUPER+M shows it)
M.hidden = {
    { cmd = "spotify-launcher", class = "spotify", hide = M.bin .. "music hide" },
}
M.background = {
    M.bin .. "notifications",             -- notification cards (replaces dunst)
    M.bin .. "discord-start",             -- workspace 5 without switching (rules.lua), bar-style tray icons
    "wl-paste --watch cliphist store",   -- clipboard history
    M.bin .. "game-watch",                -- GameMode for every game
    M.bin .. "youtube-autostart",         -- YouTube app window on workspace 4 (rules.lua)
    M.bin .. "claude-pad start",          -- Claude session waits hidden on special:claude
    M.bin .. "pet-picker --hidden",       -- pet picker waits hidden, opens instantly
    M.bin .. "brightness-popup --hidden", -- brightness slider, same
    M.bin .. "list-menu-popup --hidden",  -- Claude / music right click menus, same
    M.bin .. "sound-popup --hidden",      -- sound popup, same
    M.bin .. "bluetooth-popup --hidden",  -- Bluetooth popup, same
    M.bin .. "wifi-popup --hidden",       -- Wi-Fi popup, same
    M.bin .. "power-popup --hidden",      -- power popup (battery, profile), same
    M.bin .. "session-popup --hidden",    -- lock / reboot / shut down, same
    M.bin .. "keybinds --hidden",         -- shortcut overview (SUPER+H), same
    M.bin .. "clipboard-popup --hidden",  -- clipboard history (SUPER+V), same
    M.bin .. "notification-center --hidden", -- notification history (SUPER+I), same
    M.bin .. "task-popup --hidden",       -- new task for Claude (SUPER+T), same
    "nextcloud --background",           -- file sync, tray icon only
}

-- Look -----------------------------------------------------------------------
M.colors = {
    accent   = "rgba({{ .palette.accent | trimPrefix "#" }}ff)",
    inactive = "rgba({{ .palette.steel | trimPrefix "#" }}ff)",
    shadow   = "rgba({{ .palette.bg_dark | trimPrefix "#" }}ee)",
}
M.gaps     = { inner = {{ .design.gaps_in }}, outer = {{ .design.gaps_out }} }
M.border   = {{ .design.border }}
M.rounding = {{ .design.rounding }}

-- Dropdown terminal (Alt+Tab), sizes relative to the monitor -------------------
M.dropdown = {
    class = "dropdown_terminal",
    size  = { "monitor_w*0.6", "monitor_h*0.4" },
    move  = { "monitor_w*0.2", "monitor_h*0.05" },
}

-- Spotify's floating window on special:music (rules.lua)
M.music = { size = { "monitor_w*0.7", "monitor_h*0.75" } }

-- Claude scratchpad (~/.local/bin/claude-pad) floats on special:claude in the
-- overlay frame (M.overlay), but stays open when focus leaves
M.claude = { class = "claude_pad" }

-- Tool windows that float centered instead of tiling (regex on the class)
M.floating = {
    ["[Bb]itwarden"] = { 1000, 780 },
    ["nm-connection-editor"] = { 900, 620 },   -- "Network settings" (Wi-Fi popup)
    ["com\\.nextcloud\\.desktopclient\\.nextcloud"] = { 900, 700 },  -- sync client: wizard, settings
}

-- Popups opened from the bar: float under the mouse, just below the bar, and
-- close when focus leaves. Size per window class.
M.popup = {
    classes = {
        ["org.pulseaudio.pavucontrol"] = { 640, 560 },  -- narrower: app sliders scroll sideways
        ["popup-term"]                 = { 460, 520 },
        ["popup.pets"]                 = { 340, 170 },  -- pet picker (claude-pad menu)
    },
    -- Their own size, placed by the popup itself on every show (named rule
    -- "<class>-at", ~/.local/lib/popup/resident.py: under the mouse, kept on screen)
    placed = {
        "popup.menu",    -- right click menus: Claude, music (~/.local/bin/list-menu)
        "popup.sound",   -- volume, outputs, app volumes (~/.local/bin/sound-popup)
        "popup.bluetooth", -- devices, pairing (~/.local/bin/bluetooth-popup)
        "popup.wifi",    -- networks, password, forget (~/.local/bin/wifi-popup)
        "popup.power",   -- battery, power profile (~/.local/bin/power-popup)
        "popup.session", -- lock, reboot, shut down; centered (~/.local/bin/session-popup)
        "popup.brightness", -- screen + keyboard backlight (~/.local/bin/brightness-popup)
        "popup.clipboard",  -- clipboard history; centered (~/.local/bin/clipboard-popup)
        "popup.notifications", -- notification history (~/.local/bin/notification-center)
        "popup.task",    -- new task for Claude; centered (~/.local/bin/task-popup)
    },
    top = 46,   -- bar margin (8) + bar height (30) + gap (8), also in resident.py
}
-- Centered overlays that also close when focus leaves (shortcut overview).
-- Same frame as the rofi overlays (launcher, wallpapers): design.toml
M.overlays = { "popup.keybinds" }
M.overlay = {
    size     = { {{ .design.overlay_width }}, {{ .design.overlay_height }} },
    top      = {{ .design.overlay_top }},
    rounding = {{ mul .design.rounding 2 }},
}

-- Input ----------------------------------------------------------------------
-- caps:swapescape       Caps Lock <-> Escape (great for Neovim)
-- altwin:swap_lalt_lwin  (optional) left Alt <-> left Super. Not used here: SUPER
--                        stays the Windows key, so games always get a normal Alt.
M.keyboard = { layout = "{{ .machine.kb_layout }}", options = "{{ .machine.kb_options }}" }
M.touchpad = "gxtp5400:00-27c6:0f96-touchpad"

-- Screenshots ----------------------------------------------------------------
M.screenshotDir = os.getenv("HOME") .. "/Pictures/Screenshots"

return M
