[global]
    follow = mouse
    width = 350
    origin = top-right
    offset = (15, 15)
    notification_limit = 5
    gap_size = 6
    padding = 12
    horizontal_padding = 14
    frame_width = 1
    frame_color = "#ff7f00"
    corner_radius = 12
    font = JetBrainsMono Nerd Font 11
    format = "<b>%s</b>\n%b"
    icon_position = left
    max_icon_size = 48
    background = "#1c2029e6"
    foreground = "#f8f8f2"
    mouse_left_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    timeout = 4

[urgency_normal]
    timeout = 6

[urgency_critical]
    frame_color = "#ff5555"
    timeout = 0
