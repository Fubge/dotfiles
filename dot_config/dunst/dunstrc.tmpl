[global]
    follow = mouse
    width = 350
    origin = top-right
    offset = ({{ .design.gaps_out }}, {{ .design.gaps_out }})
    notification_limit = 5
    gap_size = 6
    padding = 12
    horizontal_padding = 14
    frame_width = {{ .design.border }}
    frame_color = "{{ .palette.accent }}"
    corner_radius = {{ .design.rounding }}
    font = {{ .design.font }} 11
    format = "<b>%s</b>\n%b"
    icon_position = left
    max_icon_size = 48
    background = "{{ .palette.bg }}e6"
    foreground = "{{ .palette.fg }}"
    mouse_left_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    timeout = 4

[urgency_normal]
    timeout = 6

[urgency_critical]
    frame_color = "{{ .palette.red }}"
    timeout = 0
