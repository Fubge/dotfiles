# Session-wide environment, loaded by uwsm before Hyprland starts.
export PATH="$HOME/.local/bin:$PATH"
export XCURSOR_THEME=breeze_cursors
export XCURSOR_SIZE=24
export QT_QPA_PLATFORMTHEME=qt6ct
export XDG_MENU_PREFIX=arch-
export BROWSER=vivaldi
export EDITOR=nvim
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"
# .NET (C# in Neovim): no telemetry, no first-run banner; dotnet tools
# (csharp-ls) live in ~/.dotnet/tools
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export DOTNET_NOLOGO=1
export PATH="$PATH:$HOME/.dotnet/tools"
# No accessibility bus: saves a D-Bus round trip on every GTK app start
# (no screen reader in use). GTK4 reads GTK_A11Y, GTK3/Qt read NO_AT_BRIDGE.
export GTK_A11Y=none
export NO_AT_BRIDGE=1
{{- if eq .machine.gpu "nvidia" }}
# NVIDIA (Hyprland wiki "Nvidia"): GBM backend, VA-API via nvidia-vaapi-driver
export LIBVA_DRIVER_NAME=nvidia
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export NVD_BACKEND=direct
export ELECTRON_OZONE_PLATFORM_HINT=auto
{{- end }}
