#!/usr/bin/env bash
# Bluetooth menu (SUPER+SHIFT+B, or bar click with --bar).
#   - paired devices: pick one to connect, pick a connected one to disconnect
#   - "Add a device": scans ~10 s, then pick a new device to pair + trust + connect
#   - turn Bluetooth on/off
set -uo pipefail
menu() { "$HOME/.local/bin/list-menu" "$@"; }

bar=(); [[ ${1-} == --bar ]] && bar=(--bar)

i_on=$'\U000F00AF' i_off=$'\U000F00B2' i_add=$'\U000F0415' i_dev=$'\U000F00AF'
i_conn=$'\U000F00B1'

notify() { notify-send -t 2500 -i bluetooth "Bluetooth" "$1"; }

if ! bluetoothctl show | grep -q 'Powered: yes'; then
    menu "${bar[@]}" --compact "Bluetooth" "" <<<"$i_on  Turn Bluetooth on" >/dev/null || exit 0
    rfkill unblock bluetooth 2>/dev/null
    bluetoothctl power on >/dev/null && notify "Turned on"
    exit 0
fi

# --- add a new device ----------------------------------------------------------
add_device() {
    notify "Searching for 10 seconds... put your device in pairing mode"
    bluetoothctl --timeout 10 scan on >/dev/null
    local macs=() labels=() mac name idx
    while read -r _ mac name; do
        [[ $name == "${mac//:/-}" ]] && continue   # nameless devices are just noise
        bluetoothctl devices Paired | grep -q "$mac" && continue
        macs+=("$mac"); labels+=("$i_dev  $name")
    done < <(bluetoothctl devices)
    ((${#macs[@]})) || { notify "No new devices found"; exit 0; }

    idx=$(printf '%s\n' "${labels[@]}" | menu "${bar[@]}" "Add device" "Filter devices...") || exit 0
    [[ -z $idx ]] && exit 0
    mac=${macs[idx]} name=${labels[idx]#*  }
    notify "Pairing with $name..."
    if bluetoothctl pair "$mac" >/dev/null && bluetoothctl trust "$mac" >/dev/null \
        && bluetoothctl connect "$mac" >/dev/null; then
        notify "Connected to $name"
    else
        notify-send -u critical "Bluetooth" "Could not pair with $name"
    fi
}

# --- main menu: paired devices -------------------------------------------------
macs=() names=() labels=() active=()
while read -r _ mac name; do
    info=$(bluetoothctl info "$mac")
    label="$i_dev  $name"
    if grep -q 'Connected: yes' <<<"$info"; then
        battery=$(sed -n 's/.*Battery Percentage: .*(\([0-9]*\)).*/\1/p' <<<"$info")
        label="$i_conn  $name${battery:+  ($battery%)}"
        active+=("${#macs[@]}")
    fi
    macs+=("$mac"); names+=("$name"); labels+=("$label")
done < <(bluetoothctl devices Paired)

n=${#macs[@]}
labels+=("$i_add  Add a device" "$i_off  Turn Bluetooth off")
active_arg=$(IFS=,; echo "${active[*]-}")
idx=$(printf '%s\n' "${labels[@]}" | menu "${bar[@]}" "Bluetooth" "Filter devices..." ${active_arg:+-a "$active_arg"}) || exit 0
[[ -z $idx ]] && exit 0

if   ((idx == n));     then add_device
elif ((idx == n + 1)); then bluetoothctl power off >/dev/null && notify "Turned off"
else
    mac=${macs[idx]} name=${names[idx]}
    if [[ ",$active_arg," == *",$idx,"* ]]; then
        bluetoothctl disconnect "$mac" >/dev/null && notify "Disconnected from $name"
    else
        notify "Connecting to $name..."
        bluetoothctl connect "$mac" >/dev/null && notify "Connected to $name" \
            || notify-send -u critical "Bluetooth" "Could not connect to $name"
    fi
fi
