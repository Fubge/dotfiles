#!/usr/bin/env python3
"""Battery icon for the bar (waybar custom module, one JSON line per change).

Icon only, percent and times in the tooltip. Ten level steps everywhere:
  draining  plain battery; class warning (<=25%) / critical (<=10%, pulses red)
  charging  the bolt battery fills up in a loop from the current level to full,
            like a phone. The loop runs faster the more watts go in.
  done      plugged in and nothing left to charge (full, or held by the charge
            limit: it only charges again below the start threshold): the
            battery steps aside and only a green plug remains, "on the cable,
            all good". Level in the tooltip.
While charging, a small plug sits next to the battery, so one glance tells
whether the laptop is on the cable. Plugging in, the plug
slides in from the side and clicks into place (one short yellow spark, class
plug); unplugging, it drifts away and fades out. No constant motion besides
the charging fill.

Waits for udev power_supply events, so it sleeps while nothing changes.
"""
import json
import os
import select
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, os.path.expanduser("~/.local/lib/popup"))
from i18n import T  # noqa: E402

BAT = Path("/sys/class/power_supply/BAT0")
AC = Path("/sys/class/power_supply/AC/online")

PLAIN = ["\U000F007A", "\U000F007B", "\U000F007C", "\U000F007D", "\U000F007E",
         "\U000F007F", "\U000F0080", "\U000F0081", "\U000F0082", "\U000F0079"]
BOLT = ["\U000F089C", "\U000F0086", "\U000F0087", "\U000F0088", "\U000F089D",
        "\U000F0089", "\U000F089E", "\U000F008A", "\U000F008B", "\U000F0085"]
PLUG, UNPLUG = "\U000F06A5", "\U000F06A6"

ANIM_FRAME = 0.11   # seconds per frame of the plug in/out animation
EM, EN = "\u2003", "\u2002"
IDLE_POLL = 60      # fallback refresh without udev events (capacity drift)


def read(name, default=""):
    try:
        return (BAT / name).read_text().strip()
    except OSError:
        return default


def state():
    cap = int(read("capacity", "0"))
    status = read("status")
    try:
        ac = AC.read_text().strip() == "1"
    except OSError:
        ac = status == "Charging"
    watts = int(read("power_now", "0")) / 1e6
    now, full = int(read("energy_now", "0")), int(read("energy_full", "1"))
    limit = int(read("charge_control_end_threshold", "100"))
    if status == "Charging":
        kind = "charging"
    elif status == "Full" or (ac and cap >= 99):
        kind = "full"
    elif ac:
        kind = "plugged"
    else:
        kind = "discharging"
    return dict(cap=cap, kind=kind, ac=ac, watts=watts, now=now, full=full, limit=limit)


def hours(h):
    m = round(h * 60)
    return f"{m // 60}h {m % 60:02d}min" if m >= 60 else f"{m}min"


def tooltip(s):
    lines = [T("battery.title", pct=s['cap'])]
    w = s["watts"]
    if s["kind"] == "charging":
        target = s["full"] * s["limit"] / 100
        if w > 0.5 and target > s["now"]:
            lines.append(T("battery.until_limit", pct=s['limit'], time=hours((target - s['now']) / 1e6 / w)))
        lines.append(T("battery.charging_w", w=f"{w:.1f}"))
    elif s["kind"] == "discharging":
        if w > 0.5:
            lines.append(T("battery.left", time=hours(s['now'] / 1e6 / w)))
        lines.append(f"{w:.1f} W")
    elif s["kind"] == "plugged":
        lines.append(T("battery.held", pct=s['limit']))
    else:
        lines.append(T("battery.full"))
    return "\n".join(lines)


def step(cap):
    return min(9, max(0, round(cap * 9 / 100)))


def frame_time(watts):
    # Fast charger -> quick fill, trickle -> slow fill
    return 0.35 if watts >= 45 else 0.6 if watts >= 15 else 1.0


def small(glyph, alpha=100):
    return f"<span size='smaller' alpha='{alpha}%'>{glyph}</span>"


# Plug sliding in: (gap, plug markup, class override); last frame = "click"
PLUG_IN = [(EM + EM, small(PLUG, 30), None), (EM, small(PLUG, 60), None),
           (EN, small(PLUG), None), (" ", PLUG, "plug"), (" ", PLUG, "plug")]
# Unplugged: it drifts away and fades
PLUG_OUT = [(" ", small(UNPLUG), None), (EN, small(UNPLUG, 70), None),
            (EM, small(UNPLUG, 45), None), (EM + EM, small(UNPLUG, 20), None)]


def emit(text, cls, tip, ac=False, extra=None):
    if extra:
        gap, plug, override = extra
        text += gap + plug
        cls = override or cls
    elif ac:
        text += " " + small(PLUG)
    print(json.dumps({"text": text, "class": cls, "tooltip": tip}), flush=True)


def main():
    udev = subprocess.Popen(
        ["udevadm", "monitor", "--kernel", "--subsystem-match=power_supply"],
        stdout=subprocess.PIPE, text=True)
    last_ac = None
    frame = 0
    anim = []
    while True:
        s = state()
        if last_ac is not None and s["ac"] != last_ac:
            anim = list(PLUG_IN if s["ac"] else PLUG_OUT)
            frame = 0
        last_ac = s["ac"]
        tip = tooltip(s)
        wait = IDLE_POLL

        extra = anim.pop(0) if anim else None
        if extra:
            wait = ANIM_FRAME
        if s["kind"] == "charging":
            # Fill loop: current step .. full, at least three frames,
            # the full icon stays a beat longer before it starts over
            first = min(step(s["cap"]), 7)
            frames = list(range(first, 10)) + [9]
            frame %= len(frames)
            emit(BOLT[frames[frame]], "charging", tip, True, extra)
            if not extra:
                frame += 1
                wait = frame_time(s["watts"])
        elif s["kind"] == "discharging":
            cls = "critical" if s["cap"] <= 10 else "warning" if s["cap"] <= 25 else "discharging"
            emit(PLAIN[step(s["cap"])], cls, tip, False, extra)
        elif extra:
            # Plugged in while done: the plug slides in next to the battery,
            # then the battery steps aside
            emit(PLAIN[step(s["cap"])], "full", tip, True, extra)
        else:
            emit(PLUG, "full", tip)

        ready, _, _ = select.select([udev.stdout], [], [], max(0.05, wait))
        if ready:
            if not udev.stdout.readline():
                return  # udevadm died, waybar restarts us
            time.sleep(0.2)  # let a burst of events settle
            while select.select([udev.stdout], [], [], 0)[0]:
                udev.stdout.readline()


if __name__ == "__main__":
    main()
