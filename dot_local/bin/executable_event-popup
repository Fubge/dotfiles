#!/usr/bin/env python3
"""Quick add (SUPER+SHIFT+K, N in the calendar popup, right click on the bar
date): a new event in two fields, "Was?" and "Wann?".

    event-popup show [--center] [--date 2026-11-20]
    event-popup show --center --edit UID START   change an event (calendar popup)
    ... --back                        opened from the calendar popup: saving or
                                      Escape opens it again on the event's day
    event-popup --hidden / quit       like every resident popup

    Kino morgen 20 Uhr                  tomorrow 20:00-21:00
    Zahnarzt 24.11. 14:30 für 30 min    that day, 14:30-15:00
    Fr 18-20 Grillen bei Oma            next Friday 18:00-20:00
    Urlaub 10.12.-14.12.                all-day, five days
    Pizza in 3 Tagen abends             19:00
    Wäsche                              all-day on the preset day (today)

"Was?" is the title, taken as typed. "Wann?" is read by the parser below;
its words light up as chips, words it does not know show up struck through.
With "Wann?" empty the one-liner still works: date words in "Was?" are found
and cut out of the title (the examples below). A ticket shows what will be
saved and counts down; under it the event's week, drawn like the month view
of the calendar popup, shows the new event glowing between the ones already
there.
Two round buttons pick the calendar (Flauschebär = own, preselected; Pia),
the chips below the reminder. Enter saves (~/.local/lib/popup/cal.py writes
the .ics and starts vdirsyncer), the title turns green and the popup closes.

Keys: Enter saves, Alt+F / Alt+P calendar, Alt+R next reminder, Tab moves
Was -> Wann -> Wo, Escape closes (the text stays until it is saved).
"""
import datetime as dt
import os
import re
import subprocess
import sys

sys.path.insert(0, os.path.expanduser("~/.local/lib/popup"))
import cal  # noqa: E402
import resident  # noqa: E402

APP = "popup.event"


def _day(t):
    """the date of an event start (a date or a datetime)"""
    return t.date() if isinstance(t, dt.datetime) else t
WIDTH = 560
CSS = os.path.expanduser("~/.config/popups/style.css")
CLOSE_MS = 1000
POPUP_CMD = os.path.expanduser("~/.local/bin/popup-cmd")
DEFAULT_LENGTH = dt.timedelta(hours=1)

# reminder choices: (label, timedelta before start or None)
TIMED_ALARMS = [("Keine", None), ("15 Min", dt.timedelta(minutes=-15)),
                ("1 Std", dt.timedelta(hours=-1)), ("1 Tag", dt.timedelta(days=-1))]
ALLDAY_ALARMS = [("Keine", None), ("Am Tag 9 Uhr", dt.timedelta(hours=9)),
                 ("Vortag 18 Uhr", dt.timedelta(hours=-6)), ("2 Tage vorher", dt.timedelta(days=-2))]

WEEKDAYS = {"montag": 0, "mo": 0, "dienstag": 1, "di": 1, "mittwoch": 2, "mi": 2,
            "donnerstag": 3, "do": 3, "freitag": 4, "fr": 4, "samstag": 5, "sa": 5,
            "sonnabend": 5, "sonntag": 6}
DAYTIMES = {"morgens": 8, "vormittags": 10, "mittags": 12, "nachmittags": 15,
            "abends": 19, "nachts": 22}
MONTHS = {m.lower(): i + 1 for i, m in enumerate(cal.MONTHS)}
MONTHS.update({m.lower().rstrip("."): i + 1 for i, m in enumerate(cal.MONTHS_SHORT)})
MONTHS["maerz"] = 3
FILLER = {"am", "um", "von", "bis", "ab", "für", "den", "ganztägig", "ganztags", "in"}


class Parsed:
    def __init__(self):
        self.title = ""
        self.date = None
        self.end_date = None       # all-day ranges, inclusive
        self.start = None          # dt.time
        self.end = None            # dt.time
        self.length = None         # timedelta
        self.allday_word = False
        self.chips = []


def _year_for(day, month, today):
    try:
        d = dt.date(today.year, month, day)
    except ValueError:
        return None
    if d < today - dt.timedelta(days=1):
        try:
            d = dt.date(today.year + 1, month, day)
        except ValueError:
            return None
    return d


def _date(day, month, year, today):
    try:
        day, month = int(day), int(month)
        if year:
            year = int(year)
            year += 2000 if year < 100 else 0
            return dt.date(year, month, day)
        return _year_for(day, month, today)
    except (ValueError, TypeError):
        return None


def parse(text, today, preset=None):
    """German one-liner -> Parsed. Matches are cut out of the text (left to
    right through the patterns below); what remains is the title."""
    p = Parsed()
    s = " " + text + " "
    low = s.lower()

    def take(pattern, fn):
        nonlocal s, low
        for m in list(re.finditer(pattern, low)):
            if fn(m) is not False:
                p.chips.append(s[m.start():m.end()].strip())
                s = s[:m.start()] + " " * (m.end() - m.start()) + s[m.end():]
                low = s.lower()
                return True
        return False

    B = r"(?<![\w.:])"           # word start, not inside a number
    E = r"(?![\w])"

    # date ranges: 10.12.-14.12.(2026)
    def date_range(m):
        a = _date(m["d1"], m["m1"], m["y1"] or m["y2"], today)
        b = _date(m["d2"], m["m2"], m["y2"], today)
        if not a or not b:
            return False
        if b < a:
            b = _date(m["d2"], m["m2"], str(a.year + 1), today)
        p.date, p.end_date = a, b
    take(B + r"(?P<d1>\d{1,2})\.(?P<m1>\d{1,2})\.(?P<y1>\d{2,4})?\s*(?:-|–|bis)\s*"
         r"(?P<d2>\d{1,2})\.(?P<m2>\d{1,2})\.?(?P<y2>\d{4})?" + E, date_range)

    # the weekend: "kommendes Wochenende", "am Wochenende", "dieses Wochenende"
    # -> Sat-Sun; a weekday range in the same text ("... von Fr bis So") wins
    # and is counted from that weekend's week
    weekend = None
    if p.date is None:
        def wkend(m):
            nonlocal weekend
            ahead = (5 - today.weekday()) % 7
            if today.weekday() == 6:                # Sunday: "dieses" = today's
                ahead = -1 if (m["this"] and not m["n"]) else 6
            if m["n"] and m["n"].startswith("über"):
                ahead += 7
            weekend = today + dt.timedelta(days=ahead)
        take(B + r"(?:am\s+|übers?\s+|an\s+dem\s+)?(?:(?P<this>dieses|diesem)\s+|"
             r"(?P<n>(?:über)?nächste[ns]?|kommende[ns]?)\s+)?wochenende" + E, wkend)

    # weekday ranges: Fr-So, von Freitag bis Sonntag, nächsten Mo bis Mi
    if p.date is None:
        days = dict(WEEKDAYS, so=6)           # "so" alone is a word, in a range Sunday
        names = "|".join(sorted(days, key=len, reverse=True))

        def wd_range(m):
            a, b = days[m["w1"]], days[m["w2"]]
            if weekend:
                start = weekend - dt.timedelta(days=5) + dt.timedelta(days=a)
            else:
                start = today + dt.timedelta(days=(a - today.weekday()) % 7 or 7)
                if m["n"] and m["n"].startswith("übernächst"):
                    start += dt.timedelta(days=7)
            p.date = start
            p.end_date = start + dt.timedelta(days=(b - a) % 7)
        take(B + r"(?:von\s+|am\s+)?(?P<n>(?:über)?nächsten?\s+|kommenden?\s+)?(?P<w1>" + names
             + r")\.?\s*(?:-|–|bis)\s*(?:zum\s+)?(?P<w2>" + names + r")\.?" + E, wd_range)
    if p.date is None and weekend:
        p.date, p.end_date = weekend, weekend + dt.timedelta(days=1)

    # explicit dates: 24.11. / 24.11.2026 / 24.11 / 24. November
    def explicit(m):
        d = _date(m["d"], m["m"], m["y"], today)
        if not d:
            return False
        p.date = d
    if p.date is None:
        take(B + r"(?:am\s+)?(?P<d>\d{1,2})\.(?P<m>\d{1,2})\.(?P<y>\d{4}|\d{2}(?!\d))?" + E, explicit) or \
            take(B + r"(?:am\s+)?(?P<d>\d{1,2})\.(?P<m>1[0-2]|0?[1-9])(?P<y>)(?![\d.:])(?!\s*uhr)", explicit)
    if p.date is None:
        names = "|".join(sorted(MONTHS, key=len, reverse=True))

        def named(m):
            d = _date(m["d"], MONTHS[m["m"].rstrip(".")], m["y"], today)
            if not d:
                return False
            p.date = d
        take(B + r"(?:am\s+)?(?P<d>\d{1,2})\.?\s*(?P<m>" + names + r")\.?(?:\s+(?P<y>\d{4}))?" + E,
             named)

    # relative days
    if p.date is None:
        rel = {"heute": 0, "morgen": 1, "übermorgen": 2, "uebermorgen": 2}

        def relative(m):
            p.date = today + dt.timedelta(days=rel[m[1]])
        take(B + r"(heute|übermorgen|uebermorgen|morgen)" + E, relative)
    if p.date is None:
        def in_days(m):
            n = int(m[1])
            unit = m[2]
            p.date = today + dt.timedelta(days=n * (7 if unit.startswith("woche") else 1))
        take(B + r"in\s+(\d{1,3})\s+(tag|tagen|woche|wochen)" + E, in_days)
    if p.date is None:
        def next_week(m):
            p.date = today + dt.timedelta(days=7 - today.weekday())
        take(B + r"(?:nächste|nächsten|kommende)\s+woche" + E, next_week)
    if p.date is None:
        names = "|".join(sorted(WEEKDAYS, key=len, reverse=True))

        def weekday(m):
            word = m["w"]
            if word in ("mo", "di", "mi", "do", "fr", "sa") and not (m["n"] or m["dot"] or m["am"]
                                                                    or re.match(r"\s*\d", low[m.end():])):
                return False       # "do" / "mi" alone could be a word
            wd = WEEKDAYS[word]
            ahead = (wd - today.weekday()) % 7 or 7
            if m["n"] and ahead < 7 and m["n"].startswith(("übernächst",)):
                ahead += 7
            p.date = today + dt.timedelta(days=ahead)
        take(B + r"(?P<am>am\s+)?(?P<n>(?:über)?nächsten?\s+|kommenden?\s+)?(?P<w>" + names
             + r")(?P<dot>\.)?" + E, weekday)

    # length: für 2 Std, 30 min, für 1,5 h ("20h" alone is a time)
    def length(m):
        n = float(m["n"].replace(",", "."))
        unit = m["u"]
        p.length = dt.timedelta(minutes=n) if unit.startswith("min") else dt.timedelta(hours=n)
    take(B + r"für\s+(?P<n>\d+(?:[.,]\d+)?)\s*(?P<u>min|minuten|std|stunden?|h)" + E, length) or \
        take(B + r"(?P<n>\d+(?:[.,]\d+)?)\s*(?P<u>min|minuten|std|stunden?)" + E, length)

    # time ranges: 18-20, 18:30–20 Uhr, von 9 bis 11.30
    def time_range(m):
        h1, h2 = int(m["h1"]), int(m["h2"])
        m1, m2 = int(m["m1"] or 0), int(m["m2"] or 0)
        if h1 > 24 or h2 > 24 or m1 > 59 or m2 > 59:
            return False
        p.start, p.end = dt.time(h1 % 24, m1), dt.time(h2 % 24, m2)
    if p.date is None or p.end_date is None:
        take(B + r"(?:von\s+)?(?P<h1>\d{1,2})(?:[:.](?P<m1>\d{2}))?\s*(?:uhr\s*)?(?:-|–|bis)\s*"
             r"(?P<h2>\d{1,2})(?:[:.](?P<m2>\d{2}))?(?:\s*uhr)?" + E, time_range)

    # single time: 20 Uhr, 20:15, um 9, 9.30 Uhr, 20h
    if p.start is None:
        def single(m):
            h, mi = int(m["h"]), int(m["m"] or 0)
            if h > 24 or mi > 59:
                return False
            p.start = dt.time(h % 24, mi)
        take(B + r"(?:um\s+)?(?P<h>\d{1,2})(?:[:.](?P<m>\d{2}))?\s*(?:uhr|h)" + E, single) or \
            take(B + r"(?:um\s+)?(?P<h>\d{1,2}):(?P<m>\d{2})" + E, single) or \
            take(B + r"um\s+(?P<h>\d{1,2})(?P<m>)" + E, single)
    if p.start is None:
        def daytime(m):
            p.start = dt.time(DAYTIMES[m[1]], 0)
        take(B + r"(" + "|".join(DAYTIMES) + r")" + E, daytime)

    def allday(m):
        p.allday_word = True
    take(B + r"(ganztägig|ganztags|den ganzen tag|ganzer tag)" + E, allday)

    words = [w for w in s.split()]
    while words and words[-1].lower().strip(",.") in FILLER:
        words.pop()
    while words and words[0].lower().strip(",.") in FILLER:
        words.pop(0)
    title = " ".join(words).strip(" ,-–")
    # spoken lead-ins: "ich will mein Auto fertig machen" -> "Auto fertig machen"
    title = re.sub(r"^(?:ich\s+)?(?:will|muss|möchte|sollte|werde|wollte|würde\s+gern|"
                   r"möchte\s+gern|hab\s+vor|habe\s+vor)?\s*(?:noch\s+|mal\s+|gern\s+)*"
                   r"(?:mein|meine|meinen|meinem|meiner|unser|unsere|unseren)?\s+",
                   "", " " + title if not title.lower().startswith("ich ") else title,
                   flags=re.I).strip() or title
    title = re.sub(r"\s+([,.!?])", r"\1", title)
    p.title = title[:1].upper() + title[1:]
    if p.date is None:
        p.date = preset or today
    return p


class Plan:
    """What will be saved: start/end as datetimes or dates (all-day)."""

    def __init__(self, p):
        self.title = p.title
        self.allday = p.start is None or p.allday_word or p.end_date is not None
        if self.allday:
            self.start = p.date
            self.end = (p.end_date or p.date) + dt.timedelta(days=1)
        else:
            self.start = dt.datetime.combine(p.date, p.start, cal.TZ)
            if p.end is not None:
                end = dt.datetime.combine(p.date, p.end, cal.TZ)
                if end <= self.start:
                    end += dt.timedelta(days=1)
            else:
                end = self.start + (p.length or DEFAULT_LENGTH)
            self.end = end


def build():
    import gi

    gi.require_version("Gtk", "4.0")
    gi.require_version("Gdk", "4.0")
    from gi.repository import Gdk, GLib, Gtk

    def label(text="", classes=(), **kw):
        return Gtk.Label(label=text, css_classes=list(classes), **kw)

    class Popup(Gtk.Window):
        popup_width = WIDTH

        def __init__(self):
            super().__init__(title="Neuer Termin")
            for c in ("popup", "menu", "event"):
                self.add_css_class(c)
            self.set_decorated(False)
            self.set_default_size(WIDTH, 1)
            self.preset = None
            self.close_timer = None
            self.cals = cal.calendars()
            self.cal_id = cal.OWN
            self.alarm_i = 0             # new events: no reminder
            self.alarm_touched = False
            self.editing = None
            self.plan = None

            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4,
                          css_classes=["event-box"])
            self.hello = label("Neuer Termin", ("menu-title", "event-hello"))
            self.sub = label("", ("event-sub",))
            box.append(self.hello)
            box.append(self.sub)

            self.entry = Gtk.Entry(placeholder_text="Was? z. B. Auto fertig machen",
                                   css_classes=["menu-search", "event-entry"])
            self.when = Gtk.Entry(placeholder_text="Wann? z. B. Fr bis So · morgen 20 Uhr",
                                  css_classes=["menu-search", "event-when"])
            self.place = Gtk.Entry(placeholder_text="Wo? (optional)",
                                   css_classes=["menu-search", "event-place"])
            for e in (self.entry, self.when, self.place):
                e.connect("activate", lambda _e: self.save())
            for e in (self.entry, self.when):
                e.connect("changed", lambda _e: self.update())
            box.append(self.entry)
            box.append(self.when)
            self.chips = Gtk.Box(spacing=6, css_classes=["event-chips"])
            box.append(self.chips)
            box.append(self.place)

            # the ticket: what will be saved
            ticket = Gtk.Box(spacing=16, css_classes=["event-ticket"])
            tile = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER,
                           css_classes=["cal-tile", "event-tile"])
            self.t_month = label("", ("cal-tile-month",))
            self.t_day = label("", ("cal-tile-day",))
            tile.append(self.t_month)
            tile.append(self.t_day)
            self.tile = tile
            lines = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER,
                            hexpand=True)
            self.t_title = label("", ("event-t-title",), xalign=0, ellipsize=3)
            self.t_when = label("", ("event-t-when",), xalign=0)
            self.t_until = label("", ("event-t-until",), xalign=0)
            lines.append(self.t_title)
            lines.append(self.t_when)
            lines.append(self.t_until)
            ticket.append(tile)
            ticket.append(lines)
            self.ticket = ticket
            box.append(ticket)

            # the preview: the event's week the way the calendar popup draws it,
            # the new event glowing between the ones already there
            self.week = Gtk.Grid(column_homogeneous=True, css_classes=["cal-grid", "event-week"])
            self.week_key = None
            box.append(self.week)

            # whose calendar
            row = Gtk.Box(spacing=34, halign=Gtk.Align.CENTER, css_classes=["event-row"])
            self.cal_buttons = {}
            for i, c in enumerate(self.cals):
                b = Gtk.Button(css_classes=["event-cal", "flat", f"ec-{i}"], focusable=False)
                inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
                # the heart carries its weight up top: nudged down a bit more (style.css)
                circle = ("event-circle",) + (("heart",) if c.glyph == "\U000F02D1" else ())
                inner.append(label(c.glyph, circle, halign=Gtk.Align.CENTER))
                inner.append(label(c.name, ("event-label",)))
                keys = Gtk.Box(spacing=3, halign=Gtk.Align.CENTER)
                keys.append(label("alt", ("key", "mod", "task-key")))
                keys.append(label(c.name[0].upper(), ("key", "task-key")))
                inner.append(keys)
                b.set_child(inner)
                b.connect("clicked", lambda _b, cid=c.id: self.pick_cal(cid))
                self.cal_buttons[c.id] = b
                row.append(b)
            box.append(row)

            # reminder
            rem = Gtk.Box(spacing=6, halign=Gtk.Align.CENTER, css_classes=["event-alarms"])
            rem.append(label("\U000F009A", ("event-alarm-icon",)))
            self.alarm_buttons = []
            for i in range(4):
                b = Gtk.Button(css_classes=["segment", "small", "event-alarm"], focusable=False)
                b.set_child(label(""))
                b.connect("clicked", lambda _b, k=i: self.pick_alarm(k))
                self.alarm_buttons.append(b)
                rem.append(b)
            box.append(rem)
            self.caption = label("", ("task-caption",))
            box.append(self.caption)
            self.set_child(box)

            keys = Gtk.EventControllerKey()
            keys.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
            keys.connect("key-pressed", self.on_key)
            self.add_controller(keys)
            self.colors_css = Gtk.CssProvider()
            css = ""
            for i, c in enumerate(self.cals):
                css += (f"button.event-cal.ec-{i} .event-circle {{ color: {c.color}; }}\n"
                        f"button.event-cal.ec-{i}:hover .event-circle {{ background-color: alpha({c.color}, 0.2); }}\n"
                        f"button.event-cal.ec-{i}.chosen .event-circle {{ background-color: {c.color}; "
                        f"color: #1c2029; box-shadow: 0 0 18px alpha({c.color}, 0.5); }}\n"
                        f"button.event-cal.ec-{i}.chosen .event-label {{ color: {c.color}; }}\n"
                        f"window.event.cal-{i} .event-ticket {{ border-left-color: {c.color}; }}\n"
                        f".cal-bg-c{i} {{ background-color: {c.color}; }}\n"
                        f".cal-tint-c{i} {{ color: {c.color}; background-color: alpha({c.color}, 0.14); }}\n"
                        f".cal-chip.new.cal-tint-c{i} {{ background-color: alpha({c.color}, 0.3); "
                        f"box-shadow: 0 0 0 1px {c.color}, 0 0 10px alpha({c.color}, 0.55); }}\n"
                        f".cal-chip.new.cal-bg-c{i} {{ box-shadow: 0 0 10px alpha({c.color}, 0.6); }}\n")
            try:
                self.colors_css.load_from_string(css)
            except AttributeError:
                self.colors_css.load_from_data(css.encode(), -1)
            Gtk.StyleContext.add_provider_for_display(
                Gdk.Display.get_default(), self.colors_css, Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)

        # ------------------------------------------------------------ state
        def take_opts(self, opts):
            self.preset = None
            self.editing = None
            self.cal_id = cal.OWN       # new events start in the own calendar
            self.back = "--back" in opts
            self.back_day = None
            if "--edit" in opts:
                i = opts.index("--edit")
                try:
                    self.editing = cal.find(opts[i + 1], opts[i + 2])
                except IndexError:
                    pass
            if "--date" in opts:
                i = opts.index("--date")
                try:
                    self.preset = dt.date.fromisoformat(opts[i + 1])
                except (IndexError, ValueError):
                    pass
            if self.editing:
                self.back_day = _day(self.editing.bounds()[0])
            else:
                self.back_day = self.preset

        def pick_cal(self, cid):
            self.cal_id = cid
            for i, c in enumerate(self.cals):
                b = self.cal_buttons[c.id]
                (b.add_css_class if c.id == cid else b.remove_css_class)("chosen")
                (self.add_css_class if c.id == cid else self.remove_css_class)(f"cal-{i}")
            if self.plan:               # the preview chip takes the new color
                pl = self.plan
                self.render_week(pl.start if pl.allday else pl.start.date())

        def alarms(self):
            return ALLDAY_ALARMS if (self.plan and self.plan.allday) else TIMED_ALARMS

        def pick_alarm(self, k, touched=True):
            self.alarm_i = k
            self.alarm_touched = self.alarm_touched or touched
            for i, b in enumerate(self.alarm_buttons):
                (b.add_css_class if i == k else b.remove_css_class)("active")

        def update(self):
            today = dt.date.today()
            was_allday = self.plan.allday if self.plan else None
            what, when = self.entry.get_text(), self.when.get_text()
            unknown = ""
            if when.strip():
                p = parse(when, today, self.preset)
                unknown = p.title         # what the parser could not place
                title = " ".join(what.split())
                p.title = title[:1].upper() + title[1:]
            else:
                p = parse(what, today, self.preset)
            self.plan = Plan(p)
            child = self.chips.get_first_child()
            while child:
                self.chips.remove(child)
                child = self.chips.get_first_child()
            for c in p.chips:
                self.chips.append(label(c, ("event-chip",)))
            if unknown:
                self.chips.append(label(unknown, ("event-chip", "unknown")))
            self.chips.set_visible(bool(p.chips or unknown))

            pl = self.plan
            d = pl.start if pl.allday else pl.start.date()
            self.t_month.set_text(cal.MONTHS_SHORT[d.month - 1].upper())
            self.t_day.set_text(str(d.day))
            (self.tile.add_css_class if d == today else self.tile.remove_css_class)("is-today")
            self.t_title.set_text(pl.title or "…")
            (self.t_title.add_css_class if not pl.title else self.t_title.remove_css_class)("placeholder")
            day = f"{cal.DAYS[d.weekday()]}, {d.day}. {cal.MONTHS[d.month - 1]}"
            if pl.allday:
                days = (pl.end - pl.start).days
                if days > 1:
                    last = pl.end - dt.timedelta(days=1)
                    when = f"{cal.date_text(d)} – {cal.date_text(last)} · {days} Tage"
                else:
                    when = f"{day} · ganztägig"
                start = dt.datetime.combine(d, dt.time(), cal.TZ)
            else:
                when = f"{day} · {pl.start:%H:%M} – {pl.end:%H:%M}"
                start = pl.start
            self.t_when.set_text(when)
            rel = cal.day_name(d, today)
            if rel in cal.DAYS:
                rel = cal.until_text(start) if start > cal.now() else "vorbei"
            elif not pl.allday and d == today:
                rel = cal.until_text(start) if start > cal.now() else "schon vorbei"
            self.t_until.set_text(rel)
            touched = False
            if was_allday is not None and was_allday != pl.allday:
                self.alarm_i = 0
                touched = True
            for i, b in enumerate(self.alarm_buttons):
                b.get_child().set_text(self.alarms()[i][0])
            self.pick_alarm(self.alarm_i, touched)
            self.render_week(d)
            # the date tile flips when the day changes
            key = d.toordinal()
            if getattr(self, "last_day", None) != key:
                self.last_day = key
                self.tile.remove_css_class("flip")
                GLib.timeout_add(16, lambda: self.tile.add_css_class("flip") and False)

        # ------------------------------------------------------------ preview
        def render_week(self, d):
            """Mo-Su of the event's first day, cells and chips like the month
            view of the calendar popup; the new event is a glowing chip in the
            chosen calendar's color (an edited event replaces its old self)."""
            pl = self.plan
            monday = d - dt.timedelta(days=d.weekday())
            ci = next((i for i, c in enumerate(self.cals) if c.id == self.cal_id), 0)
            key = (monday, pl.title, str(pl.start), str(pl.end), ci)
            if key == self.week_key:
                return
            moved = self.week_key is None or self.week_key[0] != monday
            self.week_key = key

            a = dt.datetime.combine(monday, dt.time(), cal.TZ)
            b = a + dt.timedelta(days=7)
            skip = self.editing.event.uid if self.editing else None
            try:
                occ = [o for o in cal.occurrences(a, b) if o.event.uid != skip]
            except Exception:           # a broken .ics must not break quick add
                occ = []
            if pl.allday:
                n_s = dt.datetime.combine(pl.start, dt.time(), cal.TZ)
                n_e = dt.datetime.combine(pl.end, dt.time(), cal.TZ)
            else:
                n_s, n_e = pl.start, max(pl.end, pl.start)
            NEW = object()
            items = [(o, *o.bounds()) for o in occ] + [(NEW, n_s, n_e)]

            def last_day(s, e):
                return (e - dt.timedelta(seconds=1)).date() if e > s else s.date()

            def long(s, e, allday):
                return allday or (e - s) >= dt.timedelta(days=1)

            child = self.week.get_first_child()
            while child:
                self.week.remove(child)
                child = self.week.get_first_child()
            today = dt.date.today()
            for c in range(7):
                day = monday + dt.timedelta(days=c)
                here = [it for it in items if it[1].date() <= day <= last_day(it[1], it[2])]
                here.sort(key=lambda it: (
                    not long(it[1], it[2], pl.allday if it[0] is NEW else it[0].allday),
                    it[1], it[0] is not NEW))
                if len(here) > 3:       # the new one is always shown
                    rest = [it for it in here if it[0] is not NEW][:2]
                    new = [it for it in here if it[0] is NEW]
                    shown = sorted(rest + new, key=here.index)
                else:
                    shown = here
                classes = ["cal-day", "event-day"]
                if c >= 5:
                    classes.append("weekend")
                if day == today:
                    classes.append("today")
                if day < today:
                    classes.append("past")
                if any(it[0] is NEW for it in here):
                    classes.append("selected")
                cell = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2,
                               css_classes=classes)
                head = Gtk.Box(spacing=3, halign=Gtk.Align.CENTER)
                head.append(label(cal.DAYS[day.weekday()][:2], ("event-wd",)))
                head.append(label(str(day.day), ("cal-num",)))
                cell.append(head)
                for it in shown:
                    cell.append(self.week_chip(it, day, ci, last_day, long, NEW))
                if len(here) > len(shown):
                    cell.append(label(f"+{len(here) - len(shown)}", ("cal-more",), xalign=0))
                self.week.attach(cell, c, 0, 1, 1)
            if moved:
                self.week.remove_css_class("enter")
                GLib.timeout_add(16, lambda: self.week.add_css_class("enter") and False)

        def week_chip(self, it, day, ci, last_day, long, NEW):
            o, s, e = it
            new = o is NEW
            allday = self.plan.allday if new else o.allday
            i = ci if new else next((k for k, c in enumerate(self.cals) if c.id == o.cal.id), 0)
            title = (self.plan.title or "Neu") if new else o.summary
            if long(s, e, allday):
                classes = ["cal-chip", "bar", f"cal-bg-c{i}"]
                before = s.date() < day
                after = last_day(s, e) > day
                if before and day.weekday() != 0:
                    classes.append("cont-left")
                if after and day.weekday() != 6:
                    classes.append("cont-right")
                text = title if not before or day.weekday() == 0 else " "
            else:
                classes = ["cal-chip", "timed", f"cal-tint-c{i}"]
                if not new and e <= cal.now():
                    classes.append("done")
                text = f"{s:%H:%M} {title}"
            if new:
                classes.append("new")
            return label(text, classes, xalign=0, ellipsize=3, max_width_chars=1, hexpand=True)

        def fill_from(self, o):
            """edit: the event written out the way it would be typed, so the
            same parser reads it back ("Testo 20.11.2026 20:00-20:15")"""
            self.hello.set_text("Termin bearbeiten")
            self.sub.set_text(("Ganze Serie · " if o.event.rrule else "")
                              + f"aus {o.cal.name}s Kalender")
            if o.allday:
                last = o.end - dt.timedelta(days=1)
                when = (f"{o.start.day}.{o.start.month}.{o.start.year}" if last <= o.start else
                        f"{o.start.day}.{o.start.month}.{o.start.year}-"
                        f"{last.day}.{last.month}.{last.year}")
            else:
                d = o.start
                when = f"{d.day}.{d.month}.{d.year} {o.start:%H:%M}-{o.end:%H:%M}"
            self.entry.set_text(o.summary)
            self.when.set_text(when)
            self.place.set_text(o.location)
            self.from_edit = True       # a new event must not start with this text
            self.cal_id = o.cal.id
            self.preset = o.start if o.allday else o.start.date()
            # the reminder chip that matches its first alarm, none if no match
            choices = ALLDAY_ALARMS if o.allday else TIMED_ALARMS
            first = next((a for a in o.event.alarms if isinstance(a, dt.timedelta)), None)
            if first is None and not o.event.alarms:
                self.alarm_i = 0
            else:
                self.alarm_i = next((i for i, c in enumerate(choices) if c[1] == first), -1)
            self.plan = None

        def save(self):
            if self.close_timer:
                return
            self.update()
            pl = self.plan
            if not pl.title:
                self.entry.remove_css_class("shake")
                GLib.timeout_add(16, lambda: self.entry.add_css_class("shake") and False)
                self.caption.set_text("Was steht an? Der Titel fehlt noch")
                self.entry.grab_focus()
                return
            place = " ".join(self.place.get_text().split())
            alarm = self.alarms()[self.alarm_i][1] if self.alarm_i >= 0 else None
            try:
                if self.editing:
                    ok = cal.update(self.editing, title=pl.title, start=pl.start, end=pl.end,
                                    allday=pl.allday, location=place,
                                    alarm=alarm if self.alarm_touched else ...,
                                    cal_id=self.cal_id)
                    if not ok:
                        raise OSError(0, "Termin nicht mehr gefunden")
                else:
                    cal.add(self.cal_id, pl.title, pl.start, pl.end, pl.allday, place, alarm)
            except OSError as e:
                self.caption.set_text(f"Konnte nicht speichern: {e.strerror}")
                self.caption.add_css_class("error")
                return
            self.back_day = _day(pl.start)
            for e in (self.entry, self.when, self.place):
                e.set_text("")
            self.add_css_class("saved")
            self.hello.set_text("Geändert ✓" if self.editing else "Eingetragen ✓")
            self.editing = None
            resident.type_title(self.hello)
            who = next(c.name for c in self.cals if c.id == self.cal_id)
            self.caption.set_text(f"In {who}s Kalender · geht gleich an Nextcloud")
            self.close_timer = GLib.timeout_add(CLOSE_MS, self.done)

        def done(self):
            self.close_timer = None
            self.close()
            self.go_back()
            return False

        def go_back(self):
            """opened from the calendar popup: show it again (only after saving
            or Escape; focus leaving closes both, as any popup)"""
            if not self.back:
                return
            self.back = False
            cmd = [POPUP_CMD, "calendar-popup", "show", "--center"]
            if self.back_day:
                cmd += ["--date", self.back_day.isoformat()]
            subprocess.Popen(cmd)

        # ------------------------------------------------------------ window
        def show_up(self):
            if self.close_timer:
                GLib.source_remove(self.close_timer)
                self.close_timer = None
            self.remove_css_class("saved")
            self.caption.remove_css_class("error")
            self.alarm_touched = False
            if self.editing:
                self.fill_from(self.editing)
            else:
                self.hello.set_text("Neuer Termin")
                self.alarm_i = 0         # never a reminder unless picked
                if getattr(self, "from_edit", False):   # an edit left by Escape
                    for e in (self.entry, self.when, self.place):
                        e.set_text("")
                self.from_edit = False
            if self.editing:
                pass
            elif self.preset and self.preset != dt.date.today():
                self.sub.set_text(f"Für {cal.DAYS[self.preset.weekday()]}, "
                                  f"{self.preset.day}. {cal.MONTHS[self.preset.month - 1]} "
                                  "– oder sag unter Wann ein anderes Datum")
            else:
                self.sub.set_text("Was steht an, und wann?")
            self.caption.set_text("Enter speichert · Tab: nächstes Feld" if not self.editing else
                                  "Ändere Titel, Datum oder Uhrzeit · Enter speichert")
            self.pick_cal(self.cal_id)
            self.last_day = None
            self.update()
            for b in self.cal_buttons.values():
                b.remove_css_class("enter")
            GLib.timeout_add(30, lambda: [b.add_css_class("enter")
                                          for b in self.cal_buttons.values()] and False)
            self.set_default_size(WIDTH, 1)
            self.present()
            self.entry.grab_focus()
            if self.editing:
                self.entry.select_region(-1, -1)    # cursor at the end, nothing selected

        def on_key(self, _ctrl, keyval, _code, state):
            if keyval == Gdk.KEY_Escape:
                self.close()
                self.go_back()
                return True
            if state & Gdk.ModifierType.ALT_MASK:
                ch = chr(Gdk.keyval_to_unicode(keyval) or 0).lower()
                if ch == "r":
                    self.pick_alarm((self.alarm_i + 1) % 4)
                    return True
                for c in self.cals:
                    if ch == c.name[0].lower():
                        self.pick_cal(c.id)
                        return True
            return False

    provider = Gtk.CssProvider()
    provider.load_from_path(CSS)
    Gtk.StyleContext.add_provider_for_display(
        Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_USER)
    return Popup()


if __name__ == "__main__":
    if sys.argv[1:2] == ["--parse"]:          # test the parser: event-popup --parse "text"
        today = dt.date.today()
        for t in sys.argv[2:]:
            pl = Plan(parse(t, today))
            print(f"{t!r:45} -> {pl.title!r:22} {pl.start} .. {pl.end}"
                  + ("  (ganztägig)" if pl.allday else ""))
    else:
        resident.main(APP, build, __doc__)
