#!/usr/bin/env python3
"""Now playing in the bar (waybar custom/music), next to the terminal clock.

  music          title module (custom/music) = `music part title`
  music part P   print the JSON lines of part P (title, icon, bar0..bar5) for
                 waybar; starts the daemon when none runs
  music ensure   start the daemon unless one runs (reader loop, see part)
  music daemon   watch the player, feed every part through its FIFO
  music show     bring the player window here (Spotify), start it if needed
  music hide     Spotify's own "Minimize to Tray" (keeps playing; SUPER+X)
  music menu     right click menu: play/pause, next, show, quit (tray stand-in)

Look: a real audio visualizer (cava, 60 fps). Every bar is its own tiny waybar
module drawn by CSS (rounded pill, gradient, eased height changes); the script
only sets a height class l0..l16, so the bars grow from the middle like in the
Quickshell rices. On pause they shrink to dim dots and the title dims. A new song
is typed in like on the terminal clock (orange caret), long titles scroll.
Spotify's tray icon is a "passive" StatusNotifierItem (waybar: show-passive-items).
Closing its window quits Spotify; hiding goes through the tray menu over D-Bus.
The bar icon also stays while Spotify runs, its right click menu can quit it.
cava only runs while music plays. Spotify is preferred over other players.
"""
import fcntl
import html
import json
import os
import re
import subprocess
import sys
import threading
import time

PLAYERS = "spotify,%any"
WIDTH = 18                    # visible title characters, longer ones scroll (keeps the clock pill clear of its neighbours)
BARS = 6                      # visualizer bars (= custom/music-barN modules)
LEVELS = 16                   # bar heights l0..l16 (CSS classes in style.css, 1 px steps)


# visualizer frames per second; 120 (display refresh) cost waybar + Hyprland
# ~15% of a core each, 60 halves that and still looks smooth
FPS = 60
# typing speed shared with the other typewriter texts
sys.path.insert(0, os.path.expanduser("~/.local/lib/flair"))
sys.path.insert(0, os.path.expanduser("~/.local/lib/popup"))
from i18n import T  # noqa: E402
from typewriter import TYPE_SPEED  # noqa: E402
SCROLL_SPEED = 4              # marquee characters per second (moves pixel by pixel)
CHAR_W = 14 * 0.6             # advance of one JetBrains Mono character at the bar's 14 px
SCROLL_HOLD = 2.0             # seconds the start of a long title stays put
COLORS = {
    "icon": "{{ .palette.green }}",
    "dim": "{{ .palette.comment }}",
    "caret": "{{ .palette.accent }}",
}
ICONS = {"spotify": "\U000F04C7", "default": "\U000F075A"}  # nf-md-spotify / music-note
# The bar's center block (clock + music) is centered and music is its right end,
# so the music widget's middle is always half the clock's width right of the
# screen's middle, however long the title is. Clock = 200 px (measured).
MENU_AT = 100
SEP = "   ·   "
FIELDS = ["status", "player", "artist", "title", "album"]
FMT = "\x1f".join("{" * 2 + f + "}" * 2  # playerctl format fields
                  for f in ["status", "playerName", "artist", "title", "album"])
NBSP = " "

CAVA_CONF = f"""
[general]
framerate = {FPS}
bars = {BARS}
autosens = 1
[input]
method = pipewire
source = auto
[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = {LEVELS}
bar_delimiter = 59
[smoothing]
monstercat = 0
noise_reduction = 60
"""

state = {f: "" for f in FIELDS}
levels = [0] * BARS
lock = threading.Lock()
changed = threading.Event()


def store(line):
    parts = line.rstrip("\n").split("\x1f")
    with lock:
        state.update(dict(zip(FIELDS, parts)) if len(parts) == 5 else {f: "" for f in FIELDS})
    changed.set()


def requery():
    r = subprocess.run(["playerctl", "-p", PLAYERS, "metadata", "--format", FMT],
                       capture_output=True, text=True)
    if r.returncode == 0:
        store(r.stdout)


def follow():
    """Keep `state` in sync with playerctl (one line per change)."""
    while True:
        proc = subprocess.Popen(
            ["playerctl", "-p", PLAYERS, "--follow", "metadata", "--format", FMT],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        for line in proc.stdout:
            store(line)
            f = line.rstrip("\n").split("\x1f")
            if len(f) == 5 and f[0] in ("Playing", "Paused") and not f[3]:
                # Spotify sometimes announces a new song before its title and
                # --follow never repeats the line -> ask again a moment later
                threading.Timer(1.5, requery).start()
        proc.wait()
        time.sleep(2)


class Cava:
    """Runs cava while music plays and keeps `levels` (0-LEVELS per bar) fresh."""

    CHECK = 4    # seconds between health checks while playing

    def __init__(self):
        self.proc = None
        self.checked = 0.0
        run = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
        self.conf = os.path.join(run, "music-cava.conf")
        with open(self.conf, "w") as f:
            f.write(CAVA_CONF)

    def wired(self):
        """Is cava still listening to the default sink? cava stays alive when its
        sink vanishes (Bluetooth profile switch, headset off) and WirePlumber
        relinks it to the default *source*, the microphone: the bars then dance
        to the room or sit still. `pw-link -l` lists cava's inputs and their peers."""
        try:
            meta = subprocess.run(["pw-metadata", "0", "default.audio.sink"], capture_output=True,
                                  text=True, timeout=2).stdout
            links = subprocess.run(["pw-link", "-l"], capture_output=True, text=True, timeout=2).stdout
        except (OSError, subprocess.TimeoutExpired):
            return True
        m = re.search(r'"name":\s*"([^"]+)"', meta)
        if not m:
            return True
        peers, inside = [], False
        for line in links.splitlines():
            if not line.startswith(" "):
                inside = line.startswith("cava:input")
            elif inside and "|<-" in line:
                peers.append(line.split("|<-", 1)[1].strip())
        return any(p.startswith(m.group(1) + ":monitor") for p in peers)

    def running(self, on):
        """Start/stop cava; while on, restart it every few seconds when it died
        or lost the default sink (checked at most every CHECK seconds)."""
        if on and self.proc and time.monotonic() - self.checked > self.CHECK:
            self.checked = time.monotonic()
            if self.proc.poll() is not None or not self.wired():
                self.proc.terminate()
                self.proc = None
        if on and not self.proc:
            self.checked = time.monotonic()
            self.proc = subprocess.Popen(["cava", "-p", self.conf], stdout=subprocess.PIPE,
                                         stderr=subprocess.DEVNULL, text=True)
            threading.Thread(target=self.read, args=(self.proc,), daemon=True).start()
        elif not on and self.proc:
            self.proc.terminate()
            self.proc = None
            levels[:] = [0] * len(levels)

    def read(self, proc):
        for line in proc.stdout:
            vals = [int(x) for x in line.strip().rstrip(";").split(";") if x.isdigit()]
            if len(vals) == len(levels) and proc is self.proc:
                levels[:] = vals
                changed.set()


RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "music")
PARTS = ["title", "icon"] + [f"bar{i}" for i in range(BARS)]
LOCK = os.path.join(RUN, "daemon.lock")


def fifo(name):
    """One FIFO per reader (NAME.PID): waybar runs every module once PER BAR, so
    with two monitors two readers of the same part must not share a FIFO
    (they would steal each other's lines)."""
    os.makedirs(RUN, exist_ok=True)
    path = os.path.join(RUN, f"{name}.{os.getpid()}")
    if not os.path.exists(path):
        os.mkfifo(path)
    return path


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


class Parts:
    """Writes every part to all its readers' FIFOs. Opened read-write and
    non-blocking: never waits for a reader, a stuck reader only drops frames.
    Only changes are sent (every line = a GTK restyle). Readers are found by
    rescanning RUN; a new reader first gets the current line."""

    def __init__(self):
        self.readers = {}   # path -> [part, fd, last line]
        self.current = {}
        self.scanned = 0.0
        self.empty_since = None

    def scan(self):
        self.scanned = time.monotonic()
        seen = set()
        for f in os.listdir(RUN):
            name, _, pid = f.rpartition(".")
            if name not in PARTS or not pid.isdigit():
                continue
            path = os.path.join(RUN, f)
            if not alive(int(pid)):
                self.drop(path)
                try:
                    os.unlink(path)
                except OSError:
                    pass
                continue
            seen.add(path)
            if path not in self.readers:
                fd = os.open(path, os.O_RDWR | os.O_NONBLOCK)
                self.readers[path] = [name, fd, None]
                if name in self.current:
                    self.write(path, self.current[name])
        for path in set(self.readers) - seen:
            self.drop(path)
        self.empty_since = None if self.readers else (self.empty_since or self.scanned)

    def drop(self, path):
        r = self.readers.pop(path, None)
        if r:
            os.close(r[1])

    def write(self, path, line):
        r = self.readers[path]
        if r[2] != line:
            try:
                os.write(r[1], (line + "\n").encode())
                r[2] = line
            except BlockingIOError:
                pass

    def send(self, part, text="", tooltip="", cls=""):
        if time.monotonic() - self.scanned > 1:
            self.scan()
        # several classes must be a list ("a b" would be one class named "a b")
        line = json.dumps({"text": text, "tooltip": tooltip, "class": cls.split()})
        self.current[part] = line
        for path, r in list(self.readers.items()):
            if r[0] == part:
                self.write(path, line)


def lock_free():
    os.makedirs(RUN, exist_ok=True)
    with open(LOCK, "a") as f:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return True
        except BlockingIOError:
            return False


def part(name):
    """`exec` of a waybar module: start the daemon if needed, then pass this
    reader's FIFO through. Hands over to cat: no Python left running per part
    (an unbuffered Python line loop read byte by byte, one syscall per
    character at the visualizer's frame rate)."""
    path = fifo(name)
    ensure()
    # cat only ends when the daemon is gone (it holds the write end open), so
    # every pass of the loop first brings a daemon back: it quits after a code
    # change or when idle, and without this the bar froze until waybar restarted
    os.execvp("sh", ["sh", "-c", 'trap \'rm -f "$1"\' EXIT; while :; do "$2" ensure; cat "$1"; sleep 1; done',
                     "sh", path, os.path.realpath(sys.argv[0])])


def ensure():
    """Start the daemon unless one runs."""
    if lock_free():
        subprocess.Popen([sys.argv[0], "daemon"], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)


def span(color, text):
    return f"<span color='{color}'>{text}</span>"


def title_text(title, since, playing):
    """Typewriter for a new song, then a marquee when the title is too long.
    Returns the markup and whether it still changes over time."""
    final = min(len(title), WIDTH)
    typed = int((time.monotonic() - since) * TYPE_SPEED)
    if typed < final:
        # pad to the final width so the clock next to it does not move
        pad = NBSP * max(0, final - typed - 1)
        return html.escape(title[:typed]) + span(COLORS["caret"], "▍") + pad, True
    if len(title) <= WIDTH:
        return html.escape(title), False
    loop = title + SEP
    t = time.monotonic() - since - final / TYPE_SPEED
    # one cycle: hold at the start, then scroll once through the whole loop
    cycle = SCROLL_HOLD + len(loop) / SCROLL_SPEED
    phase = t % cycle if playing else 0
    if phase <= SCROLL_HOLD:
        # at rest the title starts with its first letter: the marquee always
        # spends its leftmost slot on the letter sliding out (blank at rest)
        return html.escape(title[:WIDTH]), playing
    return marquee(loop * 2, (phase - SCROLL_HOLD) * SCROLL_SPEED), playing


def gap(px):
    """Invisible spacer of px pixels: a zero width space whose letter spacing
    (1/1024 pt, half of it lands behind the character) makes the room."""
    return f"<span letter_spacing='{round(px * 2048)}'>\u200b</span>"


def marquee(text, pos):
    """WIDTH characters of text starting at the (fractional) position pos, moved
    by whole pixels instead of whole characters. The character leaving on the
    left fades out, the one coming in on the right fades in; spacers on both
    sides keep the width constant."""
    k = int(pos)
    frac = pos - k
    chars = text[k + 1:k + WIDTH]

    def faded(c, a):
        return f"<span alpha='{max(1, round(a * 100))}%'>{html.escape(c)}</span>"

    body = faded(chars[0], 1 - frac) + html.escape(chars[1:-1]) + faded(chars[-1], frac)
    return gap((1 - frac) * CHAR_W) + body + gap(frac * CHAR_W)


def send_bars(parts, tip):
    """One line per bar whose height class changed (the text is just a
    placeholder: empty text hides a module, CSS draws the bar)."""
    lv = levels[:]
    for i in range(BARS):
        parts.send(f"bar{i}", NBSP, tip, "bar l" + str(max(0, min(LEVELS, lv[i]))))


def daemon():
    """Exactly one per session (flock), however many bars exist. Ends when no
    reader is left for a while (waybar gone) or when this script changed
    (chezmoi update): the next reader starts the new code."""
    os.makedirs(RUN, exist_ok=True)
    lockf = open(LOCK, "a")
    try:
        fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return
    me = os.path.realpath(sys.argv[0])
    mtime = os.stat(me).st_mtime

    def reaper(parts):
        while True:
            time.sleep(5)
            try:
                changed_code = os.stat(me).st_mtime != mtime
            except OSError:
                changed_code = True
            idle = parts.empty_since and time.monotonic() - parts.empty_since > 10
            if changed_code or idle:
                os._exit(0)
            with lock:
                state["_tick"] = time.monotonic()  # wake the loop so it rescans
            changed.set()

    watch(reaper)


def watch(reaper):
    threading.Thread(target=follow, daemon=True).start()
    cava = Cava()
    parts = Parts()
    parts.scan()
    threading.Thread(target=reaper, args=(parts,), daemon=True).start()
    last_title, since, last_out = None, 0.0, None

    def hide_all():
        for p in PARTS:
            parts.send(p)

    last_s, tip, cls, playing, title = None, "", "", False, ""
    while True:
        with lock:
            s = dict(state)
        if s == last_s and playing:
            # only a new cava frame (or the title timer): bars and title, nothing else
            send_bars(parts, tip)
            shown, moving = title_text(title, since, True)
            out = (shown, tip, cls)
            if out != last_out:
                parts.send("title", *out)
                last_out = out
            if changed.wait(1 / FPS):
                changed.clear()
            continue
        last_s = s
        active = s["status"] in ("Playing", "Paused")
        spotify_idle = not active and s["player"] == "spotify" and s["status"]
        if not active:
            cava.running(False)
            hide_all()
            if spotify_idle:  # running without a song: keep the icon as a tray
                parts.send("icon", span(COLORS["dim"], ICONS["spotify"]),
                           "Spotify\n\n<small>" + T("claude.bar_hint") + "</small>", "idle")
            parts.send("title")
            last_title, last_out, playing = None, None, False
            changed.wait()
            changed.clear()
            continue

        playing = s["status"] == "Playing"
        cava.running(playing)
        title = s["title"] or "…"
        if title != last_title:
            last_title, since = title, time.monotonic()

        tip = html.escape(title)
        if s["artist"]:
            tip += "\n" + html.escape(" · ".join(x for x in (s["artist"], s["album"]) if x))
        tip += "\n\n<small>" + T("music.bar_hint") + "</small>"

        cls = "playing" if playing else "paused"
        parts.send("icon", span(COLORS["icon"] if playing else COLORS["dim"],
                                ICONS.get(s["player"], ICONS["default"])), tip, cls)
        if playing:
            send_bars(parts, tip)
        else:
            for i in range(BARS):
                parts.send(f"bar{i}", NBSP, tip, "bar paused")

        shown, moving = title_text(title, since, playing)
        if not playing:
            shown = f"<i>{span(COLORS['dim'], shown)}</i>"
        out = (shown, tip, cls)
        if out != last_out:  # waybar only redraws when something changed
            parts.send("title", *out)
            last_out = out

        # playing: redraw with every cava frame (or the title timer); paused: on change
        if changed.wait(1 / FPS if (playing or moving) else None):
            changed.clear()


def lua_table(**kw):
    """{k='v', n=1, b=true} for hyprctl dispatch (Lua dispatchers)."""
    def val(x):
        return "true" if x is True else str(x) if isinstance(x, int) else "'" + x + "'"
    return "{" + ", ".join(k + "=" + val(x) for k, x in kw.items()) + "}"


def tray_click(label):
    """Click an entry of Spotify's tray menu (dbusmenu over D-Bus). False if not found."""
    def call(*args):
        r = subprocess.run(["busctl", "--user", "--json=short", *args], capture_output=True, text=True)
        return json.loads(r.stdout)["data"] if r.returncode == 0 and r.stdout else None

    items = call("get-property", "org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher",
                 "org.kde.StatusNotifierWatcher", "RegisteredStatusNotifierItems") or []
    item = next((i for i in items if i.endswith("/spotify_client")), None)
    if not item:
        return False
    bus, path = item.split("/", 1)
    menu = f"/{path}/Menu"
    layout = call("call", bus, menu, "com.canonical.dbusmenu", "GetLayout", "iias", "--", "0", "-1", "0")
    for child in (layout or [0, [0, {}, []]])[1][2]:
        mid, props = child["data"][0], child["data"][1]
        if props.get("label", {}).get("data") == label:
            subprocess.run(["busctl", "--user", "call", bus, menu, "com.canonical.dbusmenu",
                            "Event", "isvu", "--", str(mid), "clicked", "s", "", "0"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True
    return False


def hypr(cmd):
    subprocess.run(["hyprctl", "dispatch", cmd], stdout=subprocess.DEVNULL)


def music_shown():
    """Is the special:music workspace (Spotify's place) open on a monitor?"""
    mons = json.loads(subprocess.run(["hyprctl", "monitors", "-j"],
                                     capture_output=True, text=True).stdout or "[]")
    return any(m.get("specialWorkspace", {}).get("name") == "special:music" for m in mons)


def show():
    """Toggle Spotify: it floats on its own special workspace (special:music) over
    the current one, so tiled windows never move. Brings it back from the tray
    or starts it when needed; the window rule puts it in place."""
    win = spotify_window()
    if not win:
        running = subprocess.run(["pgrep", "-x", "spotify"], stdout=subprocess.DEVNULL).returncode == 0
        if not (running and tray_click("Show Spotify")):
            subprocess.Popen(["uwsm", "app", "--", "spotify-launcher"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    if win["workspace"]["name"] != "special:music":   # e.g. moved away by hand
        hypr("hl.dsp.window.move(" + lua_table(window="address:" + win["address"],
                                               workspace="special:music") + ")")
        if music_shown():
            return
    hypr("hl.dsp.workspace.toggle_special('music')")
    if music_shown():
        hypr("hl.dsp.focus(" + lua_table(window="address:" + win["address"]) + ")")


def hide():
    """Spotify out of sight, keeps playing (the special workspace closes)."""
    if music_shown():
        hypr("hl.dsp.workspace.toggle_special('music')")
    elif not tray_click("Minimize to Tray"):
        win = spotify_window()
        if win:
            hypr("hl.dsp.window.move(" + lua_table(window="address:" + win["address"],
                                                   workspace="special:music") + ")")


def spotify_window():
    clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"],
                                        capture_output=True, text=True).stdout or "[]")
    return next((c for c in clients if c["class"].lower() == "spotify"), None)


def quit_spotify():
    """Closing the window really quits Spotify on Linux (even when minimized)."""
    win = spotify_window()
    if win:
        subprocess.run(["hyprctl", "dispatch", "hl.dsp.window.close("
                        + lua_table(window="address:" + win["address"]) + ")"],
                       stdout=subprocess.DEVNULL)
        for _ in range(30):
            time.sleep(0.1)
            if subprocess.run(["pgrep", "-x", "spotify"], stdout=subprocess.DEVNULL).returncode:
                return
    subprocess.run(["pkill", "-x", "spotify"])


def menu():
    """Right click menu, the tray stand-in (Spotify has no tray icon on Linux)."""
    status = subprocess.run(["playerctl", "-p", PLAYERS, "status"],
                            capture_output=True, text=True).stdout.strip()
    rows = [("\U000F03E4  " + T("music.pause") if status == "Playing" else "\U000F040A  " + T("music.play"),
             lambda: subprocess.run(["playerctl", "-p", PLAYERS, "play-pause"])),
            ("\U000F04AD  " + T("music.next"), lambda: subprocess.run(["playerctl", "-p", PLAYERS, "next"])),
            ("\U000F04AE  " + T("music.previous"),
             lambda: subprocess.run(["playerctl", "-p", PLAYERS, "previous"])),
            ("\U000F05AF  " + T("music.show_hide"), show)]
    if subprocess.run(["pgrep", "-x", "spotify"], stdout=subprocess.DEVNULL).returncode == 0:
        rows.append(("\U000F0156  " + T("music.quit"), quit_spotify))
    # bound to on-click-right-release: the menu closes when focus leaves it,
    # so it must only open after the right click (touchpad: two-finger press) is let go
    meta = subprocess.run(["playerctl", "-p", PLAYERS, "metadata", "--format",
                           "\x1f".join("{" * 2 + f + "}" * 2 for f in ("title", "artist"))],
                          capture_output=True, text=True).stdout.strip()
    song = "  ·  ".join(x for x in meta.split("\x1f") if x)     # title · artist
    pick = subprocess.run([os.path.expanduser("~/.local/bin/list-menu"), "--bar",
                           "--at", str(MENU_AT), "--info", song, "Music", ""],
                          input="\n".join(r[0] for r in rows), capture_output=True, text=True)
    if pick.stdout.strip().isdigit():
        rows[int(pick.stdout.strip())][1]()


if __name__ == "__main__":
    args = sys.argv[1:]
    if args == ["show"]:
        show()
    elif args == ["hide"]:
        hide()
    elif args == ["menu"]:
        menu()
    elif args[:1] == ["part"] and len(args) == 2:
        part(args[1])
    elif args == ["ensure"]:
        ensure()
    elif args == ["daemon"]:
        daemon()
    else:
        part("title")
