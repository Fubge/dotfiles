#!/usr/bin/env bash
# lock-greeting: typewriter greeting for hyprlock (label with cmd[update:40]).
# Prints the part typed so far, e.g. "Guten Abend, Raphael▍"; once complete,
# the orange caret blinks like the one next to the clock in the bar.
# The start time is remembered per hyprlock process, so every lock types anew.
set -u
pid=$(pidof -s hyprlock) || exit 0
state=${XDG_RUNTIME_DIR:-/tmp}/lock-greeting
now=$(date +%s%3N)
{ read -r spid start <"$state"; } 2>/dev/null
if [[ ${spid-} != "$pid" ]]; then
    start=$now
    echo "$pid $start" >"$state"
fi
elapsed=$((now - start))

hour=$(date +%H)
hour=${hour#0}
{{- $L := dig "machine" "lang" "en" . }}
{{- $g := .strings.greet }}
# words from the language file (.chezmoidata/locale.toml), as in the bar and session menu
if   ((hour < 5));  then hello={{ index $g.night $L | quote }}
elif ((hour < 11)); then hello={{ index $g.morning $L | quote }}
elif ((hour < 18)); then hello={{ index $g.day $L | quote }}
elif ((hour < 22)); then hello={{ index $g.evening $L | quote }}
else                     hello={{ index $g.night $L | quote }}
fi
text="$hello, ${USER^}"

delay=500   # ms: let the screen fade in first
speed=59    # ms per character (= TYPE_SPEED 17/s in ~/.local/lib/flair/typewriter.py)
typed=$(((elapsed - delay) / speed))
((typed < 0)) && typed=0
caret="<span foreground='{{ .palette.accent }}'>▍</span>"
# the rest is printed invisibly so the centered label does not shift while typing
hidden() { printf '<span alpha="1%%">%s</span>' "$1"; }
if ((typed < ${#text})); then
    printf '%s%s%s\n' "${text:0:typed}" "$caret" "$(hidden "${text:typed}")"
elif (((elapsed / 530) % 2 == 0)); then
    printf '%s%s\n' "$text" "$caret"
else
    printf '%s%s\n' "$text" "$(hidden ▍)"   # caret off, same width
fi
