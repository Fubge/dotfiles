#!/usr/bin/env bash
# Power menu (SUPER+Escape, or bar click with --bar): lock, logout, suspend, reboot, shutdown
set -uo pipefail
menu() { "$HOME/.local/bin/list-menu" "$@"; }

bar=(); [[ ${1-} == --bar ]] && bar=(--bar)

actions=(lock logout suspend reboot shutdown)
labels=($'\U000F033E  Lock' $'\U000F0343  Logout' $'\U000F0904  Suspend' $'\U000F0709  Reboot' $'\U000F0425  Shutdown')

idx=$(printf '%s\n' "${labels[@]}" | menu "${bar[@]}" --compact "Power" "") || exit 0
[[ -z $idx ]] && exit 0
case ${actions[idx]-} in
    lock)     loginctl lock-session ;;
    logout)   uwsm stop ;;
    suspend)  systemctl suspend ;;
    reboot)   systemctl reboot ;;
    shutdown) systemctl poweroff ;;
esac
