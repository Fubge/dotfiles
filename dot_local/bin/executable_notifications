#!/usr/bin/env python3
"""Notification daemon in the style of the bar popups (replaces dunst).

    notifications          run it (login autostart; a new one replaces the old)
    notifications demo     send a few sample notifications
    notifications dnd      do not disturb on / off (bar bell: right click)
    notifications quit     stop the running daemon

Owns org.freedesktop.Notifications on the session bus, so notify-send and
every app land here. The cards live in one layer-shell surface (namespace
"notifications", hypr/rules.lua) in the top right corner, below the bar.

History: every notification (not the volume / brightness bars) also goes into
~/.local/state/notifications/history.json, which the notification center
(~/.local/bin/notification-center, bar bell, SUPER+I) shows. The center talks
to this daemon over its own interface on the same object (notif.CENTER_XML):
remove, clear, do not disturb, mark read; signal Changed. The bar bell reads
$XDG_RUNTIME_DIR/notifications.status (a waybar JSON line) on every Changed.
Do not disturb: only critical cards show, the rest goes quietly to the center.

Look (style: ~/.config/popups/style.css, section "notifications"):
- a small header: the app's real icon (icon theme, ~/.local/lib/popup/notif.py),
  or for system messages a Nerd Font glyph on a rounded square in a palette
  color, then the app name and the age; pictures the app sends along (avatars,
  covers) sit as a rounded square on the right of the text
- no echoes: a summary equal to the app name is dropped, a value card
  (volume, brightness) is just the header and its bar
- a card swings in from the screen edge, its icon pops, the summary types
  itself with the orange caret (resident.type_title), like the popup titles
- a thin line along the bottom counts down; it pauses under the mouse
- leaving: slides out, the cards below glide up (Gtk.Revealer)
- critical: red frame that pulses, no timeout

Mouse: left click runs the default action (or focuses the app's window); that
and the action buttons take it out of the center's history too (and off the
bell's unread count), right click dismisses, middle click dismisses all. Volume-style updates
(same id, or the same x-canonical-private-synchronous / x-dunst-stack-tag)
change the card in place.
"""
import json
import os
import re
import subprocess
import sys
import time

LAYER_SHELL = "/usr/lib/libgtk4-layer-shell.so"
# gtk4-layer-shell must be loaded before libwayland: restart with it preloaded
if (len(sys.argv) == 1 and os.path.exists(LAYER_SHELL)
        and LAYER_SHELL not in os.environ.get("LD_PRELOAD", "")):
    os.environ["LD_PRELOAD"] = (LAYER_SHELL + " " + os.environ.get("LD_PRELOAD", "")).strip()
    os.execv(sys.executable, [sys.executable] + sys.argv)

sys.path.insert(0, os.path.expanduser("~/.local/lib/popup"))
import resident  # noqa: E402
import notif  # noqa: E402
from notif import G, NAME, PATH  # noqa: E402

CSS = os.path.expanduser("~/.config/popups/style.css")
WIDTH = 360            # card width
THUMB = 48             # picture next to the text (avatars, covers)
MAX_SHOWN = 5          # more wait in a queue
TIMEOUT = {0: 4000, 1: 6000, 2: 0}      # by urgency (low, normal, critical), ms; 0 = stays
TYPE_TOTAL_MS = 650    # the summary types itself in about this time
EXPIRED, DISMISSED, CLOSED = 1, 2, 3    # NotificationClosed reasons
HISTORY_MAX = 60       # the center keeps the newest this many
# Bar bell with new ones: the dot into bell-badge's cut out corner, measured
# for JetBrainsMono Nerd Font at the bar's 14 px (10.5 pt): letter spacing
# after the bell (1/1024 pt), dot size, dot rise (1/1024 pt)
BADGE_DOT = (-3060, "7pt", 5643)

XML = """<node><interface name="org.freedesktop.Notifications">
  <method name="Notify">
    <arg type="s" direction="in"/><arg type="u" direction="in"/>
    <arg type="s" direction="in"/><arg type="s" direction="in"/>
    <arg type="s" direction="in"/><arg type="as" direction="in"/>
    <arg type="a{sv}" direction="in"/><arg type="i" direction="in"/>
    <arg type="u" direction="out"/>
  </method>
  <method name="CloseNotification"><arg type="u" direction="in"/></method>
  <method name="GetCapabilities"><arg type="as" direction="out"/></method>
  <method name="GetServerInformation">
    <arg type="s" direction="out"/><arg type="s" direction="out"/>
    <arg type="s" direction="out"/><arg type="s" direction="out"/>
  </method>
  <method name="Quit"/>
  <signal name="NotificationClosed"><arg type="u"/><arg type="u"/></signal>
  <signal name="ActionInvoked"><arg type="u"/><arg type="s"/></signal>
</interface></node>"""


def tidy(app, summary, body, has_value):
    """No echoes: "Volume / Volume / 62 %" becomes the header plus the bar."""
    app_name = app or "Notification"
    if app_name.islower():                  # "discord" -> "Discord"
        app_name = app_name[0].upper() + app_name[1:]
    lines = [t for t in (summary.strip(), body.strip()) if t]
    if lines and lines[0].lower() == app_name.lower():
        lines.pop(0)
    if has_value:
        lines = [t for t in lines if not re.fullmatch(r"\d+\s*%?", t)]
    return app_name, (lines[0] if lines else ""), (lines[1] if len(lines) > 1 else "")


def cli(args):
    if args == ["demo"]:
        send = [
            ["-a", "Claude", "-i", "utilities-terminal", "Claude is done",
             "Refactored the bar popups and ran the tests."],
            ["-a", "discord", "T4RI0 | Marcel (#allgemein)", "gleich ne runde?"],
            ["-a", "Wi-Fi", "-t", "3000", "Wi-Fi", "Connected to Home"],
            ["-a", "GameMode", "-u", "low", "GameMode on", "Power profile: performance"],
            ["-a", "Volume", "-h", "int:value:62", "-h", "string:x-dunst-stack-tag:vol",
             "Volume", "62 %"],
            ["-a", "Battery", "-u", "critical", "Battery low", "8 % left, plug in soon"],
        ]
        for a in send:
            subprocess.run(["notify-send", *a])
    elif args == ["dnd"]:
        subprocess.run(["gdbus", "call", "--session", "--dest", NAME, "--object-path", PATH,
                        "--method", notif.CENTER_IFACE + ".ToggleDnd"], stdout=subprocess.DEVNULL)
    elif args == ["quit"]:
        subprocess.run(["gdbus", "call", "--session", "--dest", NAME, "--object-path", PATH,
                        "--method", NAME + ".Quit"], stdout=subprocess.DEVNULL)
    else:
        sys.exit(__doc__.split("\n\n")[1])


def main():
    import gi

    gi.require_version("Gtk", "4.0")
    gi.require_version("Gdk", "4.0")
    gi.require_version("Gtk4LayerShell", "1.0")
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, Pango
    from gi.repository import Gtk4LayerShell as Layer

    GLib.set_prgname("notifications")
    Gtk.init()
    provider = Gtk.CssProvider()
    provider.load_from_path(CSS)
    Gtk.StyleContext.add_provider_for_display(
        Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_USER)

    win = Gtk.Window(css_classes=["notifications"], resizable=False)
    Layer.init_for_window(win)
    Layer.set_namespace(win, "notifications")
    Layer.set_layer(win, Layer.Layer.OVERLAY)
    Layer.set_anchor(win, Layer.Edge.TOP, True)
    Layer.set_anchor(win, Layer.Edge.RIGHT, True)
    Layer.set_keyboard_mode(win, Layer.KeyboardMode.NONE)
    stack = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, css_classes=["notif-stack"])
    win.set_child(stack)

    loop = GLib.MainLoop()
    bus = [None]
    live = {}           # id -> Card
    queue = []          # Cards waiting for a free spot
    next_id = [1]
    accent = [None]

    # history for the center: loaded once, saved on every change
    state = {"dnd": False, "read_at": 0, "items": []}
    try:
        with open(notif.HISTORY) as f:
            state.update(json.load(f))
    except (OSError, ValueError):
        pass
    os.makedirs(notif.IMAGES, exist_ok=True)
    next_id[0] = max([i["id"] for i in state["items"]] + [0]) + 1

    def changed():
        """Save, tell the bar and the center."""
        tmp = notif.HISTORY + ".tmp"
        with open(tmp, "w") as f:
            json.dump(state, f)
        os.replace(tmp, notif.HISTORY)
        unread = sum(1 for i in state["items"] if i["time"] > state["read_at"])
        if state["dnd"]:
            text, cls = G["bell-sleep"], "dnd"
            tip = "Do not disturb\nClick: notifications, right click: off"
        elif unread:
            # the bell with a cut out corner, an orange dot laid into the cut
            # (one label, so nothing covers anything): BADGE_DOT says where
            text = ('<span letter_spacing="%d">%s</span><span size="%s" rise="%d" '
                    'foreground="%s">●</span>' % (*BADGE_DOT[:1], G["bell-badge"],
                                                      *BADGE_DOT[1:], caret()))
            cls = "unread"
            tip = f"{unread} new\nClick: notifications, right click: do not disturb"
        else:
            text, cls = G["bell"], "empty" if not state["items"] else "read"
            tip = "Notifications\nClick: open, right click: do not disturb"
        with open(notif.BAR_STATUS + ".tmp", "w") as f:
            f.write(json.dumps({"text": text, "class": cls, "tooltip": tip}) + "\n")
        os.replace(notif.BAR_STATUS + ".tmp", notif.BAR_STATUS)
        if bus[0]:
            bus[0].emit_signal(None, PATH, notif.CENTER_IFACE, "Changed", None)

    def drop_image(item):
        if item.get("image"):
            try:
                os.unlink(item["image"])
            except OSError:
                pass

    def remember(nid, app, entry, icon, summary, body, urgency, pix, has_default):
        items = state["items"]
        old = next((i for i in items if i["id"] == nid), None)
        if old:
            items.remove(old)
            drop_image(old)
        image = None
        if pix is not None:
            image = os.path.join(notif.IMAGES, f"{nid}.png")
            try:
                pix.savev(image, "png", [], [])
            except GLib.Error:
                image = None
        items.insert(0, {"id": nid, "app": app, "entry": entry,
                         "icon": icon if not icon.startswith(("/", "file://")) else "",
                         "summary": summary, "body": body, "urgency": urgency,
                         "time": time.time(), "image": image, "default": has_default})
        for gone in items[HISTORY_MAX:]:
            drop_image(gone)
        del items[HISTORY_MAX:]
        changed()

    def forget(nid):
        """Opened (clicked): it is dealt with, so it leaves the center too."""
        items = state["items"]
        for item in [i for i in items if i["id"] == nid]:
            items.remove(item)
            drop_image(item)

    def emit(signal, args):
        if bus[0]:
            bus[0].emit_signal(None, PATH, NAME, signal, args)

    def caret():
        if accent[0] is None:
            probe = Gtk.Label(css_classes=["notif-caret"])
            stack.append(probe)
            c = probe.get_color()
            stack.remove(probe)
            accent[0] = "#%02x%02x%02x" % tuple(round(v * 255) for v in (c.red, c.green, c.blue))
        return accent[0]

    def texture(hints, app_icon):
        """A picture sent along (image-data, image-path, or a file as icon),
        cropped to a square and scaled to THUMB at 2x: (texture, pixbuf)."""
        pix = None
        data = hints.get("image-data") or hints.get("image_data") or hints.get("icon_data")
        if data is not None:
            try:
                w, h, stride, alpha = (data.get_child_value(i).unpack() for i in (0, 1, 2, 3))
                raw = data.get_child_value(6).get_data_as_bytes()
                pix = GdkPixbuf.Pixbuf.new_from_bytes(raw, GdkPixbuf.Colorspace.RGB,
                                                      alpha, 8, w, h, stride)
            except (GLib.Error, TypeError, ValueError):
                pix = None
        if pix is None:
            for path in (hints.get("image-path"), hints.get("image_path"), app_icon):
                path = path.unpack() if isinstance(path, GLib.Variant) else path
                if path and path.startswith("file://"):
                    path = GLib.filename_from_uri(path)[0]
                if path and path.startswith("/") and os.path.isfile(path):
                    try:
                        pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 512, 512, True)
                        break
                    except GLib.Error:
                        pass
        if pix is None:
            return None, None
        w, h = pix.get_width(), pix.get_height()
        side = min(w, h)
        pix = pix.new_subpixbuf((w - side) // 2, (h - side) // 2, side, side)
        pix = pix.scale_simple(THUMB * 2, THUMB * 2, GdkPixbuf.InterpType.BILINEAR)
        fmt = Gdk.MemoryFormat.R8G8B8A8 if pix.get_has_alpha() else Gdk.MemoryFormat.R8G8B8
        return Gdk.MemoryTexture.new(pix.get_width(), pix.get_height(), fmt,
                                     pix.read_pixel_bytes(), pix.get_rowstride()), pix

    def focus_app(names):
        """Clicked without a default action: jump to the app's window."""
        try:
            clients = json.loads(resident.hypr("j/clients"))
        except ValueError:
            return
        wanted = [n.lower() for n in names if n]
        for c in clients:
            cls = c.get("class", "").lower()
            if cls and any(w == cls or w in cls for w in wanted):
                resident.hypr('dispatch hl.dsp.focus({ window = "address:%s" })' % c["address"])
                return

    class Card(Gtk.Revealer):
        def __init__(self, nid):
            super().__init__(transition_type=Gtk.RevealerTransitionType.SLIDE_DOWN,
                             transition_duration=260)
            self.nid = nid
            self.leaving = False
            self.hovered = False
            self.timeout = 0
            self.left = 0
            self.last = None
            self.created = time.time()
            self.actions = {}

            self.card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL,
                                css_classes=["notif"], overflow=Gtk.Overflow.HIDDEN)
            self.card.set_size_request(WIDTH, -1)
            self.set_child(self.card)
            inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, css_classes=["notif-inner"])
            self.card.append(inner)

            # header: app icon, app name, age, close
            head = Gtk.Box(spacing=8, css_classes=["notif-head"])
            self.icon = Gtk.Box(css_classes=["notif-icon-slot"], valign=Gtk.Align.CENTER)
            self.app = Gtk.Label(xalign=0, css_classes=["notif-app"],
                                 ellipsize=Pango.EllipsizeMode.END)
            self.age = Gtk.Label(xalign=0, css_classes=["notif-age"])
            close = Gtk.Button(label=G["close"], css_classes=["notif-close", "flat"],
                               valign=Gtk.Align.CENTER)
            close.connect("clicked", lambda _b: self.dismiss(DISMISSED))
            names = Gtk.Box(spacing=5, hexpand=True)
            names.append(self.app)
            names.append(self.age)
            for w in (self.icon, names, close):
                head.append(w)
            inner.append(head)

            # content: text, picture on the right
            content = Gtk.Box(spacing=12, css_classes=["notif-content"])
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True,
                           valign=Gtk.Align.CENTER)
            self.summary = Gtk.Label(xalign=0, wrap=True, css_classes=["notif-summary"],
                                     wrap_mode=Pango.WrapMode.WORD_CHAR, max_width_chars=30,
                                     lines=2, ellipsize=Pango.EllipsizeMode.END)
            self.body = Gtk.Label(xalign=0, wrap=True, css_classes=["notif-body"],
                                  wrap_mode=Pango.WrapMode.WORD_CHAR, max_width_chars=30,
                                  lines=4, ellipsize=Pango.EllipsizeMode.END)
            text.append(self.summary)
            text.append(self.body)
            content.append(text)
            self.thumb = Gtk.Box(css_classes=["notif-thumb"], overflow=Gtk.Overflow.HIDDEN,
                                 valign=Gtk.Align.START)
            self.thumb_image = Gtk.Image(pixel_size=THUMB)
            self.thumb.append(self.thumb_image)
            content.append(self.thumb)
            self.content = content
            inner.append(content)

            self.progress_row = Gtk.Box(spacing=10, css_classes=["notif-progress-row"])
            self.progress = Gtk.ProgressBar(hexpand=True, valign=Gtk.Align.CENTER,
                                            css_classes=["notif-progress"])
            self.progress_value = Gtk.Label(xalign=1, css_classes=["notif-progress-value"])
            self.progress_row.append(self.progress)
            self.progress_row.append(self.progress_value)
            inner.append(self.progress_row)
            self.action_box = Gtk.Box(spacing=6, homogeneous=True, css_classes=["notif-actions"])
            inner.append(self.action_box)

            self.timer = Gtk.ProgressBar(css_classes=["notif-timer"], fraction=1)
            self.card.append(self.timer)

            click = Gtk.GestureClick(button=0)
            click.connect("released", self.on_click)
            self.card.add_controller(click)
            motion = Gtk.EventControllerMotion()
            motion.connect("enter", lambda *_a: self.set_hover(True))
            motion.connect("leave", lambda *_a: self.set_hover(False))
            self.card.add_controller(motion)

        def fill(self, app, icon, summary, body, actions, hints, timeout, replacing):
            urgency = hints.get("urgency")
            urgency = urgency.unpack() if urgency is not None else 1
            entry = hints.get("desktop-entry")
            entry = entry.unpack() if entry is not None else ""
            self.names = (app, entry)
            for c in ("low", "normal", "critical"):
                self.card.remove_css_class(c)
            self.card.add_css_class(("low", "normal", "critical")[min(urgency, 2)])

            while (child := self.icon.get_first_child()):
                self.icon.remove(child)
            self.icon.append(notif.icon_widget(app, entry, icon, urgency))
            pic, self.pixbuf = texture(hints, icon)
            self.thumb_image.set_from_paintable(pic)
            self.thumb.set_visible(pic is not None)

            value = hints.get("value")
            app_name, summary, body = tidy(app, summary, body, value is not None)

            self.app.set_text(app_name)
            self.refresh_age()
            if getattr(self.summary, "type_timer", None):
                GLib.source_remove(self.summary.type_timer)
                self.summary.type_timer = None
            self.summary.set_text(summary)
            self.summary.full_text = summary
            self.summary.set_visible(bool(summary))
            self.clean = (app_name, entry, icon, summary, body, min(urgency, 2))
            markup = notif.body_markup(body)
            try:
                Pango.parse_markup(markup, -1, "\0")
                self.body.set_markup(markup)
            except GLib.Error:
                self.body.set_text(body)
            self.body.set_visible(bool(body))
            self.content.set_visible(bool(summary or body or pic))

            self.progress_row.set_visible(value is not None)
            if value is not None:
                v = max(0, min(100, int(value.unpack())))
                self.progress.set_fraction(v / 100)
                self.progress_value.set_text(f"{v}%")

            while (child := self.action_box.get_first_child()):
                self.action_box.remove(child)
            self.actions = dict(zip(actions[::2], actions[1::2]))
            for key, label in self.actions.items():
                if key == "default":
                    continue
                b = Gtk.Button(label=label or key, css_classes=["item-action", "flat"])
                b.connect("clicked", lambda _b, k=key: self.invoke(k))
                self.action_box.append(b)
            self.action_box.set_visible(self.action_box.get_first_child() is not None)

            if timeout < 0:
                timeout = TIMEOUT[min(urgency, 2)]
            self.timeout = self.left = timeout
            self.last = None
            self.timer.set_visible(timeout > 0)
            self.timer.set_fraction(1)
            if replacing:          # same card, new content: a little bump, no typing
                self.card.remove_css_class("bump")
                GLib.timeout_add(16, lambda: self.card.add_css_class("bump") and False)

        def show_in(self):
            self.card.add_css_class("entering")
            self.set_reveal_child(True)
            GLib.timeout_add(900, lambda: self.card.remove_css_class("entering") and False)
            text = self.summary.get_text()
            if text:
                step = max(12, min(45, TYPE_TOTAL_MS // max(1, len(text))))
                GLib.timeout_add(140, lambda: resident.type_title(
                    self.summary, caret(), step) and False)
            self.add_tick_callback(self.tick)

        def tick(self, _w, clock):
            if self.leaving:
                return False
            now = clock.get_frame_time()
            if self.timeout > 0 and not self.hovered and self.last is not None:
                self.left -= (now - self.last) / 1000
                self.timer.set_fraction(max(0, self.left / self.timeout))
                if self.left <= 0:
                    self.dismiss(EXPIRED)
                    return False
            self.last = now
            return True

        def set_hover(self, on):
            self.hovered = on
            (self.card.add_css_class if on else self.card.remove_css_class)("hover")

        def refresh_age(self):
            self.age.set_text("· " + notif.age_text(self.created))

        def on_click(self, gesture, _n, _x, _y):
            button = gesture.get_current_button()
            if button == 1:
                if "default" in self.actions:
                    self.invoke("default")
                    return
                self.opened()
                focus_app(self.names)
                self.dismiss(DISMISSED)
            elif button == 3:
                self.dismiss(DISMISSED)
            elif button == 2:
                for card in list(live.values()) + list(queue):
                    card.dismiss(DISMISSED)

        def invoke(self, key):
            # any action counts as opened (Claude's "Open" button, not only
            # a click on the card)
            self.opened()
            emit("ActionInvoked", GLib.Variant("(us)", (self.nid, key)))
            self.dismiss(DISMISSED)

        def opened(self):
            """Dealt with: off the center's list, the bell's dot goes with it."""
            forget(self.nid)
            changed()

        def dismiss(self, reason):
            if self.leaving:
                return
            self.leaving = True
            emit("NotificationClosed", GLib.Variant("(uu)", (self.nid, reason)))
            live.pop(self.nid, None)
            if self in queue:
                queue.remove(self)
                return
            self.card.add_css_class("leaving")
            GLib.timeout_add(240, self.collapse)

        def collapse(self):
            self.connect("notify::child-revealed", self.gone)
            self.set_reveal_child(False)
            return False

        def gone(self, *_a):
            if self.get_child_revealed():
                return
            stack.remove(self)
            shown = [c for c in iter_children(stack)]
            if queue and len(shown) < MAX_SHOWN:
                place(queue.pop(0))
            elif not shown:
                win.set_visible(False)
            win.set_default_size(-1, -1)

    def iter_children(box):
        c = box.get_first_child()
        while c is not None:
            yield c
            c = c.get_next_sibling()

    def place(card):
        stack.prepend(card)                 # newest on top
        win.set_visible(True)
        card.show_in()

    def find_stack_tag(app, hints):
        for key in ("x-canonical-private-synchronous", "x-dunst-stack-tag", "synchronous"):
            if key in hints:
                tag = (app, str(hints[key].unpack()))
                for card in live.values():
                    if getattr(card, "tag", None) == tag and not card.leaving:
                        return card, tag
                return None, tag
        return None, None

    def notify(params):
        app, replaces, icon, summary, body, actions, _hints, timeout = params.unpack()
        raw = params.get_child_value(6)
        hints = {raw.get_child_value(i).get_child_value(0).get_string():
                 raw.get_child_value(i).get_child_value(1).get_variant()
                 for i in range(raw.n_children())}
        urgency = hints["urgency"].unpack() if "urgency" in hints else 1
        entry = hints["desktop-entry"].unpack() if "desktop-entry" in hints else ""
        transient = "transient" in hints and bool(hints["transient"].unpack())
        keep = "value" not in hints and not transient      # bars do not go to the center
        has_default = "default" in actions[::2]

        def record(nid, pix):
            if keep:
                name, s, b = tidy(app, summary, body, False)
                remember(nid, name, entry, icon, s, b, min(urgency, 2), pix, has_default)

        card = live.get(replaces) if replaces else None
        tag_card, tag = find_stack_tag(app, hints)
        card = card or tag_card
        if card and not card.leaving:
            card.fill(app, icon, summary, body, actions, hints, timeout, replacing=True)
            card.tag = tag
            record(card.nid, card.pixbuf)
            return card.nid
        nid = replaces if replaces and any(i["id"] == replaces for i in state["items"]) \
            else next_id[0]
        if nid == next_id[0]:
            next_id[0] += 1
        if state["dnd"] and urgency < 2:          # quietly into the center
            record(nid, texture(hints, icon)[1])
            return nid
        card = Card(nid)
        card.tag = tag
        card.fill(app, icon, summary, body, actions, hints, timeout, replacing=False)
        record(nid, card.pixbuf)
        live[nid] = card
        if sum(1 for _ in iter_children(stack)) >= MAX_SHOWN:
            queue.append(card)
        else:
            place(card)
        return nid

    def method_call(_conn, _sender, _path, _iface, method, params, invocation):
        if method == "Notify":
            invocation.return_value(GLib.Variant("(u)", (notify(params),)))
        elif method == "CloseNotification":
            (nid,) = params.unpack()
            card = live.get(nid)
            if card:
                card.dismiss(CLOSED)
            invocation.return_value(None)
        elif method == "GetCapabilities":
            invocation.return_value(GLib.Variant("(as)", (
                ["actions", "body", "body-markup", "icon-static", "persistence",
                 "x-canonical-private-synchronous", "x-dunst-stack-tag"],)))
        elif method == "GetServerInformation":
            invocation.return_value(GLib.Variant("(ssss)", ("notifications", "dotfiles",
                                                            "1.0", "1.2")))
        elif method == "Quit":
            invocation.return_value(None)
            loop.quit()

    def center_call(_conn, _sender, _path, _iface, method, params, invocation):
        items = state["items"]
        if method == "Get":
            invocation.return_value(GLib.Variant("(s)", (json.dumps(state),)))
            return
        if method == "Remove":
            (nid,) = params.unpack()
            forget(nid)
            if nid in live:
                live[nid].dismiss(DISMISSED)
        elif method == "Clear":
            for item in items:
                drop_image(item)
            items.clear()
            for card in list(live.values()) + list(queue):
                card.dismiss(DISMISSED)
        elif method in ("SetDnd", "ToggleDnd"):
            state["dnd"] = params.unpack()[0] if method == "SetDnd" else not state["dnd"]
            if state["dnd"]:
                for card in list(live.values()) + list(queue):
                    if not card.card.has_css_class("critical"):
                        card.dismiss(DISMISSED)
        elif method == "MarkRead":
            state["read_at"] = time.time()
        elif method == "Invoke":
            (nid,) = params.unpack()
            item = next((i for i in items if i["id"] == nid), None)
            if item and item.get("default"):
                emit("ActionInvoked", GLib.Variant("(us)", (nid, "default")))
            elif item:
                focus_app((item["app"], item["entry"]))
            forget(nid)
            if nid in live:
                live[nid].dismiss(DISMISSED)
        invocation.return_value(None)
        changed()

    def acquired(conn, _name):
        bus[0] = conn
        node = Gio.DBusNodeInfo.new_for_xml(XML)
        conn.register_object(PATH, node.interfaces[0], method_call, None, None)
        center = Gio.DBusNodeInfo.new_for_xml(notif.CENTER_XML)
        conn.register_object(PATH, center.interfaces[0], center_call, None, None)
        changed()

    def lost(_conn, _name):
        loop.quit()                     # another daemon took over (or no bus)

    Gio.bus_own_name(Gio.BusType.SESSION, NAME,
                     Gio.BusNameOwnerFlags.ALLOW_REPLACEMENT | Gio.BusNameOwnerFlags.REPLACE,
                     acquired, None, lost)

    def ages():
        for card in live.values():
            card.refresh_age()
        return True
    GLib.timeout_add_seconds(20, ages)
    loop.run()


if __name__ == "__main__":
    if sys.argv[1:]:
        cli(sys.argv[1:])
    else:
        main()
