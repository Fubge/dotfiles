#!/usr/bin/env bash
# SUPER+Return: type a query, search the web. Small search pill, top edge at
# the same height as the app launcher (optical center, a bit above the middle).
# rofi counts y from below the bar (8 px margin + 22 px bar).
query=$(rofi -dmenu -p "Web" -theme overlay -theme-str '
    window       { location: north; anchor: north; y-offset: {{ sub .design.launcher_top 30 }}px; width: {{ .design.websearch_width }}px; height: 0; padding: 20px 20px 12px 20px; }
    mainbox      { children: [ inputbar, textbox-hint ]; spacing: 12px; }
    box-search   { width: {{ sub .design.websearch_width 40 }}px; }
    entry        { placeholder: "Search the web..."; }
    textbox-hint { str: "Enter  search      ·      Esc  close"; }
') || exit 0
exec "$HOME/.local/bin/websearch" "$query"
