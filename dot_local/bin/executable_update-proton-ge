#!/usr/bin/env bash
# Install the latest GE-Proton release into Steam's compatibility tools folder.
# Afterwards restart Steam and pick it under Properties > Compatibility.
set -euo pipefail

dest="$HOME/.steam/root/compatibilitytools.d"
api="https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest"
mkdir -p "$dest"

release=$(curl -fsSL "$api")
tag=$(jq -r .tag_name <<<"$release")
if [[ -d $dest/$tag ]]; then
    echo "$tag is already installed."
    exit 0
fi

# Pick the x86_64 build (newer releases also ship aarch64)
asset() {
    jq -r --arg ext "$1" '[.assets[] | select(.name | endswith($ext)) | select(.name | contains("aarch64") | not)][0]' <<<"$release"
}
tar_name=$(asset .tar.gz | jq -r .name)
tar_url=$(asset .tar.gz | jq -r .browser_download_url)
sum_url=$(asset .sha512sum | jq -r .browser_download_url)
[[ $tar_url == https://* && $sum_url == https://* ]] || { echo "No x86_64 asset found for $tag" >&2; exit 1; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
echo "Downloading $tag ..."
curl -fL --progress-bar -o "$tmp/$tar_name" "$tar_url"
curl -fsSL -o "$tmp/checksum" "$sum_url"
(cd "$tmp" && sha512sum -c checksum)

tar -xzf "$tmp/$tar_name" -C "$dest"
echo "Installed $tag to $dest. Restart Steam to use it."
