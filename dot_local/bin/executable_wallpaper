#!/usr/bin/env bash
# wallpaper: choose and switch wallpapers (hyprpaper backend).
#   wallpaper pick        grid menu with previews (SUPER+W)
#   wallpaper set FILE    set a specific image (until the next login)
#   wallpaper login FILE  set the login screen (SDDM) background
#   wallpaper shuffle     switch to shuffle mode: random image now and every 30 min
#   wallpaper tick        called by the timer; changes image only in shuffle mode
#   wallpaper random      at every login (wallpaper-random.service, before hyprpaper):
#                         random desktop image + a different one for the login screen
# In the menu: Enter = desktop, Shift+Enter = login screen, Ctrl+Enter = both.
# Images come from ~/Pictures/Wallpapers (incl. subfolders, e.g. anime/).
set -uo pipefail

dirs=("$HOME/Pictures/Wallpapers")
state="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper"
thumbs="${XDG_CACHE_HOME:-$HOME/.cache}/wallpaper-thumbs"
login_dir=/var/lib/login-wallpaper   # user-owned, read by the SDDM theme "slate"
mkdir -p "$state" "$thumbs"

list_images() {
    find -L "${dirs[@]}" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
        2>/dev/null | sort
}

apply() {
    ln -sfn "$1" "$state/current"            # hyprpaper.conf points here (used at login)
    hyprctl hyprpaper wallpaper ",$1" >/dev/null
}

set_fixed() {
    echo fixed > "$state/mode"
    apply "$1"
}

set_login() {   # cropped to the panel size as JPEG, so SDDM never chokes on webp etc.
    [[ -w $login_dir ]] || { notify-send "Wallpapers" "$login_dir missing (chezmoi apply)"; return 1; }
    local tmp="$login_dir/.new.jpg" size
    size=$(hyprctl monitors -j 2>/dev/null | jq -r 'max_by(.width) | "\(.width)x\(.height)"' 2>/dev/null)
    [[ $size == *x* ]] || size=1920x1080
    magick "$1[0]" -resize "$size^" -gravity center -extent "$size" -quality 92 "$tmp" &&
        mv -f "$tmp" "$login_dir/background.jpg" &&
        ln -sfn "$1" "$state/login" &&
        { [[ ${2:-} == quiet ]] || notify-send -t 2000 "Wallpapers" "Login screen: $(basename "${1%.*}")"; }
}

random_image() {
    local current
    current=$(readlink "$state/current" 2>/dev/null)
    list_images | grep -vxF "$current" | shuf -n 1
}

thumbnail() {   # cached 480x300 preview for the menu
    local thumb="$thumbs/$(printf '%s' "$1" | md5sum | cut -c1-16).jpg"
    [[ -f $thumb && $thumb -nt $1 ]] ||
        magick "$1[0]" -thumbnail 480x300^ -gravity center -extent 480x300 -quality 85 "$thumb" 2>/dev/null
    printf '%s' "$thumb"
}

pick() {
    mapfile -t images < <(list_images)
    if ((${#images[@]} > 0)) && [[ -n $(for i in "${images[@]}"; do t="$thumbs/$(printf '%s' "$i" | md5sum | cut -c1-16).jpg"; [[ -f $t ]] || echo x; done | head -1) ]]; then
        notify-send -t 2000 "Wallpapers" "Creating previews..."
    fi

    local mode idx rc; mode=$(cat "$state/mode" 2>/dev/null || echo fixed)
    idx=$({
        printf '%s\0icon\x1f%s\n' "Shuffle$([[ $mode == shuffle ]] && echo ' (on)')" "media-playlist-shuffle"
        for img in "${images[@]}"; do
            name=$(basename "${img%.*}")
            printf '%s\0icon\x1f%s\n' "$name" "$(thumbnail "$img")"
        done
    } | rofi -dmenu -i -show-icons -format i -p "Wallpaper" -theme overlay \
        -kb-accept-alt "" -kb-accept-custom "" \
        -kb-custom-1 "Shift+Return" -kb-custom-2 "Control+Return" -theme-str '
        entry    { placeholder: "Filter wallpapers..."; }
        listview { columns: 4; lines: 3; flow: horizontal; fixed-columns: true; spacing: 6px; }
        element  { orientation: vertical; padding: 10px 8px 8px 8px; spacing: 6px; }
        element-icon { size: 140px; horizontal-align: 0.5; }
        element-text { font: @font-ui; horizontal-align: 0.5; }
        textbox-hint { str: "Enter  desktop      ·      Shift+Enter  login screen      ·      Ctrl+Enter  both      ·      Esc  close"; }
    ')
    rc=$?   # rofi: 0 Enter, 10 Shift+Enter, 11 Ctrl+Enter, 1 Esc
    [[ -n $idx ]] || return 0
    if [[ $idx == 0 ]]; then
        shuffle
        return
    fi
    local img=${images[idx - 1]}
    [[ $rc == 10 ]] || set_fixed "$img"
    [[ $rc == 0 ]] || set_login "$img"
}

shuffle() {
    echo shuffle > "$state/mode"
    apply "$(random_image)"
}

case "${1:-pick}" in
    pick) pick ;;
    set) [[ -f ${2:-} ]] && set_fixed "$(realpath "$2")" || { echo "usage: wallpaper set FILE" >&2; exit 1; } ;;
    login) [[ -f ${2:-} ]] && set_login "$(realpath "$2")" || { echo "usage: wallpaper login FILE" >&2; exit 1; } ;;
    shuffle) shuffle ;;
    random)
        desk=$(random_image)
        [[ -n $desk ]] || exit 0
        ln -sfn "$desk" "$state/current"   # hyprpaper starts after this and reads the link
        login=$(list_images | grep -vxF "$desk" | grep -vxF "$(readlink "$state/login" 2>/dev/null)" | shuf -n 1)
        [[ -n $login ]] && set_login "$login" quiet
        ;;
    tick) if [[ $(cat "$state/mode" 2>/dev/null) == shuffle ]]; then apply "$(random_image)"; fi ;;
    *) sed -n '2,11p' "$0"; exit 1 ;;
esac
