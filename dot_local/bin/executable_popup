#!/usr/bin/env bash
# popup CLASS CMD...: open CMD as a floating popup under the mouse,
# or close it if it is already open (click the bar icon again to dismiss).
# An open menu from the bar is closed first (only one menu at a time).
class=$1; shift
addr=$(hyprctl clients -j | jq -r --arg c "$class" '.[] | select(.class == $c) | .address' | head -1)
if [[ -n $addr ]]; then
    hyprctl dispatch "hl.dsp.window.close({window = \"address:$addr\"})" >/dev/null
else
    # No bar tooltips on top of the popup while it is open (~/.local/bin/bar-tooltips);
    # uwsm-app (scope) runs in the foreground, so the trap fires when the popup closes
    "$HOME/.local/bin/bar-tooltips" off $$
    trap '"$HOME/.local/bin/bar-tooltips" on $$' EXIT
    "$HOME/.local/bin/list-menu" --close
    uwsm-app -- "$@"
fi
