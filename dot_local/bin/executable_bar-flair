#!/usr/bin/env python3
"""Typewriter modules for waybar (the look is in ~/.local/lib/flair/typewriter.py).

  bar-flair window   name of the focused app; on focus change the old name is
                     erased and the new one typed in (replaces hyprland/window).
                     Right after login it first types a greeting
                     ("Guten Abend, Raphael"), once per session
  bar-flair wifi     next to the network icon: the Wi-Fi name types itself in
                     when a connection comes up ("offline" when it drops),
                     stays a few seconds and is erased again
"""
import json
import os
import re
import socket
import subprocess
import sys
import threading
import time

sys.path.insert(0, os.path.expanduser("~/.local/lib/flair"))
from typewriter import Typewriter  # noqa: E402

FPS = 60
# Friendly names instead of raw window classes (regex on the class)
NAMES = [
    (r"org\.pulseaudio\.pavucontrol", "Volume"),
    (r"vivaldi-stable", "Vivaldi"),
    (r"org\.kde\.dolphin", "Files"),
    (r"kitty|popup-term|dropdown_terminal", "Terminal"),
    (r"discord", "Discord"),
    (r"obsidian", "Obsidian"),
    (r"claude_pad", "Claude"),
    (r"[Ss]potify", "Spotify"),
    (r"popup\.keybinds", "Shortcuts"),
    (r"popup\.brightness", "Brightness"),
]
MAX_LEN = 16             # longer names end in "…": the left pill must not reach the clock
WIFI_HOLD = 4.0          # seconds the Wi-Fi name stays before it is erased
GREET_HOLD = 4.0         # seconds the login greeting stays

changed = threading.Event()


def emit(text, tooltip=""):
    print(json.dumps({"text": text, "tooltip": tooltip}), flush=True)


def run(tw, on_idle=None):
    """Print frames while the typewriter is busy, sleep otherwise."""
    last = None
    while True:
        markup, busy = tw.frame()
        if markup != last:
            emit(markup)
            last = markup
        if on_idle and not busy:
            on_idle()
        timeout = 1 / FPS if busy else None
        if changed.wait(timeout):
            changed.clear()


# --------------------------------------------------------------- window
def friendly(cls):
    for pattern, name in NAMES:
        if re.fullmatch(pattern, cls):
            return name
    name = cls.split(".")[-1] if cls else ""
    name = name[:1].upper() + name[1:]
    return name if len(name) <= MAX_LEN else name[:MAX_LEN - 1] + "…"


def greeting():
    h = time.localtime().tm_hour
    hello = ("Gute Nacht" if h < 5 else "Guten Morgen" if h < 11 else
             "Guten Tag" if h < 18 else "Guten Abend" if h < 22 else "Gute Nacht")
    return f"{hello}, {os.environ.get('USER', '').capitalize()}"


def first_start():
    """True once per login (the runtime dir is emptied on logout), so a
    restart of waybar does not greet again."""
    flag = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "flair-greeted")
    try:
        open(flag, "x").close()
        return True
    except OSError:
        return False


def window():
    tw = Typewriter()
    current = {"name": ""}
    out = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True).stdout
    try:
        current["name"] = friendly(json.loads(out).get("class", ""))
    except ValueError:
        pass
    greeting_until = 0.0
    if first_start():
        tw.set(greeting())
        greeting_until = time.monotonic() + len(tw.target) / tw.type_speed + GREET_HOLD

        def end_greeting():
            tw.set(current["name"])
            changed.set()
        threading.Timer(greeting_until - time.monotonic(), end_greeting).start()
    else:
        tw.set(current["name"])

    def show(name):
        current["name"] = name
        if time.monotonic() >= greeting_until:   # the greeting is not cut off
            tw.set(name)
            changed.set()

    def listen():
        path = os.path.join(os.environ["XDG_RUNTIME_DIR"], "hypr",
                            os.environ["HYPRLAND_INSTANCE_SIGNATURE"], ".socket2.sock")
        while True:
            try:
                with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                    s.connect(path)
                    for line in s.makefile(encoding="utf-8", errors="replace"):
                        if line.startswith("activewindow>>"):
                            cls = line[len("activewindow>>"):].split(",", 1)[0]
                            show(friendly(cls))
            except OSError:
                time.sleep(2)

    threading.Thread(target=listen, daemon=True).start()
    run(tw)


# --------------------------------------------------------------- wifi
def wifi_name():
    out = subprocess.run(["nmcli", "-t", "-f", "TYPE,STATE,CONNECTION", "device"],
                         capture_output=True, text=True).stdout
    for line in out.splitlines():
        parts = line.split(":", 2)
        if len(parts) == 3 and parts[0] == "wifi" and parts[1] == "connected":
            return parts[2].replace("\\:", ":")
    return ""


def wifi():
    tw = Typewriter()
    state = {"name": wifi_name(), "hide_at": None}

    def check():
        name = wifi_name()
        if name != state["name"]:
            state["name"] = name
            tw.set(name or "offline")
            state["hide_at"] = None
            changed.set()

    def listen():
        while True:
            proc = subprocess.Popen(["nmcli", "monitor"], stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL, text=True)
            for _ in proc.stdout:
                time.sleep(0.3)   # events come in bursts, let the state settle
                check()
            proc.wait()
            time.sleep(2)

    def on_idle():
        # typed in completely: erase it again after a while
        if tw.target and state["hide_at"] is None:
            state["hide_at"] = time.monotonic() + WIFI_HOLD
            shown = tw.target

            def erase():
                if tw.target == shown:   # not if a newer change came in meanwhile
                    tw.set("")
                    changed.set()
            threading.Timer(WIFI_HOLD, erase).start()
        elif not tw.target:
            state["hide_at"] = None

    threading.Thread(target=listen, daemon=True).start()
    run(tw, on_idle)


if __name__ == "__main__":
    {"window": window, "wifi": wifi}.get(sys.argv[1] if len(sys.argv) > 1 else "", lambda: sys.exit(
        "usage: bar-flair window|wifi"))()
