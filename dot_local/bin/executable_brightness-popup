#!/usr/bin/env python3
"""Brightness slider (click on the brightness icon in the bar), and the
keyboard backlight below it when the laptop has one.

    brightness-popup toggle    bar click: show it, or hide it when open
    brightness-popup --hidden  login autostart: waits hidden, opens instantly
    brightness-popup quit      stop it (it reloads on the next click)

A tiny GTK4 window that stays alive in the background and only hides
(~/.local/lib/popup/resident.py), placed under the mouse like the other bar
popups; Hyprland closes it when it loses focus (hypr/rules.lua). Drag, click
or scroll the slider; Escape closes. A keyboard backlight with a few steps
(ThinkPad: off / low / high) gets one button per step, a finer one a slider. The
percentage is perceived brightness (square-root curve, like the brightness
keys: brightnessctl -e2), spread over the hardware range: 1% = darkest step
(raw 1; 0 is panel off), 100% = full. ~/.local/bin/brightness shows the same
numbers in the bar.
"""
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, os.path.expanduser("~/.local/lib/popup"))
import resident  # noqa: E402

# first backlight device (intel_backlight, amdgpu_bl0, ...)
DEVICE = next(Path("/sys/class/backlight").iterdir(), Path("/sys/class/backlight/none"))
EXPONENT = 2
CSS = Path.home() / ".config/popups/style.css"
ICONS = ["\U000F0594", "\U000F0595", "\U000F05A8"]  # moon / cloud / sun, as in the bar
I_KEYBOARD = "\U000F030C"
WIDTH = 300
# keyboard backlight LED (tpacpi::kbd_backlight, asus::kbd_backlight, ...)
KBD = next(Path("/sys/class/leds").glob("*kbd_backlight"), None)
KBD_STEPS = 3        # up to this many levels: buttons, more: a slider


def to_percent(raw):
    top = int((DEVICE / "max_brightness").read_text())
    return int((max(0, raw - 1) / (top - 1)) ** (1 / EXPONENT) * 99 + 1.5)


def read_percent():
    return to_percent(int((DEVICE / "brightness").read_text()))


def to_raw(percent):
    top = int((DEVICE / "max_brightness").read_text())
    return 1 + round((top - 1) * ((percent - 1) / 99) ** EXPONENT)


def write_percent(percent):
    subprocess.run(["brightnessctl", "-q", "set", str(to_raw(percent))], check=False)


def kbd_read():
    try:
        return int((KBD / "brightness").read_text()), int((KBD / "max_brightness").read_text())
    except (OSError, ValueError, TypeError):
        return None, None


def kbd_write(level):
    subprocess.Popen(["brightnessctl", "-q", "-d", KBD.name, "set", str(level)])


def build():
    import gi

    gi.require_version("Gtk", "4.0")
    gi.require_version("Gdk", "4.0")
    from gi.repository import Gdk, GLib, Gtk

    class Popup(Gtk.Window):
        popup_width = WIDTH       # resident.place() puts it under the mouse

        def __init__(self):
            super().__init__(title="Brightness")
            for c in ("popup", "menu", "brightness"):
                self.add_css_class(c)
            self.set_decorated(False)
            self.set_default_size(WIDTH, 1)
            self.pending = None
            self.loading = False

            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, css_classes=["menu-box"])
            box.append(Gtk.Label(label="Brightness", css_classes=["menu-title"]))
            row = Gtk.Box(spacing=12, css_classes=["slider-row"])
            self.icon = Gtk.Label(css_classes=["slider-icon"])
            self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 1, 100, 1)
            self.scale.set_draw_value(False)
            self.scale.set_hexpand(True)
            self.value = Gtk.Label(css_classes=["slider-value"], xalign=1)
            for widget in (self.icon, self.scale, self.value):
                row.append(widget)
            box.append(row)
            self.kbd_buttons = []
            self.kbd_scale = None
            _level, top = kbd_read()
            if top:
                box.append(self.keyboard_row(top))
            self.set_child(box)
            self.scale.connect("value-changed", self.on_change)

            keys = Gtk.EventControllerKey()
            keys.connect("key-pressed", self.on_key)
            self.add_controller(keys)

        def keyboard_row(self, top):
            row = Gtk.Box(spacing=12, css_classes=["slider-row", "kbd-row"])
            row.append(Gtk.Label(label=I_KEYBOARD, css_classes=["slider-icon"]))
            if top <= KBD_STEPS:
                names = ["Off", "Low", "High"] if top == 2 else \
                    ["Off"] + [str(i) for i in range(1, top + 1)]
                seg = Gtk.Box(spacing=6, homogeneous=True, hexpand=True,
                              css_classes=["segments"])
                for level, name in enumerate(names):
                    b = Gtk.Button(label=name, css_classes=["segment", "flat", "small"])
                    b.connect("clicked", lambda _b, lv=level: (kbd_write(lv),
                                                               self.show_kbd(lv)))
                    self.kbd_buttons.append(b)
                    seg.append(b)
                row.append(seg)
            else:
                self.kbd_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, top, 1)
                self.kbd_scale.set_draw_value(False)
                self.kbd_scale.set_hexpand(True)
                self.kbd_scale.connect("value-changed", lambda s: self.loading or
                                       kbd_write(int(s.get_value())))
                row.append(self.kbd_scale)
            return row

        def show_kbd(self, level):
            for i, b in enumerate(self.kbd_buttons):
                (b.add_css_class if i == level else b.remove_css_class)("active")
            if self.kbd_scale:
                self.loading = True
                self.kbd_scale.set_value(level)
                self.loading = False

        def show_up(self):
            # the brightness may have changed by keys since the last time
            self.loading = True
            self.scale.set_value(read_percent())
            self.loading = False
            level, _top = kbd_read()
            if level is not None:
                self.show_kbd(level)
            self.set_default_size(WIDTH, 1)
            self.update_labels()
            self.present()
            self.scale.grab_focus()

        def update_labels(self):
            # the value that really gets set (the darkest hardware steps are coarse)
            percent = to_percent(to_raw(int(self.scale.get_value())))
            self.value.set_text(f"{percent}%")
            self.icon.set_text(ICONS[0 if percent <= 33 else 1 if percent <= 66 else 2])

        def on_change(self, _scale):
            if self.loading:
                return
            self.update_labels()
            # apply at most every 30 ms while dragging
            if self.pending is None:
                self.pending = GLib.timeout_add(30, self.apply)

        def apply(self):
            write_percent(int(self.scale.get_value()))
            self.pending = None
            return False

        def on_key(self, _ctrl, keyval, _code, _state):
            if keyval == Gdk.KEY_Escape:
                self.close()
                return True
            return False

    provider = Gtk.CssProvider()
    provider.load_from_path(str(CSS))
    Gtk.StyleContext.add_provider_for_display(
        Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_USER)
    return Popup()


if __name__ == "__main__":
    resident.main("popup.brightness", build, __doc__)
