#!/usr/bin/env python3
"""Brightness slider (click on the brightness icon in the bar).

A tiny GTK4 window; Hyprland floats it under the mouse and closes it when it
loses focus (window rule for class "popup.brightness", see hypr/rules.lua).
Drag, click or scroll the slider; Escape closes. The percentage is perceived
brightness (square-root curve, like the brightness keys: brightnessctl -e2),
spread over the hardware range: 1% = darkest step (raw 1; 0 is panel off),
100% = full. ~/.local/bin/brightness shows the same numbers in the bar.
"""
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

DEVICE = Path("/sys/class/backlight/intel_backlight")
EXPONENT = 2
CSS = Path.home() / ".config/popups/style.css"
ICONS = ["\U000F0594", "\U000F0595", "\U000F05A8"]  # moon / cloud / sun, as in the bar


def to_percent(raw):
    top = int((DEVICE / "max_brightness").read_text())
    return int((max(0, raw - 1) / (top - 1)) ** (1 / EXPONENT) * 99 + 1.5)


def read_percent():
    return to_percent(int((DEVICE / "brightness").read_text()))


def to_raw(percent):
    top = int((DEVICE / "max_brightness").read_text())
    return 1 + round((top - 1) * ((percent - 1) / 99) ** EXPONENT)


def write_percent(percent):
    subprocess.run(["brightnessctl", "-q", "set", str(to_raw(percent))], check=False)


class Popup(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Brightness")
        self.add_css_class("popup")
        self.add_css_class("menu")  # same look as the rofi menus
        self.set_decorated(False)
        self.pending = None

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, css_classes=["menu-box"])
        box.append(Gtk.Label(label="Brightness", css_classes=["menu-title"]))
        row = Gtk.Box(spacing=12, css_classes=["slider-row"])
        self.icon = Gtk.Label(css_classes=["slider-icon"])
        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 1, 100, 1)
        self.scale.set_draw_value(False)
        self.scale.set_hexpand(True)
        self.value = Gtk.Label(css_classes=["slider-value"], xalign=1)
        for widget in (self.icon, self.scale, self.value):
            row.append(widget)
        box.append(row)
        self.set_child(box)

        self.scale.set_value(read_percent())
        self.update_labels()
        self.scale.connect("value-changed", self.on_change)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)

    def update_labels(self):
        # the value that really gets set (the darkest hardware steps are coarse)
        percent = to_percent(to_raw(int(self.scale.get_value())))
        self.value.set_text(f"{percent}%")
        self.icon.set_text(ICONS[0 if percent <= 33 else 1 if percent <= 66 else 2])

    def on_change(self, _scale):
        self.update_labels()
        # apply at most every 30 ms while dragging
        if self.pending is None:
            self.pending = GLib.timeout_add(30, self.apply)

    def apply(self):
        write_percent(int(self.scale.get_value()))
        self.pending = None
        return False

    def on_key(self, _ctrl, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False


def main():
    app = Gtk.Application(application_id="popup.brightness")

    def activate(app):
        provider = Gtk.CssProvider()
        provider.load_from_path(str(CSS))
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_USER
        )
        Popup(app).present()

    app.connect("activate", activate)
    return app.run([])


if __name__ == "__main__":
    sys.exit(main())
