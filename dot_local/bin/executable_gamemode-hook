#!/usr/bin/env bash
# Called by GameMode: switch to the performance power profile while gaming,
# afterwards pick the profile that fits the power source again.
case "$1" in
    start)
        powerprofilesctl set performance
        notify-send -a GameMode -i applications-games "GameMode on" "Power profile: performance"
        ;;
    end)
        /usr/local/bin/power-profile-auto
        notify-send -a GameMode -i applications-games "GameMode off" "Power profile: $(powerprofilesctl get)"
        ;;
esac
