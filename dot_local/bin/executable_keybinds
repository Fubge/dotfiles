#!/usr/bin/env python3
"""Shortcut overview (SUPER+H).

Built live from `hyprctl binds -j`: every bind with a description in
hypr/binds.lua shows up, grouped by the "Group: text" prefix of its description,
so this never goes stale. Typing filters; Escape closes.
Look: ~/.config/popups/style.css (shared with the other popups).

    keybinds toggle   SUPER+H: show it, or hide it when open
    keybinds --hidden login autostart: waits hidden, opens instantly
    keybinds quit     stop it (it reloads on the next press)

Resident like the bar popups (~/.local/lib/popup/resident.py): starting Python,
GTK and a Gtk.Application took ~1.2 s per press. The binds are read again on
every show, so a changed binds.lua shows up without a restart.
"""
import json
import os
import sys

sys.path.insert(0, os.path.expanduser("~/.local/lib/popup"))
import resident  # noqa: E402

APP = "popup.keybinds"
CSS = os.path.expanduser("~/.config/popups/style.css")
# Hyprland modmask bits, in the order they are shown
MODS = [(64, "SUPER"), (4, "CTRL"), (8, "ALT"), (1, "SHIFT")]
KEY_NAMES = {
    "mouse:272": "Drag", "mouse:273": "Right drag",
    "mouse_down": "Wheel ↓", "mouse_up": "Wheel ↑",
    "space": "Space", "Return": "Enter", "Escape": "Esc",
    # arrows and workspaces: only the first bind of each set has a description
    "left": "← ↑ → ↓", "1": "1 … 0",
}


# binds by keycode (layout independent) have no key name
KEYCODES = {49: "^"}


def load_binds(raw):
    """hyprctl binds JSON -> {group: [(keys, text), ...]} in the order of binds.lua"""
    try:
        binds = json.loads(raw or "[]")
    except ValueError:
        binds = []
    groups = {}
    for b in binds:
        if not b.get("has_description"):
            continue
        group, _, text = b["description"].partition(": ")
        if not text:
            group, text = "Other", group
        keys = [name for bit, name in MODS if b["modmask"] & bit]
        key = b["key"] or KEYCODES.get(b.get("keycode"), "")   # bound by keycode: no key name
        keys.append(KEY_NAMES.get(key, key.upper() if len(key) == 1 else key))
        groups.setdefault(group, []).append((keys, text))
    return groups


def build():
    import gi

    gi.require_version("Gtk", "4.0")
    gi.require_version("Gdk", "4.0")
    from gi.repository import Gdk, Gtk, Pango

    def keycaps(keys):
        box = Gtk.Box(spacing=4, valign=Gtk.Align.CENTER)
        for i, key in enumerate(keys):
            if i:
                box.append(Gtk.Label(label="+", css_classes=["plus"]))
            classes = ["key", "mod"] if key in ("SUPER", "CTRL", "ALT", "SHIFT") else ["key"]
            box.append(Gtk.Label(label=key, css_classes=classes))
        return box

    class Overview(Gtk.Window):
        def __init__(self):
            super().__init__(title="Shortcuts")
            self.add_css_class("popup")
            self.add_css_class("overlay")
            self.set_decorated(False)

            # Same frame as the rofi overlays (rofi/overlay.rasi): centered search
            # pill on top, content, key hints at the bottom. Size: Hyprland rule.
            root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=22, css_classes=["overview"])

            # lens + entry + invisible lens, so the text is truly centered
            pill = Gtk.Box(spacing=10, halign=Gtk.Align.CENTER, css_classes=["search-pill"])
            pill.append(Gtk.Label(label="\U000F0349", css_classes=["lens"]))
            self.search = Gtk.Entry(placeholder_text="Filter shortcuts...", hexpand=True,
                                    xalign=0.5, css_classes=["search"])
            self.search.connect("changed", self.on_filter)
            pill.append(self.search)
            pill.append(Gtk.Label(label="\U000F0349", css_classes=["lens", "mirror"]))
            root.append(pill)

            # Cards in three equal columns that share the fixed overlay width
            # (long texts get "..."). Each card goes below the shortest column
            # (masonry): a grid with rows as high as the longest card pushed
            # half of the groups out of sight.
            self.flow = Gtk.Box(spacing=14, homogeneous=True, valign=Gtk.Align.START)
            self.columns = [Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14,
                                    valign=Gtk.Align.START) for _ in range(3)]
            for column in self.columns:
                self.flow.append(column)

            scroll = Gtk.ScrolledWindow(child=self.flow, vexpand=True,
                                        hscrollbar_policy=Gtk.PolicyType.NEVER)
            root.append(scroll)
            root.append(Gtk.Label(label="SUPER = Windows key      ·      Esc  close",
                                  css_classes=["hint"]))
            self.set_child(root)

            keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
            keys.connect("key-pressed", self.on_key)
            self.add_controller(keys)
            self.fill()       # built while hidden: the first press is fast too

        def fill(self):
            """(Re)build the cards when the binds changed since the last show."""
            raw = resident.hypr("j/binds")
            if raw == getattr(self, "raw", None):
                return
            self.raw = raw
            for column in self.columns:
                while child := column.get_first_child():
                    column.remove(child)
            self.rows = []    # (row widget, card, search text)
            self.cards = []
            filled = [0] * len(self.columns)    # rows per column, card title included
            for group, binds in load_binds(raw).items():
                card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, css_classes=["card"])
                card.append(Gtk.Label(label=group.upper(), css_classes=["card-title"], xalign=0))
                child = card
                for keys, text in binds:
                    row = Gtk.Box(spacing=14, css_classes=["row"])
                    row.append(Gtk.Label(label=text, css_classes=["desc"], xalign=0, hexpand=True,
                                         ellipsize=Pango.EllipsizeMode.END, tooltip_text=text))
                    row.append(keycaps(keys))
                    card.append(row)
                    self.rows.append((row, child, f"{group} {text} {' '.join(keys)}".lower()))
                shortest = filled.index(min(filled))
                self.columns[shortest].append(card)
                filled[shortest] += len(binds) + 2
                self.cards.append(card)

        def show_up(self):
            self.fill()
            self.search.set_text("")
            self.present()
            self.search.grab_focus()

        def on_filter(self, entry):
            query = entry.get_text().lower().split()
            visible = set()
            for row, child, text in self.rows:
                show = all(word in text for word in query)
                row.set_visible(show)
                if show:
                    visible.add(child)
            for child in self.cards:
                child.set_visible(child in visible)

        def on_key(self, _ctrl, keyval, _code, _state):
            if keyval == Gdk.KEY_Escape:
                self.close()
                return True
            return False

    provider = Gtk.CssProvider()
    provider.load_from_path(CSS)
    Gtk.StyleContext.add_provider_for_display(
        Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_USER)
    return Overview()


if __name__ == "__main__":
    resident.main(APP, build, __doc__)
