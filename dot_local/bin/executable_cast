#!/usr/bin/env bash
# cast: screen share (Miracast to a TV) through Network Displays.
#   cast status  -> state for the control center: off | open | live
#   cast watch   -> JSON lines for the waybar module: the "casting" icon in
#                   orange while a TV is attached, nothing otherwise (the
#                   control center, ~/.local/bin/control-center, starts it).
#                   While live it also lifts power-saver to balanced, see boost

#   cast open    -> jump to Network Displays (workspace 6, hypr/rules.lua),
#                   start it first if needed; there you pick the TV
# A stream runs over a Wi-Fi Direct group, which shows up as its own network
# interface (p2p-wlan0-0); that is how "live" is detected.
# Network Displays asks the screen share portal for the picture as soon as it
# starts. Started from here, the picker is skipped: ~/.local/bin/share-picker
# answers with the screen under the mouse when it finds the autopick file.
set -uo pipefail
app=gnome-network-displays
class=org.gnome.NetworkDisplays
autopick="${XDG_RUNTIME_DIR:-/tmp}/cast-autopick"
# tooltip from the language file (.chezmoidata/locale.toml); line breaks stay
# escaped, the text goes into JSON as is
tip=$(jq -r '."cast.live" | gsub("\n"; "\\n")' ~/.config/popups/strings.json 2>/dev/null)
[[ -n $tip && $tip != null ]] || tip="Streaming to the TV"
icon_live=$'\U000F0119'

state() {
    local live=(/sys/class/net/p2p-*)
    if [[ -e ${live[0]} ]]; then echo live
    elif pgrep -f "(^|/)$app( |$)" >/dev/null; then echo open
    else echo off
    fi
}

json() {
    if [[ $1 == live ]]; then
        printf '{"text": "%s", "tooltip": "%s", "class": "live"}\n' "$icon_live" "$tip"
    else
        echo '{"text": ""}'
    fi
}

# Network Displays scales the 2880x1800 screen down to 1080p on the CPU, which
# lags on power-saver (battery). While a TV is attached: power-saver ->
# balanced. Afterwards the normal rule (/usr/local/bin/power-profile-auto:
# charger -> performance, battery -> power-saver) picks the profile again, but
# only if it is still ours (balanced), so GameMode or a manual pick stays.
boost="${XDG_RUNTIME_DIR:-/tmp}/cast-boost"
boost() {
    if [[ $1 == on ]]; then
        [[ $(powerprofilesctl get 2>/dev/null) == power-saver ]] || return 0
        powerprofilesctl set balanced && touch "$boost"
    elif [[ -e $boost ]]; then
        rm -f "$boost"
        [[ $(powerprofilesctl get 2>/dev/null) == balanced ]] && /usr/local/bin/power-profile-auto
    fi
}

case ${1-status} in
status) state ;;
watch)
    last=""
    while :; do   # cheap: one pgrep every 2 s, a line only on change
        now=$(state)
        if [[ $now != "$last" ]]; then
            json "$now"
            if [[ $now == live ]]; then boost on; else boost off; fi
            last=$now
        fi
        sleep 2
    done
    ;;
open)
    [[ $(state) == off ]] && touch "$autopick"
    exec ~/.local/bin/focus-or-run "$class" "$app"
    ;;
*) echo "usage: cast [status|watch|open]" >&2; exit 2 ;;
esac
