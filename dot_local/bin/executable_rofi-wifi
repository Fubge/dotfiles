#!/usr/bin/env bash
# Wi-Fi menu: pick a network to connect, or toggle Wi-Fi on/off.
set -uo pipefail

# rofi_menu PROMPT -> prints the index of the chosen line
rofi_menu() {
    rofi -dmenu -i -no-custom -format i -p "$1" -theme-str 'window { width: 420px; } listview { lines: 10; }'
}

if [[ $(nmcli -t -f WIFI general) == "disabled" ]]; then
    idx=$(printf '%s\n' "󰖩  Turn Wi-Fi on" | rofi_menu "Wi-Fi") || exit 0
    nmcli radio wifi on && notify-send "Wi-Fi" "Turned on"
    exit 0
fi

notify-send -t 1500 "Wi-Fi" "Scanning..."
ssids=() secured=() labels=()
# IN-USE:SIGNAL:SECURITY:SSID, strongest first, each SSID once
while IFS=: read -r inuse signal security ssid; do
    [[ -z $ssid ]] && continue
    [[ " ${ssids[*]-} " == *" $ssid "* ]] && continue
    if   ((signal >= 75)); then icon="󰤨"
    elif ((signal >= 50)); then icon="󰤥"
    elif ((signal >= 25)); then icon="󰤢"
    else                        icon="󰤟"; fi
    lock="   "; [[ -n $security && $security != "--" ]] && lock="󰌾  "
    mark="";    [[ $inuse == "*" ]] && mark="  (connected)"
    ssids+=("$ssid"); secured+=("${lock// /}")
    labels+=("$icon  $lock$ssid$mark")
done < <(nmcli -t -f IN-USE,SIGNAL,SECURITY,SSID device wifi list --rescan yes)

labels+=("󰖪  Turn Wi-Fi off")
idx=$(printf '%s\n' "${labels[@]}" | rofi_menu "Wi-Fi") || exit 0
[[ -z $idx ]] && exit 0

if ((idx == ${#ssids[@]})); then
    nmcli radio wifi off && notify-send "Wi-Fi" "Turned off"
    exit 0
fi

ssid=${ssids[idx]}
if nmcli -t -f NAME connection show | grep -Fxq "$ssid"; then
    nmcli connection up id "$ssid" && notify-send "Wi-Fi" "Connected to $ssid"
elif [[ -n ${secured[idx]} ]]; then
    pass=$(rofi -dmenu -password -p "Password" -theme-str 'window { width: 420px; } listview { lines: 0; }') || exit 0
    nmcli device wifi connect "$ssid" password "$pass" \
        && notify-send "Wi-Fi" "Connected to $ssid" \
        || notify-send -u critical "Wi-Fi" "Could not connect to $ssid"
else
    nmcli device wifi connect "$ssid" && notify-send "Wi-Fi" "Connected to $ssid"
fi
