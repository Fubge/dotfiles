#!/usr/bin/env bash
# Audio menu (SUPER+A, or bar click with --bar): pick the output device
# (speakers, headphones, HDMI, Bluetooth), mute/unmute, or open the full mixer.
# Volume itself: scroll on the bar icon or use the volume keys.
set -uo pipefail
menu() { "$HOME/.local/bin/rofi-menu" "$@"; }

bar=(); [[ ${1-} == --bar ]] && bar=(--bar)

i_out=$'\U000F04C3' i_mute=$'\U000F075F' i_unmute=$'\U000F057E' i_mic=$'\U000F036D' i_mixer=$'\U000F0E52'

# Outputs with short names ("Speaker", "HDMI / DisplayPort 1 Output"); outputs with
# nothing plugged in are hidden
default=$(pactl get-default-sink)
names=() labels=() active=""
while IFS=$'\t' read -r name desc; do
    [[ $name == "$default" ]] && active=${#names[@]}
    names+=("$name"); labels+=("$i_out  $desc")
done < <(pactl -f json list sinks | jq -r --arg d "$default" '.[]
    | select(.name == $d or ([.ports[]?.availability] | all(. != "not available")))
    | "\(.name)\t\(.properties["device.profile.description"] // .description)"')

n=${#names[@]}
if [[ $(wpctl get-volume @DEFAULT_AUDIO_SINK@) == *MUTED* ]]; then
    labels+=("$i_unmute  Unmute")
else
    labels+=("$i_mute  Mute")
fi
if [[ $(wpctl get-volume @DEFAULT_AUDIO_SOURCE@) == *MUTED* ]]; then
    labels+=("$i_mic  Unmute microphone")
else
    labels+=("$i_mic  Mute microphone")
fi
labels+=("$i_mixer  Open mixer")

idx=$(printf '%s\n' "${labels[@]}" | menu "${bar[@]}" --compact "Audio" "" ${active:+-a "$active"}) || exit 0
[[ -z $idx ]] && exit 0

case $((idx - n)) in
    0) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    1) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
    2) exec "$HOME/.local/bin/popup" org.pulseaudio.pavucontrol pavucontrol ;;
    *) pactl set-default-sink "${names[idx]}" \
        && notify-send -t 2000 -i audio-speakers "Audio" "Output: ${labels[idx]#*  }" ;;
esac
