#!/usr/bin/env bash
# Prompt sign in front of the bar clock (waybar custom/prompt).
# Prints one JSON line per minute; the class (morning / day / evening /
# night) colors the sign in style.css, like the brightness day cycle.
while :; do
    h=$((10#$(date +%H)))
    if   (( h >= 5  && h < 11 )); then class=morning
    elif (( h >= 11 && h < 17 )); then class=day
    elif (( h >= 17 && h < 22 )); then class=evening
    else class=night
    fi
    printf '{"text": "❯", "class": "%s", "tooltip": false}\n' "$class"
    sleep $((60 - 10#$(date +%S)))
done
