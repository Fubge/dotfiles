#!/usr/bin/env bash
# Clipboard history (cliphist). Enter = copy, Alt+Delete = remove entry
# (one rule per line in -theme-str: rofi misreads two strings on one line)
cliphist list | rofi -dmenu -i -p "Clipboard" -display-columns 2 -theme overlay -theme-str '
    entry        { placeholder: "Filter clipboard..."; }
    textbox-hint { str: "Enter  copy      ·      Alt+Delete  remove      ·      Esc  close"; }
' | cliphist decode | wl-copy
