#!/usr/bin/env bash
# Opens YouTube as a Vivaldi app window at login (rules.lua puts it on
# workspace 4). Vivaldi restores its last session, which may already contain
# the YouTube window: wait until the browser is up and only open one if missing.
set -u
APP_CLASS=vivaldi-www.youtube.com__
has() { hyprctl clients -j | grep -q "\"class\": \"$1"; }

for _ in $(seq 60); do has vivaldi-stable && break; sleep 1; done
sleep 5   # restored windows appear a moment after the first one
has "$APP_CLASS" || exec uwsm-app -- vivaldi --app=https://www.youtube.com
