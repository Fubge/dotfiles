#!/usr/bin/env python3
"""Claude Code as a scratchpad: one long-running session in a floating kitty on
its own special workspace (special:claude), like Spotify on special:music.

  claude-pad toggle    SUPER+C / bar click: show or hide it (starts it if needed)
  claude-pad hide      out of sight, the session keeps running (SUPER+X)
  claude-pad start     start it hidden (login autostart)
  claude-pad ask       SUPER+SHIFT+C: small prompt pill, the text goes into the
                       running session and the pad opens with the answer
  claude-pad menu      bar right click: new chat, resume, restart, quit
  claude-pad watch     waybar module custom/claude: the bar pet
  claude-pad pet NAME  pick the pet (mochi, kitty)
  claude-pad hook EV   called by Claude Code hooks (~/.claude/settings.json),
                       only inside the pad (CLAUDE_PAD=1), event JSON on stdin

States (file $XDG_RUNTIME_DIR/claude-pad/state, the bar follows via a FIFO)
and what the pet does (frames from ~/.local/lib/pet/pet.py):
  off       no session          sleeps
  starting  window up, Claude not ready yet   wakes up
  idle      waiting for a prompt  potters about (blinks, looks, hops, waves...),
                                  dozes at night
  busy      working              mines, types on a laptop, thinks
  waiting   needs you (permission, question)  jumps with a "!"
  done      finished while the pad was hidden  cheers, then shows off a gem
The last answer (first paragraph) is kept in $RUN/last: the notification and the
quick prompt show it, so a reply can go straight back from the prompt pill.
"""
import html
import json
import os
import random
import select
import subprocess
import sys
import time

CLASS = "claude_pad"
WS = "claude"
RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "claude-pad")
SOCK = os.path.join(RUN, "kitty.sock")
STATE = os.path.join(RUN, "state")
LAST = os.path.join(RUN, "last")
FIFO = os.path.join(RUN, "events")
HOME = os.path.expanduser("~")
BIN = os.path.join(HOME, ".local/bin")
# Claude Code never remembers the trust prompt for the home folder itself, so the
# pad starts in the dotfiles repo (trusted once, for good). Its memory folder is
# a symlink to the home one (~/.claude/projects/-home-USER/memory), so both share it
WORKDIR = os.path.join(HOME, ".local/share/chezmoi")

PET_DIR = os.path.join(HOME, ".config/waybar/pet")      # built by pet.py
PET_FILE = os.path.join(HOME, ".local/state/claude-pad/pet")
PETS = {"mochi": "Mochi", "kitty": "Kitty"}
NIGHT = (22, 6)      # idle turns into dozing between these hours

# What the pet does per state: (animation, weight). Animations exist per pet in
# anims.json; names a pet does not have are skipped.
ACTIVITIES = {
    "idle": [("rest", 5), ("breathe", 3), ("blink", 4), ("look", 2), ("wave", 1),
             ("hop", 1), ("wiggle", 1), ("yawn", 0.5), ("happy", 1),
             ("twinkle", 1.5), ("swish", 1.5), ("twitch", 1)],
    "night": [("doze", 3), ("sleep", 2), ("breathe", 2), ("rest", 2), ("yawn", 1)],
    "off": [("sleep", 1)],
    "busy": [("mine", 4), ("type", 3), ("think", 2)],
    "waiting": [("alert", 3), ("rest", 1)],
    "done": [("gem", 3), ("happy", 1)],
}
# played once when a state begins
INTROS = {"starting": "wake", "done": "cheer", "waiting": "alert"}
TIPS = {"off": "Claude is not running", "starting": "Claude starts…",
        "idle": "Claude is ready", "busy": "Claude is working…",
        "waiting": "Claude needs you", "done": "Claude is done"}
NBSP = "\u00a0"


# --------------------------------------------------------------- helpers
def hypr(cmd):
    subprocess.run(["hyprctl", "dispatch", cmd], stdout=subprocess.DEVNULL)


def lua_table(**kw):
    """{k='v', b=false} for hyprctl dispatch (Lua dispatchers)."""
    def val(x):
        return str(x).lower() if isinstance(x, bool) else "'" + x + "'"
    return "{" + ", ".join(k + "=" + val(x) for k, x in kw.items()) + "}"


def hypr_json(what):
    out = subprocess.run(["hyprctl", what, "-j"], capture_output=True, text=True).stdout
    try:
        return json.loads(out or "[]")
    except ValueError:
        return []


def window_alive():
    """True if the pad window exists; also True when hyprctl gives no answer."""
    out = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True).stdout
    try:
        clients = json.loads(out)
    except ValueError:
        return True
    return any(c.get("class") == CLASS for c in clients)


def window():
    return next((c for c in hypr_json("clients") if c["class"] == CLASS), None)


def shown():
    return any(m.get("specialWorkspace", {}).get("name") == "special:" + WS
               for m in hypr_json("monitors"))


def read_state():
    try:
        with open(STATE) as f:
            return f.read().strip() or "off"
    except OSError:
        return "off"


def set_state(state):
    os.makedirs(RUN, exist_ok=True)
    with open(STATE, "w") as f:
        f.write(state)
    # wake the bar module; nobody listening (waybar down) is fine
    try:
        fd = os.open(FIFO, os.O_WRONLY | os.O_NONBLOCK)
        os.write(fd, b"\n")
        os.close(fd)
    except OSError:
        pass


def kitty(*args, text=None):
    return subprocess.run(["kitty", "@", "--to", "unix:" + SOCK, *args], input=text,
                          capture_output=True, text=True).returncode == 0


# --------------------------------------------------------------- window
def start():
    """Start the session (hidden: the window rule opens it silently)."""
    if window():
        return
    os.makedirs(RUN, exist_ok=True)
    try:
        os.unlink(SOCK)
    except OSError:
        pass
    set_state("starting")
    # started from inside another Claude session (e.g. while testing): drop its
    # markers, else the pad counts as a child session and saves no transcripts
    env = {k: v for k, v in os.environ.items()
           if not (k.startswith("CLAUDE") or k == "CLAUDECODE")}
    subprocess.Popen(
        ["uwsm", "app", "--", "kitty", "--class", CLASS, "--directory", WORKDIR,
         "-o", "allow_remote_control=socket-only", "--listen-on", "unix:" + SOCK,
         # Claude Code's own terminal notifications: the hooks send better ones
         "-o", 'filter_notification title:"Claude Code"',
         "env", "CLAUDE_PAD=1", "claude"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True, env=env)


def wait_for(check, timeout):
    end = time.monotonic() + timeout
    while time.monotonic() < end:
        result = check()
        if result:
            return result
        time.sleep(0.1)
    return None


def show():
    win = window() or (start() or wait_for(window, 8))
    if not win:
        return
    if win["workspace"]["name"] != "special:" + WS:   # moved away by hand
        hypr("hl.dsp.window.move(" + lua_table(window="address:" + win["address"],
                                               workspace="special:" + WS, follow=False) + ")")
    if not shown():
        hypr(f"hl.dsp.workspace.toggle_special('{WS}')")
    hypr("hl.dsp.focus(" + lua_table(window="address:" + win["address"]) + ")")
    if read_state() == "done":   # seen now
        set_state("idle")


def hide():
    if shown():
        hypr(f"hl.dsp.workspace.toggle_special('{WS}')")


def poke():
    """The pet was clicked: it hops (claude-pad watch reads this from the FIFO)."""
    try:
        fd = os.open(FIFO, os.O_WRONLY | os.O_NONBLOCK)
        os.write(fd, b"poke\n")
        os.close(fd)
    except OSError:
        pass


def toggle():
    poke()
    if window() and shown():
        hide()
    else:
        show()


def send(text):
    """Type text into the session and submit it (Enter goes separately, so it
    is not taken as part of a paste)."""
    before = read_state()
    kitty("send-text", "--match", "all", "--stdin", text=text)
    # Enter again until the prompt hook reports work: right after the start the
    # input box can swallow the first one. Commands like /clear fire no hook.
    for _ in range(4 if before == "idle" and not text.startswith("/") else 1):
        time.sleep(0.4)
        kitty("send-text", "--match", "all", "\\r")
        if wait_for(lambda: read_state() != before, 1.5):
            break


def ask():
    """Prompt pill. After an answer or a question from Claude it shows that text
    above the field, so this is also the reply box. Enter = send and open the
    pad, Ctrl+Enter = send and stay hidden (the answer comes as a notification)."""
    state = read_state()
    theme = ASK_THEME
    args = []
    try:
        with open(LAST) as f:
            last = f.read().strip()
    except OSError:
        last = ""
    if last and state in ("done", "waiting", "idle"):
        args = ["-mesg", html.escape(last)]
        theme += "mainbox { children: [ message, inputbar, textbox-hint ]; }\n"
    pick = subprocess.run(["rofi", "-dmenu", "-p", "Claude", "-theme", "overlay",
                           "-kb-accept-custom", "", "-kb-custom-1", "Control+Return",
                           "-theme-str", theme, *args], capture_output=True, text=True)
    query = pick.stdout.strip()
    if not query or pick.returncode not in (0, 10):
        return
    if not window():
        start()
    # the SessionStart hook flips "starting" to "idle" once Claude takes input
    wait_for(lambda: read_state() not in ("off", "starting"), 20)
    if state == "done":   # the answer was read in the pill
        set_state("idle")
    send(query)
    if pick.returncode == 0:
        show()


ASK_THEME = """
window       { location: north; anchor: north; y-offset: {{ sub .design.launcher_top 30 }}px; width: {{ .design.websearch_width }}px; height: 0; padding: 20px 20px 12px 20px; }
mainbox      { children: [ inputbar, textbox-hint ]; spacing: 12px; }
box-search   { width: {{ sub .design.websearch_width 40 }}px; }
entry        { placeholder: "Ask Claude..."; }
textbox-lens { str: "\uEC10"; }
textbox-hint { str: "Enter  ask + open    ·    Ctrl+Enter  ask in background    ·    Esc  close"; }
message      { padding: 0 6px; }
textbox      { horizontal-align: 0.5; text-color: {{ .palette.fg_muted }}; }
"""


def quit_pad():
    win = window()
    if win:
        hypr("hl.dsp.window.close(" + lua_table(window="address:" + win["address"]) + ")")
    set_state("off")


def restart():
    quit_pad()
    wait_for(lambda: not window(), 5)
    show()


def menu():
    running = window() is not None
    rows = [("\U000F05AF  Show / hide", toggle),
            ("\U000F0415  New chat (/clear)", lambda: (show(), send("/clear"))),
            ("\U000F0450  Resume a chat", lambda: (show(), send("/resume")))]
    if running:
        rows += [("\U000F0709  Restart Claude", restart),
                 ("\U000F0156  Quit Claude", quit_pad)]
    current = read_pet()
    rows += [("\U000F03E9  Pet: " + label, (lambda n=name: set_pet(n)))
             for name, label in PETS.items() if name != current]
    pick = subprocess.run([os.path.join(BIN, "rofi-menu"), "--bar", "Claude", ""],
                          input="\n".join(r[0] for r in rows), capture_output=True, text=True)
    if pick.stdout.strip().isdigit():
        rows[int(pick.stdout.strip())][1]()


# --------------------------------------------------------------- hooks
def last_answer(event):
    """First paragraph of Claude's last answer (Stop hook input or the transcript)."""
    text = event.get("last_assistant_message") or ""
    if not text and event.get("transcript_path"):
        try:
            with open(event["transcript_path"]) as f:
                lines = f.readlines()[-200:]
        except OSError:
            lines = []
        for line in reversed(lines):
            try:
                msg = json.loads(line).get("message", {})
            except ValueError:
                continue
            if msg.get("role") != "assistant" or not isinstance(msg.get("content"), list):
                continue
            parts = [c.get("text", "") for c in msg["content"] if c.get("type") == "text"]
            if any(parts):
                text = "\n".join(parts)
                break
    para = []
    for line in text.splitlines():
        line = line.strip().lstrip("#*> ").strip()
        if line:
            para.append(line)
        elif para:
            break
    para = " ".join(para).replace("**", "").replace("`", "")
    return (para[:297] + "…" if len(para) > 300 else para) or "Finished."


def notify(title, body):
    """Notification whose click opens the pad (waits in its own process)."""
    subprocess.Popen(
        ["sh", "-c", 'a=$(notify-send -a Claude -i "$3" -A open=Open "$1" "$2"); '
                     '[ "$a" = open ] && exec "$4" show',
         "sh", title, body, "utilities-terminal", os.path.join(BIN, "claude-pad")],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def hook(name):
    try:
        event = json.load(sys.stdin)
    except ValueError:
        event = {}
    state = read_state()
    if name == "start":
        set_state("idle")
    elif name == "prompt":
        set_state("busy")
    elif name == "tool" and state != "busy":
        # permission given and it works on; also heals a state that went wrong
        # (e.g. "off" from a missed window check), so the pet never naps mid-work
        set_state("busy")
    elif name == "ask":                           # AskUserQuestion / permission
        set_state("waiting")
        msg = event.get("message") or "Waiting for your answer."
        if name == "ask" and event.get("tool_input", {}).get("questions"):
            msg = event["tool_input"]["questions"][0].get("question", msg)
        with open(LAST, "w") as f:
            f.write(msg)
        if not shown():
            notify("Claude needs you", msg)
    elif name == "stop":
        answer = last_answer(event)
        with open(LAST, "w") as f:
            f.write(answer)
        if shown():
            set_state("idle")
        else:
            set_state("done")
            notify("Claude is done", answer)
    elif name == "end":
        set_state("off")


# --------------------------------------------------------------- bar pet
def read_pet():
    try:
        with open(PET_FILE) as f:
            name = f.read().strip()
    except OSError:
        name = ""
    return name if name in PETS else "mochi"


def set_pet(name):
    if name not in PETS:
        sys.exit("pets: " + ", ".join(PETS))
    os.makedirs(os.path.dirname(PET_FILE), exist_ok=True)
    with open(PET_FILE, "w") as f:
        f.write(name)
    set_state(read_state())   # wakes the bar


def load_anims():
    try:
        with open(os.path.join(PET_DIR, "anims.json")) as f:
            return json.load(f)["anims"]
    except (OSError, ValueError, KeyError):
        return {}


def night():
    hour = time.localtime().tm_hour
    return hour >= NIGHT[0] or hour < NIGHT[1]


class Pet:
    """Plays animations (lists of [frame class, ms]) one after another; picks
    the next one by weight from the activities of the current state."""

    def __init__(self):
        self.anims = load_anims()
        self.kind = read_pet()
        self.state = None
        self.queue = []          # [[frame, ms], ...] left of the current animation
        self.frame = None
        self.width = None        # class w<cols>: how wide this animation is
        self.until = 0.0
        self.last_pick = None

    def mood(self):
        if self.state == "idle" and night():
            return "night"
        return self.state if self.state in ACTIVITIES else "idle"

    def pick(self):
        have = self.anims.get(self.kind, {})
        options = [(n, w) for n, w in ACTIVITIES[self.mood()] if n in have]
        # avoid the same fidget twice in a row (looks mechanical)
        if len(options) > 1:
            options = [(n, w) for n, w in options if n != self.last_pick] or options
        if not options:
            return []
        name = random.choices([n for n, _ in options], [w for _, w in options])[0]
        self.last_pick = name
        steps = [list(x) for x in have[name]]
        if name == "rest":      # rest a random while, so the rhythm never repeats
            steps[0][1] = random.randint(1200, 3500)
        return steps

    def poke(self):
        have = self.anims.get(self.kind, {})
        if "poke" in have and self.state != "off":
            self.queue = [list(x) for x in have["poke"]]
            self.until = 0

    def update(self, state, kind):
        """Switch state or pet; returns True if the shown frame changed."""
        if kind != self.kind or state != self.state:
            self.kind, self.state = kind, state
            intro = INTROS.get(state)
            have = self.anims.get(kind, {})
            self.queue = [list(x) for x in have[intro]] if intro in have else []
            self.until = 0
        now = time.monotonic()
        if now < self.until:
            return False
        if not self.queue:
            self.queue = self.pick()
        if not self.queue:
            self.frame, self.until = None, now + 3600
            return True
        frame, ms, *width = self.queue.pop(0)
        self.width = width[0] if width else None
        self.until = now + ms / 1000
        changed = frame != self.frame
        self.frame = frame
        return changed


def watch():
    os.makedirs(RUN, exist_ok=True)
    if not os.path.exists(FIFO):
        os.mkfifo(FIFO)
    fd = os.open(FIFO, os.O_RDWR | os.O_NONBLOCK)   # RDWR: never sees EOF
    pet = Pet()
    last, next_alive, missing = None, 0.0, 0
    while True:
        now = time.monotonic()
        if now >= next_alive:   # session gone without a SessionEnd hook (killed)
            next_alive = now + 3
            # three misses in a row: one failed hyprctl call must not put the
            # pet to sleep while Claude works
            missing = missing + 1 if read_state() != "off" and not window_alive() else 0
            if missing >= 3:
                set_state("off")
                missing = 0
        state = read_state()
        pet.update(state, read_pet())
        classes = ["pet", pet.kind, state] + ([pet.frame] if pet.frame else [])
        if pet.width:
            classes.append(pet.width)
        tip = TIPS.get(state, "") + "\n\n<small>Click show · Right click menu</small>"
        out = json.dumps({"text": NBSP, "class": classes, "tooltip": tip})
        if out != last:
            print(out, flush=True)
            last = out
        timeout = max(0.01, pet.until - time.monotonic())
        if select.select([fd], [], [], min(timeout, 3))[0]:
            try:
                if b"poke" in os.read(fd, 4096):
                    pet.poke()
            except OSError:
                pass


if __name__ == "__main__":
    cmds = {"toggle": toggle, "show": show, "hide": hide, "start": start,
            "ask": ask, "menu": menu, "watch": watch}
    args = sys.argv[1:]
    if len(args) == 2 and args[0] == "hook":
        hook(args[1])
    elif len(args) == 2 and args[0] == "pet":
        set_pet(args[1])
    elif len(args) == 1 and args[0] in cmds:
        cmds[args[0]]()
    else:
        sys.exit(__doc__)
