#!/usr/bin/env bash
# osd WHAT [HOW]: change volume / brightness and show the pill (~/.local/bin/osd-pill)
#   osd volume up|down|mute     default output (up also unmutes)
#   osd mic mute                default input
#   osd brightness up|down      screen, perceived steps like the slider (-e2)
# The key binds (hypr/binds.lua) call this. The change itself happens here, so
# the keys keep working when the pill daemon is not running; the daemon only
# gets told what to show (one word into its FIFO, ~1 ms).
set -uo pipefail
run=${XDG_RUNTIME_DIR:-/tmp}
sink=@DEFAULT_AUDIO_SINK@
source=@DEFAULT_AUDIO_SOURCE@

# Volume keys: a short tick at the new volume, so you hear how loud it is
# (at most every 140 ms: a held key would rattle). Sound: assets/make-sounds.py
tick() {
    local last=0 now=${EPOCHREALTIME/[.,]/}
    { read -r last <"$run/osd.tick"; } 2>/dev/null
    (( now - last < 140000 )) && return
    echo "$now" >"$run/osd.tick"
    pw-play --media-role event "$HOME/.local/share/sounds/slate/tick.oga" >/dev/null 2>&1 &
}

case "$1 ${2-}" in
"volume up")      wpctl set-mute $sink 0; wpctl set-volume -l 1 $sink 5%+; tick ;;
"volume down")    wpctl set-volume $sink 5%-; tick ;;
"volume mute")    wpctl set-mute $sink toggle ;;
"mic mute")       wpctl set-mute $source toggle ;;
"brightness up")  brightnessctl -q -e2 -n1 set 5%+ ;;
"brightness down") brightnessctl -q -e2 -n1 set 5%- ;;
*) sed -n '2,5s/^# \{0,1\}//p' "$0" >&2; exit 2 ;;
esac

pid=
{ read -r pid <"$run/osd.pid"; } 2>/dev/null
if [[ -p $run/osd.fifo && -n $pid ]] && kill -0 "$pid" 2>/dev/null; then
    echo "$1" >"$run/osd.fifo"
fi
