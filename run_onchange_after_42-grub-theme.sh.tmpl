{{ if .machine.boot -}}
#!/usr/bin/env bash
# (only with machine.boot = true, see .chezmoi.toml.tmpl)
# Build the GRUB theme "slate" from the palette (fonts, background, icons,
# rounded selection) into /boot/grub/themes/slate, then regenerate grub.cfg.
# Re-runs when the palette, design tokens or GRUB config change:
# palette: {{ .palette | toJson | sha256sum }}
# design: {{ .design | toJson | sha256sum }}
# grub defaults: {{ includeTemplate "system-boot/etc/default/grub.tmpl" . | sha256sum }}
# grub entries: {{ includeTemplate "system-boot/etc/grub.d/40_custom.tmpl" . | sha256sum }}
# wallpaper: {{ .machine.login_wallpaper }}
set -euo pipefail

theme=/boot/grub/themes/slate
{{- if .machine.login_wallpaper }}
wall="{{ .chezmoi.homeDir }}/Pictures/Wallpapers/{{ .machine.login_wallpaper }}"
{{- else }}
wall=$(readlink -f "{{ .chezmoi.homeDir }}/.local/state/wallpaper/current" || true)   # the desktop wallpaper
{{- end }}
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# Drawn for the native panel size (machine.grub_resolution); GRUB does no HiDPI
# scaling, so every size below is written for a 2880 px wide panel and scaled by px
res="{{ .machine.grub_resolution }}"
W=${res%x*} H=${res#*x}
px() { echo $(( $1 * W / 2880 )); }   # size at 2880 px -> size here
r=$(px $(( {{ .design.rounding }} * 2 )))   # selection corner radius

# ------------------------------------------------------------ fonts
# Latin + punctuation only, keeps the .pf2 files small on the 200 MB ESP
range="0x20-0x7E,0xA0-0x17F,0x2022-0x2022,0x2190-0x2193"
mkfont() { grub-mkfont -s "$2" -r "$range" -o "$work/$3.pf2" "$1" 2>/dev/null; }
mkfont /usr/share/fonts/noto/NotoSans-Medium.ttf  "$(px 52)" item
mkfont /usr/share/fonts/noto/NotoSans-Regular.ttf "$(px 34)" label
mkfont /usr/share/fonts/noto/NotoSans-Regular.ttf "$(px 26)" hint
mkfont /usr/share/fonts/TTF/JetBrainsMonoNerdFont-Regular.ttf "$(px 32)" term
# GRUB addresses fonts by the name stored inside the file ("Noto Sans Medium 52")
fname() { strings "$work/$1.pf2" | sed -n '/NAME$/{n;p;q}'; }

# ------------------------------------------------------------ background
if [[ -f $wall ]]; then
    magick "$wall" -resize "${W}x${H}^" -gravity center -extent "${W}x${H}" \
        -blur 0x10 -fill "{{ .palette.bg_dark }}" -colorize 45% \
        -quality 88 "$work/background.jpg"
else
    magick -size "${W}x${H}" "xc:{{ .palette.bg }}" "$work/background.jpg"
fi

# ------------------------------------------------------------ selection pill (9-slice)
s=$(( r * 3 ))
magick -size "${s}x${s}" xc:none \
    -fill "{{ .palette.steel }}73" -draw "roundrectangle 0,0 $((s-1)),$((s-1)) $r,$r" \
    "$work/pill.png"
i=0
for part in nw n ne w c e sw s se; do
    x=$(( (i % 3) * r )) y=$(( (i / 3) * r ))
    magick "$work/pill.png" -crop "${r}x${r}+${x}+${y}" +repage "PNG32:$work/select_$part.png"  # GRUB only reads RGBA
    i=$((i + 1))
done
rm "$work/pill.png"

# ------------------------------------------------------------ icons (monochrome, fg color)
mkdir -p "$work/icons"
sed 's/fill="#1793d1"/fill="{{ .palette.fg }}"/' /usr/share/pixmaps/archlinux-logo.svg > "$work/arch.svg"
cat > "$work/windows.svg" <<SVG
<svg viewBox="0 0 88 88" xmlns="http://www.w3.org/2000/svg" fill="{{ .palette.fg }}">
  <rect x="4"  y="4"  width="38" height="38" rx="3"/><rect x="46" y="4"  width="38" height="38" rx="3"/>
  <rect x="4"  y="46" width="38" height="38" rx="3"/><rect x="46" y="46" width="38" height="38" rx="3"/>
</svg>
SVG
rsvg-convert -w "$(px 96)" -h "$(px 96)" "$work/arch.svg"    -o "$work/icons/arch.png"
rsvg-convert -w "$(px 72)" -h "$(px 72)" "$work/windows.svg" -o "$work/icons/windows.png"
rm "$work"/*.svg

# ------------------------------------------------------------ theme.txt
menu_w=$(px 820) item_h=$(px 150) gap=$(px 28)
items={{ if .machine.windows }}2{{ else }}1{{ end }}
menu_h=$(( items * item_h + (items - 1) * gap ))
cat > "$work/theme.txt" <<THEME
# GRUB theme "slate", generated by run_onchange_after_42-grub-theme.sh.tmpl
title-text: ""
desktop-image: "background.jpg"
desktop-color: "{{ .palette.bg_dark }}"
terminal-font: "$(fname term)"
terminal-box: "select_*.png"
terminal-left: "10%"
terminal-top: "10%"
terminal-width: "80%"
terminal-height: "80%"

+ label {
    top = 30%
    left = 0
    width = 100%
    align = "center"
    text = "Choose a system"
    font = "$(fname label)"
    color = "{{ .palette.fg_muted }}"
}

+ boot_menu {
    left = 50%-$(( menu_w / 2 ))
    top = 37%
    width = $menu_w
    height = $menu_h
    item_font = "$(fname item)"
    item_color = "{{ .palette.fg }}"
    selected_item_font = "$(fname item)"
    selected_item_color = "{{ .palette.accent }}"
    selected_item_pixmap_style = "select_*.png"
    item_height = $item_h
    item_spacing = $gap
    item_padding = $(px 56)
    icon_width = $(px 96)
    icon_height = $(px 96)
    item_icon_space = $(px 56)
    scrollbar = false
}

+ label {
    id = "__timeout__"
    top = 37%+$(( menu_h + $(px 90) ))
    left = 0
    width = 100%
    align = "center"
    text = "Starting in %d s"
    font = "$(fname label)"
    color = "{{ .palette.comment }}"
}

+ progress_bar {
    id = "__timeout__"
    top = 37%+$(( menu_h + $(px 160) ))
    left = 50%-$(px 240)
    width = $(px 480)
    height = $(px 6)
    show_text = false
    fg_color = "{{ .palette.accent }}"
    bg_color = "{{ .palette.bg_alt }}"
    border_color = "{{ .palette.bg_alt }}"
}

+ label {
    top = 100%-$(px 140)
    left = 0
    width = 100%
    align = "center"
    text = "↑ ↓  select      •      Enter  boot      •      E  edit      •      C  console"
    font = "$(fname hint)"
    color = "{{ .palette.comment }}"
}
THEME

# ------------------------------------------------------------ install + grub.cfg
sudo rm -rf "$theme"
sudo mkdir -p "$theme"
sudo cp -r "$work"/. "$theme"/
echo "grub: theme installed to $theme ($(sudo du -sh "$theme" | cut -f1))"

# Old generator for the UKI entry; 40_custom now provides "Arch Linux"
[[ -e /etc/grub.d/15_uki ]] && sudo rm /etc/grub.d/15_uki
# Firmware-settings entry: hidden (F1 at power-on opens the BIOS anyway)
[[ -x /etc/grub.d/30_uefi-firmware ]] && sudo chmod -x /etc/grub.d/30_uefi-firmware

sudo grub-mkconfig -o "$work/grub.cfg" 2>/dev/null
sudo grub-script-check "$work/grub.cfg"
sudo install -m 0600 "$work/grub.cfg" /boot/grub/grub.cfg
echo "grub: grub.cfg regenerated ($(sudo grep -c '^menuentry' /boot/grub/grub.cfg) entries)"
{{ end -}}
