#!/usr/bin/env bash
# Installs all packages listed in packages/*.txt (official repos only).
# chezmoi re-runs this script whenever one of the lists changes:
{{ range (list "base" "hardware" "desktop" "apps" "dev") -}}
# {{ . }}: {{ include (printf "packages/%s.txt" .) | sha256sum }}
{{ end -}}
set -euo pipefail

src="{{ .chezmoi.sourceDir }}/packages"
mapfile -t pkgs < <(sed 's/#.*//; s/[[:space:]]//g; /^$/d' "$src"/*.txt | sort -u)

missing=()
for p in "${pkgs[@]}"; do
    pacman -Qq "$p" &>/dev/null || missing+=("$p")
done

if ((${#missing[@]} == 0)); then
    echo "packages: all ${#pkgs[@]} packages installed"
    exit 0
fi

echo "packages: installing ${#missing[@]} missing package(s): ${missing[*]}"
sudo pacman -S --needed "${missing[@]}"
