#!/bin/sh
exec tail -n +3 $0
# Boot menu entries. --class picks the icon from the GRUB theme.
# Everything lives on the EFI partition (UUID {{ .machine.esp_uuid }}).

menuentry "Arch Linux" --class arch {
    insmod part_gpt
    insmod fat
    search --no-floppy --fs-uuid --set=root {{ .machine.esp_uuid }}
    chainloader /EFI/Linux/arch-linux.efi
}
{{- if .machine.windows }}

menuentry "Windows" --class windows {
    insmod part_gpt
    insmod fat
    search --no-floppy --fs-uuid --set=root {{ .machine.esp_uuid }}
    chainloader /EFI/Microsoft/Boot/bootmgfw.efi
}
{{- end }}
